#!/usr/bin/env bash
set -Eeuo pipefail

REPOSITORY="devillionner/devillionner-os"
DEFAULT_REF="main"
REF="${DEVOS_REF:-$DEFAULT_REF}"
REF_EXPLICIT=false
ACTION="install"

usage() {
    cat <<'EOF'
Usage:
  bootstrap [--ref REF] [install] [installer options...]
  bootstrap [--ref REF] check [--profile PROFILE]
  bootstrap [--ref REF] check-repo
  bootstrap [--ref REF] setup-cli
  bootstrap [--ref REF] version

Examples:
  curl -fsSL https://raw.githubusercontent.com/devillionner/devillionner-os/main/bootstrap | bash
  curl -fsSL https://raw.githubusercontent.com/devillionner/devillionner-os/main/bootstrap | bash -s -- --profile work --keyboard windows --vm
  curl -fsSL https://raw.githubusercontent.com/devillionner/devillionner-os/main/bootstrap | bash -s -- check

The source bundle is downloaded to a temporary directory and removed when the
command finishes. No persistent Git checkout is required.
EOF
}

while (($#)); do
    case "$1" in
        --ref)
            [[ $# -ge 2 ]] || { printf 'bootstrap: --ref needs a value\n' >&2; exit 2; }
            REF="$2"
            REF_EXPLICIT=true
            shift 2
            ;;
        install|check|check-repo|setup-cli|version)
            ACTION="$1"
            shift
            break
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            # No explicit action means install; leave all remaining arguments
            # untouched for scripts/install.
            break
            ;;
    esac
done

# A normal `devos-blueprint check` should validate the exact revision that was
# installed, not silently compare an older system against a newer main branch.
# An explicit --ref always wins. Systems predating revision state fall back to
# current main until they are installed/updated through the remote bootstrap.
if [[ "$ACTION" == "check" && "$REF_EXPLICIT" == false && -z "${DEVOS_REF:-}" ]]; then
    STATE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/devillionner-os/source-revision"
    if [[ -r "$STATE_FILE" ]]; then
        RECORDED_REF="$(tr -d '[:space:]' < "$STATE_FILE")"
        if [[ "$RECORDED_REF" =~ ^[0-9a-fA-F]{40}$ ]]; then
            REF="$RECORDED_REF"
        fi
    fi
fi

for cmd in curl tar mktemp sed find; do
    command -v "$cmd" >/dev/null 2>&1 || {
        printf 'bootstrap: required command missing: %s\n' "$cmd" >&2
        exit 1
    }
done

resolve_revision() {
    local requested="$1" response sha

    if [[ "$requested" =~ ^[0-9a-fA-F]{40}$ ]]; then
        printf '%s\n' "${requested,,}"
        return 0
    fi

    # Keep symbolic refs intentionally simple. main, release tags and ordinary
    # branch names work; a slash-containing branch can always be supplied as its
    # resolved 40-character commit SHA instead.
    [[ "$requested" =~ ^[A-Za-z0-9._-]+$ ]] || {
        printf 'bootstrap: unsupported ref syntax: %s\n' "$requested" >&2
        return 1
    }

    response="$(
        curl --fail --silent --show-error --location \
            --retry 3 --proto '=https' --tlsv1.2 \
            -H 'Accept: application/vnd.github+json' \
            "https://api.github.com/repos/$REPOSITORY/commits/$requested"
    )" || return 1

    sha="$(
        printf '%s\n' "$response" \
            | sed -nE 's/^[[:space:]]*"sha"[[:space:]]*:[[:space:]]*"([0-9a-fA-F]{40})".*/\1/p' \
            | head -n 1
    )"
    [[ "$sha" =~ ^[0-9a-fA-F]{40}$ ]] || {
        printf 'bootstrap: could not resolve ref to a commit: %s\n' "$requested" >&2
        return 1
    }
    printf '%s\n' "${sha,,}"
}

REVISION="$(resolve_revision "$REF")" || {
    printf 'bootstrap: failed to resolve Blueprint revision %s\n' "$REF" >&2
    exit 1
}

if [[ "$ACTION" == "version" ]]; then
    printf '%s\n' "$REVISION"
    exit 0
fi

TMP_ROOT="$(mktemp -d -t devillionner-os.XXXXXXXX)"
cleanup() {
    rm -rf -- "$TMP_ROOT"
}
trap cleanup EXIT INT TERM HUP

ARCHIVE="$TMP_ROOT/source.tar.gz"
printf '==> Blueprint source: %s (%s)\n' "$REVISION" "$REF"
printf '==> Downloading temporary source bundle\n'

curl --fail --silent --show-error --location \
    --retry 3 --proto '=https' --tlsv1.2 \
    "https://codeload.github.com/$REPOSITORY/tar.gz/$REVISION" \
    -o "$ARCHIVE"

tar -xzf "$ARCHIVE" -C "$TMP_ROOT"
SOURCE_ROOT="$(
    find "$TMP_ROOT" -mindepth 1 -maxdepth 1 -type d -name 'devillionner-os-*' -print -quit
)"
[[ -n "$SOURCE_ROOT" && -f "$SOURCE_ROOT/scripts/install" ]] || {
    printf 'bootstrap: downloaded source bundle is incomplete\n' >&2
    exit 1
}

export DEVOS_SOURCE_REVISION="$REVISION"
export DEVOS_SOURCE_MODE="ephemeral"

case "$ACTION" in
    install)
        bash "$SOURCE_ROOT/scripts/install" "$@"
        ;;
    check)
        bash "$SOURCE_ROOT/scripts/check" "$@"
        ;;
    check-repo)
        bash "$SOURCE_ROOT/scripts/check-repo" "$@"
        ;;
    setup-cli)
        bash "$SOURCE_ROOT/scripts/configure-blueprint-cli" "$@"
        ;;
    *)
        printf 'bootstrap: unsupported action: %s\n' "$ACTION" >&2
        exit 2
        ;;
esac
