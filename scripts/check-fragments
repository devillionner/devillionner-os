#!/usr/bin/env bash
set -u

REPO="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
FRAGMENTS_CONNECTION_UUID="cae1e57a-6d6b-4fae-9a51-7a9d9ce15a01"

# Remote/admin shells may lack the session-bus variables even while the user's
# graphical session is alive. Reconstruct the standard user-bus address so
# targeted Blueprint apply/check works from either a terminal or remote runner.
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [[ -z "${DBUS_SESSION_BUS_ADDRESS:-}" && -S "$XDG_RUNTIME_DIR/bus" ]]; then
    export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
fi

# Remote runners can also miss the Hyprland instance variables. Borrow only the
# compositor-address fields from the running Caelestia shell so special-workspace
# validation still works without importing the whole graphical environment.
if [[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    QS_PID="$(pgrep -n qs 2>/dev/null || true)"
    if [[ -n "$QS_PID" && -r "/proc/$QS_PID/environ" ]]; then
        while IFS= read -r -d '' kv; do
            case "$kv" in
                HYPRLAND_INSTANCE_SIGNATURE=*|WAYLAND_DISPLAY=*|DISPLAY=*) export "$kv" ;;
            esac
        done < "/proc/$QS_PID/environ"
    fi
fi

OK=0; WARN=0; FAIL=0
ok() { printf '  [OK]   %s\n' "$*"; OK=$((OK + 1)); }
warn() { printf '  [WARN] %s\n' "$*"; WARN=$((WARN + 1)); }
fail() { printf '  [FAIL] %s\n' "$*" >&2; FAIL=$((FAIL + 1)); }

printf '========================================\n'
printf '       Fragments integration check\n'
printf '========================================\n'

for pkg in fragments transmission-cli python-dbus; do
    pacman -Qq "$pkg" >/dev/null 2>&1 && ok "$pkg installed" || fail "$pkg missing"
done
for cmd in fragments transmission-daemon transmission-remote python3 gsettings; do
    command -v "$cmd" >/dev/null 2>&1 && ok "$cmd" || fail "$cmd missing"
done
python3 - <<'PY' >/dev/null 2>&1 && ok "python-dbus import" || fail "python-dbus import failed"
import dbus
PY

pairs=(
    "dotfiles/.local/bin/fragments-caelestia:$HOME/.local/bin/fragments-caelestia"
    "dotfiles/.local/bin/fragments-tray:$HOME/.local/bin/fragments-tray"
    "dotfiles/.local/bin/devos-fragments-gtk-sync:$HOME/.local/bin/devos-fragments-gtk-sync"
    "dotfiles/.config/gtk-4.0/fragments.css:$HOME/.config/gtk-4.0/fragments.css"
    "dotfiles/.config/systemd/user/devos-fragments-gtk.service:$HOME/.config/systemd/user/devos-fragments-gtk.service"
    "dotfiles/.config/systemd/user/devos-fragments-gtk.path:$HOME/.config/systemd/user/devos-fragments-gtk.path"
    "dotfiles/.config/systemd/user/devos-fragments-daemon.service:$HOME/.config/systemd/user/devos-fragments-daemon.service"
    "dotfiles/.config/systemd/user/devos-fragments-tray.service:$HOME/.config/systemd/user/devos-fragments-tray.service"
    "dotfiles/.local/share/applications/de.haeckerfelix.Fragments.desktop:$HOME/.local/share/applications/de.haeckerfelix.Fragments.desktop"
)
for pair in "${pairs[@]}"; do
    src="${pair%%:*}"; dst="${pair#*:}"
    if [[ -f "$dst" ]] && cmp -s "$REPO/$src" "$dst"; then
        ok "${dst#$HOME/} matches Blueprint"
    else
        fail "${dst#$HOME/} missing or differs"
    fi
done

DESKTOP="$HOME/.local/share/applications/de.haeckerfelix.Fragments.desktop"
if grep -Fqx 'Exec=fragments-caelestia %U' "$DESKTOP" 2>/dev/null     && grep -Fqx 'TryExec=fragments-caelestia' "$DESKTOP" 2>/dev/null     && grep -Fqx 'DBusActivatable=false' "$DESKTOP" 2>/dev/null; then
    ok "desktop entry routes through managed launcher"
else
    fail "Fragments desktop routing differs"
fi

MIME="$HOME/.config/mimeapps.list"
for mime in 'x-scheme-handler/magnet' 'application/x-bittorrent'; do
    grep -Fqx "$mime=de.haeckerfelix.Fragments.desktop" "$MIME" 2>/dev/null         && ok "$mime defaults to Fragments"         || fail "$mime default differs"
done

HYPR_USER="$HOME/.config/caelestia/hypr-user.lua"
if grep -Fq -- '-- BEGIN Fragments Caelestia integration' "$HYPR_USER" 2>/dev/null     && grep -Fq 'opacity = "0.85 override 0.85 override"' "$HYPR_USER" 2>/dev/null     && grep -Fq 'class = "^de\.haeckerfelix\.Fragments$"' "$HYPR_USER" 2>/dev/null; then
    ok "Caelestia/Hyprland Fragments opacity rule"
else
    fail "Fragments opacity rule differs"
fi
if grep -Fq -- '-- BEGIN Fragments background close behavior' "$HYPR_USER" 2>/dev/null     || grep -Fq 'special:fragments' "$HYPR_USER" 2>/dev/null; then
    fail "legacy special:fragments close override still present"
else
    ok "Fragments uses normal close behavior; no special-workspace override"
fi

CONNECTIONS="$HOME/.config/fragments/connections.conf"
if python3 - "$CONNECTIONS" "$FRAGMENTS_CONNECTION_UUID" <<'PY' >/dev/null 2>&1
from configparser import RawConfigParser
from pathlib import Path
import sys
cfg = RawConfigParser(interpolation=None, strict=False)
cfg.read(Path(sys.argv[1]), encoding="utf-8")
uuid = sys.argv[2]
assert cfg.has_section(uuid)
assert cfg.get(uuid, "title") == "This computer"
assert cfg.get(uuid, "address") == "http://127.0.0.1:9091/transmission/rpc"
PY
then
    ok "Fragments localhost remote connection configured"
else
    fail "Fragments localhost remote connection missing or differs"
fi

LAST_CONNECTION="$(gsettings get de.haeckerfelix.Fragments client-last-connection 2>/dev/null | tr -d "'")"
[[ "$LAST_CONNECTION" == "$FRAGMENTS_CONNECTION_UUID" ]]     && ok "Fragments restores the background daemon connection"     || fail "Fragments last connection differs: $LAST_CONNECTION"

if python3 - "$HOME/.config/fragments/settings.json" <<'PY' >/dev/null 2>&1
import json
from pathlib import Path
import sys
d = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
assert d.get("rpc-enabled") is True
assert d.get("rpc-bind-address") == "127.0.0.1"
assert d.get("rpc-port") == 9091
assert d.get("rpc-authentication-required") is False
assert d.get("rpc-whitelist-enabled") is True
assert d.get("rpc-whitelist") == "127.0.0.1,::1"
PY
then
    ok "Transmission RPC is restricted to localhost"
else
    fail "Transmission localhost RPC settings differ"
fi

GTK_CSS="$HOME/.config/gtk-4.0/gtk.css"
grep -Fqx '@import "fragments.css";' "$GTK_CSS" 2>/dev/null     && ok "Fragments CSS imported into current Caelestia GTK theme"     || fail "Fragments CSS import missing from current GTK theme"

for unit in devos-fragments-daemon.service devos-fragments-tray.service devos-fragments-gtk.path; do
    systemctl --user is-enabled "$unit" >/dev/null 2>&1         && ok "$unit enabled"         || fail "$unit not enabled"
    systemctl --user is-active "$unit" >/dev/null 2>&1         && ok "$unit active"         || fail "$unit not active"
done

DAEMON_PATTERN="transmission-daemon.*--config-dir $HOME/.config/fragments"
DAEMON_COUNT="$(pgrep -fc -- "$DAEMON_PATTERN" 2>/dev/null || true)"
if [[ "$DAEMON_COUNT" == "1" ]]; then
    ok "exactly one background Transmission daemon running"
else
    fail "$DAEMON_COUNT Fragments Transmission daemons running; expected one"
fi
if ps -eo args= | grep -F 'transmission-daemon -f' | grep -F -- '--config-dir' | grep -F "$HOME/.config/fragments" | grep -Fq -- '--rpc-bind-address 127.0.0.1'; then
    ok "background daemon command binds RPC to loopback"
else
    fail "background daemon is not bound to loopback"
fi
transmission-remote 127.0.0.1:9091 -l >/dev/null 2>&1     && ok "Transmission RPC reachable while Fragments UI may be closed"     || fail "Transmission RPC unreachable"

pgrep -f '^python3 .*/fragments-tray$' >/dev/null 2>&1     && ok "Fragments Caelestia tray helper running independently of UI"     || fail "Fragments tray helper missing"

if grep -Fq 'Torrents (' "$HOME/.local/bin/fragments-tray" 2>/dev/null     && grep -Fq 'transmission-remote' "$HOME/.local/bin/fragments-tray" 2>/dev/null     && grep -Fq 'Pause all' "$HOME/.local/bin/fragments-tray" 2>/dev/null     && grep -Fq 'Resume all' "$HOME/.local/bin/fragments-tray" 2>/dev/null     && grep -Fq 'Stop torrent service' "$HOME/.local/bin/fragments-tray" 2>/dev/null; then
    ok "Caelestia tray DBusMenu includes live torrents and background controls"
else
    fail "Fragments tray menu contract differs"
fi

if [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]] && command -v busctl >/dev/null 2>&1; then
    if busctl --user get-property org.kde.StatusNotifierWatcher /StatusNotifierWatcher         org.kde.StatusNotifierWatcher RegisteredStatusNotifierItems 2>/dev/null         | grep -Fq 'org.kde.StatusNotifierItem.Fragments/StatusNotifierItem'; then
        ok "Fragments registered in Caelestia system tray"
    else
        fail "Fragments tray item is not registered"
    fi
else
    warn "D-Bus session unavailable; tray registration not checked"
fi

if command -v hyprctl >/dev/null 2>&1 && [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]]; then
    if hyprctl workspaces -j 2>/dev/null | grep -Fq '"name": "special:fragments"'; then
        fail "special:fragments still exists"
    else
        ok "no special:fragments workspace exists"
    fi
fi

if pgrep -x fragments >/dev/null 2>&1; then
    ok "Fragments UI currently open on demand"
else
    ok "Fragments UI closed while background service remains active"
fi

if pacman -Qq qbittorrent >/dev/null 2>&1; then
    warn "qBittorrent is installed manually; Blueprint defaults still route torrents to Fragments"
else
    ok "qBittorrent absent from the Blueprint host"
fi

printf '\n========================================\n'
printf 'OK: %d   WARN: %d   FAIL: %d\n' "$OK" "$WARN" "$FAIL"
if ((FAIL == 0)); then printf 'RESULT: PASS\n'; exit 0; fi
printf 'RESULT: FAIL\n'; exit 1
