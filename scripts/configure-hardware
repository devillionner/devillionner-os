#!/usr/bin/env bash
set -Eeuo pipefail

REPO="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
source "$REPO/scripts/lib/common.sh"

FUN="$HOME/.config/fish/functions"
CONFIG_DIR="$(bp_config_dir)"
ZENBOOK_EE="$REPO/hardware/asus-zenbook-ux3405ca/easyeffects"
mkdir -p "$FUN" "$CONFIG_DIR" "$HOME/.cache"

MODEL="$(bp_product_name)"

write_generic_audio() {
    cat > "$FUN/eq-audio.fish" <<'EOF'
function eq-audio
    command easyeffects >/dev/null 2>&1 &
    echo "🔊 EasyEffects opened — create/select presets for this machine manually"
end
EOF
}

if bp_is_zenbook; then
    printf '%s\n' "asus-zenbook-ux3405ca" > "$CONFIG_DIR/hardware-profile"
    printf '%s\n' "Zenbook / Laptop" > "$HOME/.cache/ff-audio-preset"
    rm -f "$FUN/eq-pc.fish" "$FUN/eq-audio.fish"

    if [[ -d "$ZENBOOK_EE" ]] && find "$ZENBOOK_EE" -type f -name '*.json' -print -quit | grep -q .; then
        mkdir -p "$HOME/.config/easyeffects"
        rsync -a "$ZENBOOK_EE/" "$HOME/.config/easyeffects/"
        bp_ok "Zenbook EasyEffects presets restored"
    else
        bp_warn "Zenbook EasyEffects preset files are not captured in the Blueprint yet"
    fi

    bp_ok "Hardware profile: ASUS Zenbook UX3405CA"
    bp_ok "Audio commands: eq-laptop, eq-dolby, eq-sony"
    exit 0
fi

# Do not ship the owner's Zenbook/Sony/Dolby tuning to unrelated hardware.
# EasyEffects stays installed, but the user creates presets appropriate to the
# speakers/headphones attached to that machine.
rm -f \
    "$FUN/eq-laptop.fish" \
    "$FUN/eq-pc.fish" \
    "$FUN/eq-dolby.fish" \
    "$FUN/eq-sony.fish"
write_generic_audio
printf '%s\n' "generic" > "$CONFIG_DIR/hardware-profile"
printf '%s\n' "EasyEffects / Custom" > "$HOME/.cache/ff-audio-preset"

bp_ok "Hardware profile: generic machine (${MODEL:-unknown})"
bp_ok "Audio: EasyEffects installed; presets are user-managed (command: eq-audio)"
