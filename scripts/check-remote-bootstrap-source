#!/usr/bin/env bash
set -Eeuo pipefail

REPO="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
BOOTSTRAP="$REPO/bootstrap"
CONFIGURE="$REPO/scripts/configure-blueprint-cli"
APPLY="$REPO/scripts/apply-component"
COLLOID="$REPO/scripts/configure-colloid-icons"
RESTORE="$REPO/scripts/restore"
CHECK="$REPO/scripts/check"

fail() {
    printf 'Remote bootstrap source contract: FAIL: %s\n' "$*" >&2
    exit 1
}

for file in "$BOOTSTRAP" "$CONFIGURE" "$APPLY" "$COLLOID" "$RESTORE" "$CHECK"; do
    [[ -f "$file" ]] || fail "missing ${file#$REPO/}"
done
bash -n "$BOOTSTRAP" || fail "bootstrap Bash syntax"
bash -n "$CONFIGURE" || fail "configure-blueprint-cli Bash syntax"
bash -n "$APPLY" || fail "apply-component Bash syntax"
bash -n "$COLLOID" || fail "configure-colloid-icons Bash syntax"

python3 - "$BOOTSTRAP" "$CONFIGURE" "$APPLY" "$COLLOID" "$RESTORE" "$CHECK" <<'PY'
from pathlib import Path
import sys

bootstrap = Path(sys.argv[1]).read_text(encoding="utf-8")
configure = Path(sys.argv[2]).read_text(encoding="utf-8")
apply = Path(sys.argv[3]).read_text(encoding="utf-8")
colloid = Path(sys.argv[4]).read_text(encoding="utf-8")
restore = Path(sys.argv[5]).read_text(encoding="utf-8")
check = Path(sys.argv[6]).read_text(encoding="utf-8")

required_bootstrap = [
    'REPOSITORY="devillionner/devillionner-os"',
    'TMP_ROOT="$(mktemp -d -t devillionner-os.XXXXXXXX)"',
    'trap cleanup EXIT INT TERM HUP',
    'https://api.github.com/repos/$REPOSITORY/commits/$requested',
    'https://codeload.github.com/$REPOSITORY/tar.gz/$REVISION',
    'export DEVOS_SOURCE_REVISION="$REVISION"',
    'export DEVOS_SOURCE_MODE="ephemeral"',
    'STATE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/devillionner-os/source-revision"',
    'bash "$SOURCE_ROOT/scripts/install" "$@"',
    'bash "$SOURCE_ROOT/scripts/check" "$@"',
    'bash "$SOURCE_ROOT/scripts/apply-component" "$@"',
    'bash "$SOURCE_ROOT/scripts/configure-blueprint-cli" "$@"',
]
for needle in required_bootstrap:
    if needle not in bootstrap:
        raise SystemExit(f"bootstrap marker missing: {needle}")

if 'git clone' in bootstrap:
    raise SystemExit("remote bootstrap must not create a persistent Git checkout")
if 'tar.gz/main' in bootstrap or 'tar.gz/$REF' in bootstrap:
    raise SystemExit("source archive must be fetched by resolved commit SHA, not mutable ref")

required_configure = [
    'TARGET="/usr/local/bin/devos-blueprint"',
    'sudo install -Dm755 "$SOURCE" "$TARGET"',
]
for needle in required_configure:
    if needle not in configure:
        raise SystemExit(f"clone-less CLI install marker missing: {needle}")

# `apply` is intentionally a narrow migration/debugging tool for the current
# installation. It may run known configurators, but it must never become a
# profile restore/package-reconciliation bypass on the production system.
required_components = {
    'caelestia': ['configure-caelestia', 'configure-caelestia-cli', 'patch-caelestia-fullscreen'],
    'cursor': ['configure-cursor'],
    'dolphin': ['configure-dolphin'],
    'hardware': ['configure-hardware'],
    'spotify': ['configure-spotify'],
    'tvcast': ['configure-tv-cast'],
}
for component, scripts in required_components.items():
    if f'    {component})' not in apply:
        raise SystemExit(f"component apply case missing: {component}")
    for script in scripts:
        if f'$REPO/scripts/{script}' not in apply:
            raise SystemExit(f"component {component} no longer invokes {script}")

for forbidden in (
    'scripts/restore',
    'reconcile-packages',
    'pacman -S',
    'paru -S',
    'profile" >',
    'keyboard-mode',
    'features" >',
):
    if forbidden in apply:
        raise SystemExit(f"targeted component apply crossed its safety boundary: {forbidden}")

if 'export DEVOS_NO_PACKAGE_REMOVAL=1' not in apply:
    raise SystemExit("component apply no longer disables transitive package-removal migrations")
if '"${DEVOS_NO_PACKAGE_REMOVAL:-0}" == "1"' not in colloid:
    raise SystemExit("Colloid configurator does not honor component apply no-removal mode")
if 'targeted component apply never removes packages' not in colloid:
    raise SystemExit("Colloid no-removal branch is not explicit")

if '"$REPO/scripts/configure-blueprint-cli"' not in restore:
    raise SystemExit("restore does not install the clone-less Blueprint command")
if '"$CONFIG_DIR/source-revision"' not in restore:
    raise SystemExit("restore does not record the installed source revision")
if "devos-blueprint check" not in restore:
    raise SystemExit("restore still tells users to validate from a persistent repository")

required_check = [
    'devos-blueprint',
    'DEVOS_SOURCE_MODE:-',
    'temporary remote source bundle',
    'no persistent Git checkout required',
    'source-revision',
]
for needle in required_check:
    if needle not in check:
        raise SystemExit(f"aggregate clone-less validation marker missing: {needle}")
PY

printf 'Remote bootstrap source contract: PASS\n'
