#!/usr/bin/env bash
set -u

OK=0; WARN=0; FAIL=0
ok() { printf '  [OK]   %s\n' "$*"; OK=$((OK + 1)); }
warn() { printf '  [WARN] %s\n' "$*"; WARN=$((WARN + 1)); }
fail() { printf '  [FAIL] %s\n' "$*"; FAIL=$((FAIL + 1)); }

printf '========================================\n'
printf '     Caelestia package patch check\n'
printf '========================================\n'

if ! command -v pacman >/dev/null 2>&1; then
    fail "pacman missing"
elif ! pacman -Qq caelestia-shell >/dev/null 2>&1; then
    fail "caelestia-shell package missing"
else
    ok "caelestia-shell installed"
fi

SHORTCUTS="$(pacman -Ql caelestia-shell 2>/dev/null | awk '/\/modules\/Shortcuts\.qml$/ {print $2; exit}')"
CONTENT="$(pacman -Ql caelestia-shell 2>/dev/null | awk '/\/modules\/drawers\/ContentWindow\.qml$/ {print $2; exit}')"
SHELL_QML="/etc/xdg/quickshell/caelestia/shell.qml"

if [[ ! -f "$SHELL_QML" ]]; then
    SHELL_QML="$(pacman -Ql caelestia-shell 2>/dev/null | awk '/\/shell\.qml$/ {print $2; exit}')"
fi

if [[ -n "$SHORTCUTS" && -f "$SHORTCUTS" ]]; then
    ok "Shortcuts.qml located"
else
    fail "Shortcuts.qml not found in caelestia-shell package"
fi

if [[ -n "$CONTENT" && -f "$CONTENT" ]]; then
    ok "ContentWindow.qml located"
else
    fail "ContentWindow.qml not found in caelestia-shell package"
fi

if [[ -n "$SHELL_QML" && -f "$SHELL_QML" ]]; then
    ok "shell.qml located"
else
    fail "shell.qml not found in caelestia-shell package"
fi

if [[ -n "$SHORTCUTS" && -f "$SHORTCUTS" ]]; then
    if python3 - "$SHORTCUTS" <<'PY' >/dev/null 2>&1
import sys
from pathlib import Path

text = Path(sys.argv[1]).read_text(encoding="utf-8")
patched = '''    CustomShortcut {
        // qmllint enable unresolved-type
        name: "sidebar"
        description: "Toggle sidebar"
        onPressed: {
            const screenState = ShellState.forActive();
            screenState.sidebar = !screenState.sidebar;
        }
    }'''
assert patched in text
PY
    then
        ok "fullscreen sidebar shortcut patch active"
    else
        fail "fullscreen sidebar shortcut patch missing or upstream block changed"
    fi
fi

if [[ -n "$CONTENT" && -f "$CONTENT" ]]; then
    if grep -Fq 'mask: hasFullscreen && !screenState.sidebar ? emptyRegion : regions' "$CONTENT"; then
        ok "fullscreen sidebar input-mask patch active"
    else
        fail "fullscreen sidebar input-mask patch missing or upstream expression changed"
    fi
fi

if [[ -n "$SHELL_QML" && -f "$SHELL_QML" ]]; then
    env_ok=true
    for name in \
        QS_NO_RELOAD_POPUP \
        QS_DROP_EXPENSIVE_FONTS \
        QSG_RENDER_LOOP \
        QT_QUICK_FLICKABLE_WHEEL_DECELERATION; do
        if grep -Fq "//@ pragma Env ${name}=" "$SHELL_QML"; then
            ok "shell.qml Env pragma: $name"
        else
            fail "shell.qml Env pragma missing: $name"
            env_ok=false
        fi
    done
    [[ "$env_ok" == true ]] || true
fi

NEXUS_STATE="$(pacman -Ql caelestia-shell 2>/dev/null | awk '/\/modules\/nexus\/NexusState\.qml$/ {print $2; exit}')"
NETWORK_LIST="$(pacman -Ql caelestia-shell 2>/dev/null | awk '/\/modules\/nexus\/common\/NetworkList\.qml$/ {print $2; exit}')"
ADD_NETWORK="$(pacman -Ql caelestia-shell 2>/dev/null | awk '/\/modules\/nexus\/pages\/network\/AddNetworkPage\.qml$/ {print $2; exit}')"
NETWORK_CONNECTION="$(pacman -Ql caelestia-shell 2>/dev/null | awk '/\/utils\/NetworkConnection\.qml$/ {print $2; exit}')"
NMCLI="$(pacman -Ql caelestia-shell 2>/dev/null | awk '/\/services\/Nmcli\.qml$/ {print $2; exit}')"

wifi_ok=true
for file in "$NEXUS_STATE" "$NETWORK_LIST" "$ADD_NETWORK" "$NETWORK_CONNECTION" "$NMCLI"; do
    [[ -n "$file" && -f "$file" ]] || { fail "Caelestia Wi-Fi patch target missing"; wifi_ok=false; }
done

if [[ "$wifi_ok" == true ]]; then
    if python3 - "$NEXUS_STATE" "$NETWORK_LIST" "$ADD_NETWORK" "$NETWORK_CONNECTION" "$NMCLI" <<'PY' >/dev/null 2>&1
from pathlib import Path
import sys
nexus, listing, add, connection, nmcli = [Path(p).read_text(encoding="utf-8") for p in sys.argv[1:]]
assert 'property string pendingNetworkSsid' in nexus
assert 'NetworkConnection.handleConnect(modelData, null, target =>' in listing
assert 'network.isSecure && !Nmcli.hasSavedProfile(network.ssid)' in connection
assert 'function parseNmcliTerseLine(line: string): list<string>' in nmcli
assert 'ssid: net[3] ?? ""' in nmcli
assert 'root.savedConnectionSsids.some(savedSsid => savedSsid === ssid)' in nmcli
assert 'root.savedConnections.find(conn => conn === ssid) || ssid' in nmcli
assert 'const ssid = root.targetSsid || ssidField.text;' in add
assert 'NetworkConnection.connectWithPassword(target, passwordField.text, handleResult);' in add
assert 'Network not found — rescan and try again' in add
assert 'Connection failed — try again' in add
PY
    then
        ok "Caelestia Wi-Fi password/exact-SSID patch active"
    else
        fail "Caelestia Wi-Fi password/exact-SSID patch missing or upstream structure changed"
    fi
fi

printf '\nOK: %d   WARN: %d   FAIL: %d\n' "$OK" "$WARN" "$FAIL"
if ((FAIL == 0)); then
    printf 'RESULT: PASS\n'
    exit 0
fi
printf 'RESULT: FAIL\n'
exit 1
