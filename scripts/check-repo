#!/usr/bin/env bash
set -Eeuo pipefail

REPO="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
FAIL=0
OK=0

ok() {
    printf '  [OK]   %s\n' "$*"
    OK=$((OK + 1))
}

fail() {
    printf '  [FAIL] %s\n' "$*" >&2
    FAIL=$((FAIL + 1))
}

printf '========================================\n'
printf '       Blueprint repository check\n'
printf '========================================\n'

bash_checked=0
while IFS= read -r -d '' file; do
    first_line="$(head -n 1 "$file" 2>/dev/null || true)"
    [[ "$first_line" == *bash* ]] || continue
    if bash -n "$file"; then
        bash_checked=$((bash_checked + 1))
    else
        fail "bash syntax: ${file#$REPO/}"
    fi
done < <(find "$REPO/scripts" "$REPO/dotfiles/.local/bin" "$REPO/components" -type f -print0 2>/dev/null)
((bash_checked > 0)) && ok "bash syntax ($bash_checked files)" || fail "no Bash files discovered"

python_checked=0
while IFS= read -r -d '' file; do
    if python3 - "$file" <<'PY'
from pathlib import Path
import sys
path = Path(sys.argv[1])
compile(path.read_text(encoding="utf-8"), str(path), "exec")
PY
    then
        python_checked=$((python_checked + 1))
    else
        fail "Python syntax: ${file#$REPO/}"
    fi
done < <(find "$REPO/scripts" -type f -name '*.py' -print0 2>/dev/null)
((python_checked > 0)) && ok "Python syntax ($python_checked files)" || fail "no Python helper files discovered"

if python3 - "$REPO" <<'PY'
import json
import sys
from pathlib import Path

root = Path(sys.argv[1])
errors = []
count = 0
for path in sorted((root / "dotfiles").rglob("*.json")):
    count += 1
    try:
        json.loads(path.read_text())
    except Exception as exc:
        errors.append(f"{path.relative_to(root)}: {exc}")

if errors:
    print("\n".join(errors), file=sys.stderr)
    raise SystemExit(1)
print(count)
PY
then
    ok "JSON syntax"
else
    fail "JSON syntax"
fi

if python3 - "$REPO" <<'PY'
import sys
from pathlib import Path

root = Path(sys.argv[1])
errors = []
for path in sorted((root / "manifests").rglob("*.txt")):
    seen = set()
    for number, raw in enumerate(path.read_text().splitlines(), 1):
        value = raw.split("#", 1)[0].strip()
        if not value:
            continue
        if value in seen:
            errors.append(f"{path.relative_to(root)}:{number}: duplicate entry: {value}")
        seen.add(value)

if errors:
    print("\n".join(errors), file=sys.stderr)
    raise SystemExit(1)
PY
then
    ok "manifest entries are unique per file"
else
    fail "duplicate manifest entries"
fi

required_paths=(
    scripts/configure-dolphin
    scripts/check-dolphin
    scripts/lib/set-caelestia-file-explorer.py
    scripts/configure-spotify
    scripts/check-spotify
    scripts/configure-tv-cast
    scripts/check-tv-cast
    dotfiles/.local/bin/devos-spotify
    dotfiles/.local/bin/devos-spotify-theme-bootstrap
    dotfiles/.local/share/applications/spotify-launcher.desktop
    dotfiles/.config/systemd/user/devos-spotify-theme.path
)
for path in "${required_paths[@]}"; do
    [[ -e "$REPO/$path" ]] || fail "missing required path: $path"
done
[[ $FAIL -gt 0 ]] || ok "required integration files present"

if grep -Fq '"$REPO/scripts/configure-spotify"' "$REPO/scripts/restore" \
    && grep -Fq '"$REPO/scripts/check-spotify"' "$REPO/scripts/restore"; then
    ok "Spotify is wired into restore + validation"
else
    fail "Spotify restore/check wiring is incomplete"
fi

if grep -Fq '"$REPO/scripts/configure-dolphin"' "$REPO/scripts/restore" \
    && grep -Fq '"$REPO/scripts/check-dolphin"' "$REPO/scripts/restore"; then
    ok "Dolphin is wired into restore + validation"
else
    fail "Dolphin restore/check wiring is incomplete"
fi

if python3 - "$REPO/scripts/lib/set-caelestia-file-explorer.py" <<'PY'
import importlib.util
import sys
import tempfile
from pathlib import Path

helper = Path(sys.argv[1])
spec = importlib.util.spec_from_file_location("caelestia_vars", helper)
module = importlib.util.module_from_spec(spec)
assert spec and spec.loader
spec.loader.exec_module(module)

with tempfile.TemporaryDirectory() as tmp_raw:
    tmp = Path(tmp_raw)
    canonical = tmp / "canonical.lua"
    canonical.write_text('return {\n    fileExplorer = "/usr/local/bin/devos-dolphin",\n}\n')

    custom = tmp / "custom.lua"
    custom.write_text(
        'return {\n'
        '    browser = "helium",\n'
        '    fileExplorer = "thunar", -- user comment\n'
        '    windowRounding = 17,\n'
        '}\n'
    )
    module.update_file(canonical, custom)
    text = custom.read_text()
    assert 'browser = "helium"' in text
    assert 'windowRounding = 17' in text
    assert '-- user comment' in text
    assert text.count("fileExplorer") == 1
    assert 'fileExplorer = "/usr/local/bin/devos-dolphin"' in text

    target = tmp / "managed-target.lua"
    target.write_text('return {\n    terminal = "kitty",\n}\n')
    link = tmp / "hypr-vars.lua"
    link.symlink_to(target)
    module.update_file(canonical, link)
    assert link.is_symlink()
    target_text = target.read_text()
    assert 'terminal = "kitty"' in target_text
    assert target_text.count("fileExplorer") == 1
    assert 'fileExplorer = "/usr/local/bin/devos-dolphin"' in target_text

    unfamiliar = 'return {\n    fileExplorer = function() return "dolphin" end,\n}\n'
    try:
        module.update_text(unfamiliar)
    except ValueError:
        pass
    else:
        raise AssertionError("unfamiliar fileExplorer format was not rejected")
PY
then
    ok "Dolphin Caelestia override updater preserves custom data and symlinks"
else
    fail "Dolphin Caelestia override updater behavior"
fi

SPOTIFY_BOOTSTRAP="$REPO/dotfiles/.local/bin/devos-spotify-theme-bootstrap"
if grep -Fq 'overrides-sha256' "$SPOTIFY_BOOTSTRAP" \
    && grep -Fq 'overrides_hash=' "$SPOTIFY_BOOTSTRAP" \
    && grep -Fq 'overrides-sha256' "$REPO/scripts/check-spotify"; then
    ok "Spotify theme cache tracks Blueprint override revisions"
else
    fail "Spotify theme override fingerprinting is incomplete"
fi

SPOTIFY_DESKTOP="$REPO/dotfiles/.local/share/applications/spotify-launcher.desktop"
SPOTIFY_LAUNCHER="$REPO/dotfiles/.local/bin/devos-spotify"
if grep -Fqx 'TryExec=devos-spotify' "$SPOTIFY_DESKTOP" \
    && grep -Fqx 'Exec=devos-spotify %U' "$SPOTIFY_DESKTOP" \
    && grep -Fqx 'MimeType=x-scheme-handler/spotify;' "$SPOTIFY_DESKTOP" \
    && grep -Fq 'org.mpris.MediaPlayer2.Player' "$SPOTIFY_LAUNCHER" \
    && grep -Fq 'OpenUri s "$SPOTIFY_URI"' "$SPOTIFY_LAUNCHER"; then
    ok "Spotify desktop contract routes spotify: URIs through themed launcher"
else
    fail "Spotify desktop URI integration is incomplete"
fi

if grep -Fq 'FEATURES=("tvcast")' "$REPO/scripts/restore" \
    && grep -Fq '"$REPO/scripts/check-tv-cast"' "$REPO/scripts/restore"; then
    ok "TV Cast shared-feature wiring present"
else
    fail "TV Cast restore/check wiring is incomplete"
fi

printf '\n========================================\n'
printf 'OK: %d   FAIL: %d\n' "$OK" "$FAIL"
if ((FAIL == 0)); then
    printf 'RESULT: PASS\n'
    exit 0
fi
printf 'RESULT: FAIL\n'
exit 1
