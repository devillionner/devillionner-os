#!/usr/bin/env bash
set -Eeuo pipefail

REPO="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
CONFIG="$REPO/scripts/configure-spotify"
CHECK="$REPO/scripts/check-spotify"
DESKTOP="$REPO/dotfiles/.local/share/applications/spotify-launcher.desktop"
CLI="$REPO/dotfiles/.config/caelestia/cli.json"
LAUNCHER="$REPO/dotfiles/.local/bin/devos-spotify"
EXPERIENCE="$REPO/dotfiles/.local/bin/devos-spotify-experience"
UI="$REPO/dotfiles/.config/spicetify/Extensions/devos-clean-ui.js"
LAUNCHER_CONFIG="$REPO/dotfiles/.config/spotify-launcher.conf"

FAIL=0
OK=0
ok() { printf '  [OK]   %s\n' "$*"; OK=$((OK + 1)); }
fail() { printf '  [FAIL] %s\n' "$*" >&2; FAIL=$((FAIL + 1)); }

printf '========================================\n'
printf '    Spotify experience source check\n'
printf '========================================\n'

if grep -Fq 'sudo install -Dm755 "$REPO/dotfiles/.local/bin/devos-spotify" /usr/local/bin/devos-spotify' "$CONFIG" \
    && grep -Fq 'ln -sfn /usr/local/bin/devos-spotify "$HOME/.local/bin/devos-spotify"' "$CONFIG" \
    && grep -Fq 'sudo install -Dm755 "$REPO/dotfiles/.local/bin/devos-spotify-experience" /usr/local/bin/devos-spotify-experience' "$CONFIG" \
    && grep -Fq '/usr/local/share/devos/spotify/devos-clean-ui.js' "$CONFIG" \
    && grep -Fq 'install -Dm644 "$REPO/dotfiles/.config/spotify-launcher.conf" "$HOME/.config/spotify-launcher.conf"' "$CONFIG"; then
    ok "wrapper, experience helper and UI extension have canonical install paths"
else
    fail "Spotify canonical installation contract differs"
fi

if grep -Fq 'SYSTEM_LAUNCHER="/usr/local/bin/devos-spotify"' "$CHECK" \
    && grep -Fq 'SYSTEM_EXPERIENCE="/usr/local/bin/devos-spotify-experience"' "$CHECK" \
    && grep -Fq 'SYSTEM_UI="/usr/local/share/devos/spotify/devos-clean-ui.js"' "$CHECK"; then
    ok "runtime check validates all managed Spotify entry points"
else
    fail "Spotify runtime source check misses managed entry points"
fi

if grep -Fqx '[spotify]' "$LAUNCHER_CONFIG" \
    && grep -Fqx 'extra_arguments = ["--enable-features=UseOzonePlatform", "--ozone-platform=wayland"]' "$LAUNCHER_CONFIG" \
    && grep -Fq 'LAUNCHER_CONFIG="$HOME/.config/spotify-launcher.conf"' "$CHECK"; then
    ok "spotify-launcher native Wayland contract is source-managed"
else
    fail "spotify-launcher native Wayland source contract differs"
fi

if grep -Fqx 'TryExec=devos-spotify' "$DESKTOP" \
    && grep -Fqx 'Exec=devos-spotify %U' "$DESKTOP"; then
    ok "desktop entry resolves the managed wrapper through PATH"
else
    fail "Spotify desktop entry launcher contract differs"
fi

if python3 - "$CLI" <<'PY'
import json
import sys
from pathlib import Path
p = Path(sys.argv[1])
data = json.loads(p.read_text(encoding="utf-8"))
assert data["toggles"]["music"]["spotify"]["command"] == ["devos-spotify"]
PY
then
    ok "Caelestia music toggle uses the managed wrapper"
else
    fail "Caelestia Spotify command differs"
fi

if grep -Fq 'org.mpris.MediaPlayer2.Player' "$LAUNCHER" \
    && grep -Fq 'OpenUri s "$SPOTIFY_URI"' "$LAUNCHER" \
    && grep -Fq 'spotify-wrapper.lock' "$LAUNCHER" \
    && grep -Fq 'flock -n 9' "$LAUNCHER" \
    && grep -Fq 'devos-spotify-experience' "$LAUNCHER" \
    && grep -Fq 'spicetify -q -n auto' "$LAUNCHER" \
    && grep -Fq 'launch_vanilla' "$LAUNCHER" \
    && ! grep -Fq 'spicetify -q auto' "$LAUNCHER"; then
    ok "wrapper preserves URI routing, single-instance guard and deterministic launcher ownership after no-restart Spicetify apply"
else
    fail "Spotify wrapper lifecycle contract differs"
fi

if grep -Fq 'LUCID_PIN="5c5bead49d5dad971e0bb38d64e7dee88463cf83"' "$EXPERIENCE" \
    && grep -Fq 'LUCID_BASE="https://spicetify-lucid.sanooj.uk/spice"' "$EXPERIENCE" \
    && grep -Fq 'IVLYRICS_VERSION="6.6.13"' "$EXPERIENCE" \
    && grep -Fq 'IVLYRICS_SHA256="b3e77eaaf0f1d25276a009beefbfa30ab0478c9468712f8a96c7641f5ea2c476"' "$EXPERIENCE" \
    && grep -Fq 'current_theme Lucid' "$EXPERIENCE" \
    && grep -Fq 'color_scheme dark' "$EXPERIENCE" \
    && grep -Fq 'spicetify config extensions devos-clean-ui.js' "$EXPERIENCE" \
    && grep -Fq 'spicetify config custom_apps ivLyrics' "$EXPERIENCE" \
    && grep -Fq 'spicetify -q -n apply' "$EXPERIENCE" \
    && ! grep -Fq 'spicetify apply >/dev/null' "$EXPERIENCE"; then
    ok "Lucid + pinned ivLyrics experience identity and restart-free apply are reproducible"
else
    fail "Spotify experience source identity/configuration differs"
fi

if grep -Fq 'lucid:settings' "$UI" \
    && grep -Fq 'progress-bar__slider::after' "$UI" \
    && grep -Fq 'show: false' "$UI" \
    && grep -Fq 'adryd325/oneko.js/14bab15a755d0e35cd4ae19c931d96d306f99f42/oneko.gif' "$UI" \
    && grep -Fq "button[aria-label='Podcasts']" "$UI" \
    && grep -Fq 'fullscreen-mode-button' "$UI" \
    && grep -Fq 'main-actionBar-exploreButton' "$UI" \
    && grep -Fq 'main-nowPlayingView-section:not(.main-nowPlayingView-queue):not(.lyrics-npv-card)' "$UI" \
    && ! grep -Fq 'mask-image:' "$UI" \
    && ! grep -Fq 'getProgressPercent' "$UI"; then
    ok "curated cleanup, Lucid preset, exact native progress and Oneko are source-managed"
else
    fail "curated Spotify UI extension contract differs"
fi

legacy_found=0
for path in \
    "$REPO/dotfiles/.local/bin/devos-spotify-theme-bootstrap" \
    "$REPO/dotfiles/.local/bin/devos-spotify-theme-sync" \
    "$REPO/dotfiles/.config/systemd/user/devos-spotify-theme.path" \
    "$REPO/dotfiles/.config/systemd/user/devos-spotify-theme.service"; do
    [[ -e "$path" ]] && legacy_found=$((legacy_found + 1))
done
if ((legacy_found == 0)); then
    ok "legacy Bloom/palette watcher source files are retired"
else
    fail "$legacy_found legacy Spotify theme source file(s) still present"
fi

printf '\nOK: %d   FAIL: %d\n' "$OK" "$FAIL"
if ((FAIL == 0)); then
    printf 'RESULT: PASS\n'
    exit 0
fi
printf 'RESULT: FAIL\n'
exit 1
