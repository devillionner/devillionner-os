#!/usr/bin/env bash
set -Eeuo pipefail

REPO="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
CONFIG="$REPO/scripts/configure-spotify"
CHECK="$REPO/scripts/check-spotify"
DESKTOP="$REPO/dotfiles/.local/share/applications/spotify-launcher.desktop"
CLI="$REPO/dotfiles/.config/caelestia/cli.json"
SYNC="$REPO/dotfiles/.local/bin/devos-spotify-theme-sync"
BOOTSTRAP="$REPO/dotfiles/.local/bin/devos-spotify-theme-bootstrap"
LAUNCHER="$REPO/dotfiles/.local/bin/devos-spotify"

FAIL=0
OK=0
ok() { printf '  [OK]   %s\n' "$*"; OK=$((OK + 1)); }
fail() { printf '  [FAIL] %s\n' "$*" >&2; FAIL=$((FAIL + 1)); }

printf '========================================\n'
printf '    Spotify wrapper path source check\n'
printf '========================================\n'

if grep -Fq 'sudo install -Dm755 "$REPO/dotfiles/.local/bin/devos-spotify" /usr/local/bin/devos-spotify' "$CONFIG" \
    && grep -Fq 'ln -sfn /usr/local/bin/devos-spotify "$HOME/.local/bin/devos-spotify"' "$CONFIG"; then
    ok "canonical wrapper is system-visible with a user-local migration shim"
else
    fail "Spotify wrapper install path contract differs"
fi

if grep -Fq 'SYSTEM_LAUNCHER="/usr/local/bin/devos-spotify"' "$CHECK" \
    && grep -Fq 'user-local Spotify shim points to system wrapper' "$CHECK"; then
    ok "runtime check validates canonical wrapper + shadow prevention"
else
    fail "Spotify runtime check does not validate wrapper path contract"
fi

if grep -Fqx 'TryExec=devos-spotify' "$DESKTOP" \
    && grep -Fqx 'Exec=devos-spotify %U' "$DESKTOP"; then
    ok "desktop entry resolves wrapper through normal PATH"
else
    fail "Spotify desktop entry launcher contract differs"
fi

python3 - "$CLI" <<'PY'
import json
import sys
from pathlib import Path
p = Path(sys.argv[1])
data = json.loads(p.read_text(encoding="utf-8"))
assert data["toggles"]["music"]["spotify"]["command"] == ["devos-spotify"]
PY
ok "Caelestia toggle uses the same PATH-resolved command"

# Bloom is the visual owner. Blueprint pins its exact upstream revision and does
# not append local pane/frame geometry CSS anymore.
if grep -Fq 'PIN="654cfed682b94613b0029997ffafc1eadccc5bef"' "$BOOTSTRAP" \
    && grep -Fq 'THEME_DIR="$CONFIG_HOME/spicetify/Themes/devillionner-bloom"' "$BOOTSTRAP" \
    && grep -Fq 'nimsandu/spicetify-bloom/$PIN/src' "$BOOTSTRAP" \
    && grep -Fq 'curl -fsSL "$BASE_URL/user.css"' "$BOOTSTRAP" \
    && grep -Fq 'curl -fsSL "$BASE_URL/theme.js"' "$BOOTSTRAP" \
    && grep -Fq 'printf '\''%s\n'\'' "Bloom" > "$BASE"' "$BOOTSTRAP"; then
    ok "Bloom visual base is pinned and bootstraps CSS + theme.js"
else
    fail "Bloom bootstrap source contract differs"
fi

if [[ ! -e "$REPO/dotfiles/.config/spicetify/devillionner-overrides.css" ]] \
    && grep -Fq 'rm -f "$HOME/.config/spicetify/devillionner-overrides.css"' "$CONFIG"; then
    ok "legacy Blueprint Spotify geometry layer is retired"
else
    fail "legacy custom Spotify geometry CSS is still source-managed"
fi

if grep -Fq 'current_theme devillionner-bloom' "$LAUNCHER" \
    && grep -Fq 'color_scheme Devillionner' "$LAUNCHER" \
    && grep -Fq 'overwrite_assets 1' "$LAUNCHER" \
    && grep -Fq 'inject_theme_js 1' "$LAUNCHER"; then
    ok "launcher selects Bloom with required CSS/assets/theme.js injection"
else
    fail "Bloom launcher configuration differs"
fi

# Reproduce the physical-host palette format with GNU awk and verify the Bloom
# key set is generated silently from Caelestia colors.
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
mkdir -p "$TMP/hypr/scheme"
cat > "$TMP/hypr/scheme/current.lua" <<'EOF'
primary = "112233",
surface = "223344",
surfaceContainer = "334455",
surfaceContainerHigh = "445566",
onSurface = "556677",
onSurfaceVariant = "667788",
outlineVariant = "778899",
secondary = "8899aa",
error = "99aabb",
EOF
ERR="$TMP/stderr"
if XDG_CONFIG_HOME="$TMP" bash "$SYNC" 2>"$ERR" \
    && [[ ! -s "$ERR" ]] \
    && grep -Fqx 'accent             = 112233' "$TMP/spicetify/Themes/devillionner-bloom/color.ini" \
    && grep -Fqx 'main               = 223344' "$TMP/spicetify/Themes/devillionner-bloom/color.ini" \
    && grep -Fqx 'player             = 334455' "$TMP/spicetify/Themes/devillionner-bloom/color.ini" \
    && grep -Fqx 'player-border      = 778899' "$TMP/spicetify/Themes/devillionner-bloom/color.ini" \
    && grep -Fqx 'notification-error = 99aabb' "$TMP/spicetify/Themes/devillionner-bloom/color.ini"; then
    ok "Bloom palette parser is warning-free and preserves Caelestia colors"
else
    [[ -s "$ERR" ]] && cat "$ERR" >&2
    fail "Bloom palette parser emitted warnings or generated wrong colors"
fi

printf '\nOK: %d   FAIL: %d\n' "$OK" "$FAIL"
if ((FAIL == 0)); then
    printf 'RESULT: PASS\n'
    exit 0
fi
printf 'RESULT: FAIL\n'
exit 1
