#!/usr/bin/env bash
set -Eeuo pipefail

REPO="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
INSTALL="$REPO/scripts/install"
RESTORE="$REPO/scripts/restore"
RECOVERY="$REPO/scripts/create-recovery-point"
RECONCILE="$REPO/scripts/reconcile-packages"

fail() {
    printf 'Installer safety contract: FAIL: %s\n' "$*" >&2
    exit 1
}

for file in "$INSTALL" "$RESTORE" "$RECOVERY" "$RECONCILE"; do
    [[ -f "$file" ]] || fail "missing ${file#$REPO/}"
    bash -n "$file" || fail "bash syntax: ${file#$REPO/}"
done
[[ -f "$REPO/scripts/lib/recovery.py" ]] || fail "missing scripts/lib/recovery.py"
python3 -m py_compile "$REPO/scripts/lib/recovery.py" || fail "Python syntax: scripts/lib/recovery.py"

python3 - "$INSTALL" "$RESTORE" "$RECOVERY" <<'PY'
from pathlib import Path
import sys

install = Path(sys.argv[1]).read_text(encoding="utf-8")
restore = Path(sys.argv[2]).read_text(encoding="utf-8")
recovery = Path(sys.argv[3]).read_text(encoding="utf-8")


def require(text: str, needle: str, label: str) -> None:
    if needle not in text:
        raise SystemExit(f"missing {label}: {needle}")


def pos(text: str, needle: str, label: str) -> int:
    require(text, needle, label)
    return text.index(needle)


# Installer profile/feature defaults must stay deterministic.
require(
    install,
    '[[ "$PROFILE" == "laboratory" ]] && DEFAULT_VIRT=true || DEFAULT_VIRT=false',
    "Laboratory virtualization default",
)
require(
    install,
    'VIRTUALIZATION="$DEFAULT_VIRT"',
    "non-interactive virtualization default",
)
require(
    install,
    '[[ "$VIRTUALIZATION" == true ]] && ARGS+=(--feature virtualization)',
    "virtualization feature forwarding",
)

# Auto-targeting is intentionally narrow: KVM/QEMU or the one reserved partition.
require(install, 'if bp_is_vm; then\n        TARGET="--vm"', "VM auto-target")
require(
    install,
    '"$(bp_root_partuuid)" == "1c08b2fd-b4c8-4933-920b-80746d466558"',
    "reserved physical test PARTUUID",
)
require(
    install,
    'Physical install is intentionally blocked on an unknown root.',
    "unknown physical root hard stop",
)
require(
    install,
    'exec "$REPO/scripts/restore" "${ARGS[@]}"',
    "installer delegation to restore",
)

# Restore safety constants and target gates are contractual.
require(
    restore,
    'MAIN_PARTUUID="dd1a5d46-e370-454d-8278-2335f9eb1262"',
    "main CachyOS PARTUUID block",
)
require(
    restore,
    'TEST_PARTUUID="1c08b2fd-b4c8-4933-920b-80746d466558"',
    "reserved test PARTUUID",
)
require(restore, 'FEATURES=("tvcast")', "mandatory shared TV Cast feature")
require(restore, '[[ $EUID -ne 0 ]] || bp_die', "non-root execution guard")
require(
    restore,
    'if [[ "$ROOT_PARTUUID" == "$MAIN_PARTUUID" ]]; then',
    "main-installation guard",
)
require(
    restore,
    'bp_die "You are on the MAIN CachyOS. Restore is blocked."',
    "main-installation hard failure",
)
require(restore, 'kvm|qemu) bp_ok "KVM/QEMU test VM confirmed"', "KVM/QEMU VM gate")
require(
    restore,
    '[[ "$ROOT_PARTUUID" == "$TEST_PARTUUID" ]]',
    "reserved physical partition gate",
)
require(restore, 'read -r -p "Type RESTORE to continue: " ANSWER', "explicit restore confirmation")
require(restore, '[[ "$ANSWER" == "RESTORE" ]] || bp_die "Cancelled."', "exact RESTORE token")

# A rollback point must exist before package/system mutation begins.
checkpoint = pos(
    restore,
    '"$REPO/scripts/create-recovery-point"',
    "recovery-point invocation",
)
prereqs = pos(restore, 'bp_info "Installing restore prerequisites"', "restore prerequisites")
reconcile = pos(
    restore,
    '"$REPO/scripts/reconcile-packages" "${RECONCILE_ARGS[@]}"',
    "package reconciliation",
)
dotfiles = pos(restore, 'bp_info "Restoring dotfiles"', "dotfile restore")
if not checkpoint < prereqs < reconcile < dotfiles:
    raise SystemExit(
        "unsafe restore order: recovery point must precede prerequisites, package reconciliation and dotfile mutation"
    )

# Managed state must be written before the single aggregate validation runs.
state_profile = pos(
    restore,
    'printf \'%s\\n\' "$PROFILE" > "$CONFIG_DIR/profile"',
    "profile state write",
)
state_keyboard = pos(
    restore,
    'printf \'%s\\n\' "$KEYBOARD" > "$CONFIG_DIR/keyboard-mode"',
    "keyboard state write",
)
state_features = pos(
    restore,
    'printf \'%s\\n\' "${FEATURES[@]}" > "$CONFIG_DIR/features"',
    "feature state write",
)
aggregate = pos(
    restore,
    'if "$REPO/scripts/check" --profile "$PROFILE"; then',
    "aggregate runtime validation",
)
if not max(state_profile, state_keyboard, state_features) < aggregate:
    raise SystemExit("aggregate validation runs before Blueprint state is fully recorded")

# Recovery helper must fail closed when it cannot create a Btrfs/Snapper checkpoint.
require(recovery, 'coordinated root/home recovery point', "coordinated recovery invocation")
require(recovery, 'MANIFEST="$(sudo python3 "$REPO/scripts/lib/recovery.py" create "$HOME"', "recovery helper invocation")
require(recovery, 'last-checkpoint', "checkpoint state record")
require(recovery, 'Only publish after all snapshots and the manifest validate', "atomic checkpoint publication")
recovery_py = Path(sys.argv[3]).parent / "lib" / "recovery.py"
if '"subvolume", "snapshot"' not in recovery_py.read_text(encoding="utf-8") or '"snapper", "-c", "root", "create"' not in recovery_py.read_text(encoding="utf-8"):
    raise SystemExit("coordinated helper does not use safe root Snapper and home Btrfs snapshots")
if '"source": "/home"' not in recovery_py.read_text(encoding="utf-8"):
    raise SystemExit("coordinated helper does not create Btrfs snapshots")
if "source\": \"/home\"" not in recovery_py.read_text(encoding="utf-8"):
    raise SystemExit("coordinated helper does not model separate /home coverage")
PY

# The package reconciler must remain explicit-ownership based and never remove
# arbitrary packages outside its previously recorded Blueprint target.
grep -Fq 'comm -23 "$PREVIOUS_ALL" "$DESIRED_ALL"' "$RECONCILE" \
    || fail "reconcile-packages no longer computes removals from previous Blueprint ownership"
grep -Fq 'install -Dm644 "$DESIRED_REPO" "$MANAGED_DIR/repo.txt"' "$RECONCILE" \
    || fail "repository package ownership snapshot missing"
grep -Fq 'install -Dm644 "$DESIRED_AUR" "$MANAGED_DIR/aur.txt"' "$RECONCILE" \
    || fail "AUR package ownership snapshot missing"

# One force-removal exception exists for AUR dependency-layout migrations. It is
# intentionally narrow: only already-installed packages from the desired AUR
# target that paru itself reports as upgradeable may enter MIGRATION_BLOCKERS.
# They are removed once with -Rdd and the complete desired AUR target is retried
# immediately. Any broader/additional force-removal path must fail this contract.
python3 - "$RECONCILE" <<'PY'
from pathlib import Path
import re
import sys

text = Path(sys.argv[1]).read_text(encoding="utf-8")

raw_force_calls = re.findall(r'^\s*sudo\s+pacman\s+-Rdd\b[^\n]*$', text, re.M)
force_calls = [line.strip() for line in raw_force_calls]
expected = 'sudo pacman -Rdd --noconfirm "${MIGRATION_BLOCKERS[@]}"'
if force_calls != [expected]:
    raise SystemExit(f"unexpected pacman -Rdd calls: {force_calls}")

required = [
    'mapfile -t UPGRADABLE < <(paru -Qua --quiet 2>/dev/null || true)',
    'MIGRATION_BLOCKERS=()',
    'for pkg in "${FILTERED_AUR[@]}"; do',
    'pacman -Qq "$pkg" >/dev/null 2>&1 || continue',
    'printf \'%s\\n\' "${UPGRADABLE[@]}" | grep -qxF "$pkg"',
    '&& MIGRATION_BLOCKERS+=("$pkg")',
    'if ((${#MIGRATION_BLOCKERS[@]} == 0)); then',
    'bp_die "AUR install failed and no safe Blueprint-managed upgrade blocker was identified"',
    expected,
    'if ! install_aur_target; then',
    'bp_die "AUR install still fails after managed-package migration recovery"',
]
for needle in required:
    if needle not in text:
        raise SystemExit(f"AUR migration safety marker missing: {needle}")

# Ordering matters: identify blockers first, force-remove only that array, then
# immediately retry the complete desired AUR target.
pos = {needle: text.index(needle) for needle in required}
if not (
    pos['mapfile -t UPGRADABLE < <(paru -Qua --quiet 2>/dev/null || true)']
    < pos['MIGRATION_BLOCKERS=()']
    < pos['for pkg in "${FILTERED_AUR[@]}"; do']
    < pos[expected]
    < pos['bp_die "AUR install still fails after managed-package migration recovery"']
):
    raise SystemExit("AUR migration recovery order changed unexpectedly")

# Do not allow other common dependency-bypass/cascade removal forms anywhere in
# the reconciler. The exact -Rdd exception above is the only permitted one.
for line in text.splitlines():
    stripped = line.strip()
    if 'pacman ' not in stripped or ' -R' not in stripped:
        continue
    if stripped == expected:
        continue
    if re.search(r'(--nodeps|--cascade|\s-R[^\s]*d|\s-R[^\s]*c)', stripped):
        raise SystemExit(f"unsafe additional removal flags: {stripped}")
PY

printf 'Installer safety contract: PASS\n'
