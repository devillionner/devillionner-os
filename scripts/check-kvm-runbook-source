#!/usr/bin/env bash
set -Eeuo pipefail

REPO="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
RUNBOOK="$REPO/docs/kvm-validation.md"
INSTALL="$REPO/scripts/install"
BOOTSTRAP="$REPO/bootstrap"

fail() {
    printf 'KVM runbook source contract: FAIL: %s\n' "$*" >&2
    exit 1
}

[[ -f "$RUNBOOK" ]] || fail "docs/kvm-validation.md missing"
[[ -f "$INSTALL" ]] || fail "scripts/install missing"
[[ -f "$BOOTSTRAP" ]] || fail "bootstrap missing"
bash -n "$INSTALL" || fail "scripts/install Bash syntax"
bash -n "$BOOTSTRAP" || fail "bootstrap Bash syntax"

python3 - "$RUNBOOK" "$INSTALL" <<'PY'
from pathlib import Path
import re
import sys

runbook = Path(sys.argv[1]).read_text(encoding="utf-8")
install = Path(sys.argv[2]).read_text(encoding="utf-8")

# The implementation must still have deterministic non-interactive profile
# defaults before the runbook can meaningfully exercise them.
required_install = [
    '[[ "$PROFILE" == "laboratory" ]] && DEFAULT_VIRT=true || DEFAULT_VIRT=false',
    'VIRTUALIZATION="$DEFAULT_VIRT"',
    '[[ "$VIRTUALIZATION" == true ]] && ARGS+=(--feature virtualization)',
]
for needle in required_install:
    if needle not in install:
        raise SystemExit(f"installer default marker missing: {needle}")

if "git clone" in runbook:
    raise SystemExit("KVM runbook reintroduced a persistent Git checkout")
if "blueprint-tested-commit.txt" not in runbook:
    raise SystemExit("runbook no longer records one pinned revision")
if "bash -s -- version" not in runbook:
    raise SystemExit("runbook no longer resolves main to an exact commit before install")
if 'grep -Eq \'^[0-9a-f]{40}$\' ~/blueprint-tested-commit.txt' not in runbook:
    raise SystemExit("runbook no longer validates the pinned commit format")

blocks = re.findall(r"```bash\n(.*?)```", runbook, flags=re.S)
install_blocks = [
    block for block in blocks
    if "bash -s -- --ref" in block and " install " in block.replace("\\\n", " ")
]

expected = {
    "gaming": "false",
    "work": "false",
    "laboratory": "true",
    "university": "false",
}

for profile, expected_value in expected.items():
    matches = [block for block in install_blocks if f"--profile {profile}" in block]
    if len(matches) != 1:
        raise SystemExit(
            f"expected exactly one clone-less clean-install command for {profile}, found {len(matches)}"
        )
    block = matches[0]
    for marker in ('--ref "$REV"', "--keyboard windows", "--non-interactive", "--vm"):
        if marker not in block:
            raise SystemExit(f"{profile} KVM command missing {marker}")
    if "--with virtualization" in block or "--without virtualization" in block:
        raise SystemExit(
            f"{profile} KVM command overrides virtualization instead of testing its default"
        )
    evidence = f"Virtualization: {expected_value}"
    if evidence not in runbook:
        raise SystemExit(f"runbook does not require {profile} default evidence: {evidence}")

for profile in expected:
    expected_log = f"blueprint-{profile}-postreboot-check.log"
    if expected_log not in runbook:
        raise SystemExit(f"post-reboot evidence log missing for {profile}")

if 'devos-blueprint --ref "$REV" check' not in runbook:
    raise SystemExit("post-reboot validation is not pinned through the clone-less helper")
if "type `RESTORE`" not in runbook:
    raise SystemExit("runbook no longer preserves the explicit RESTORE confirmation")
if "same revision" not in runbook.lower():
    raise SystemExit("runbook no longer requires install/check revision identity")
PY

printf 'KVM runbook source contract: PASS\n'
