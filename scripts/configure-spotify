#!/usr/bin/env bash
set -Eeuo pipefail

REPO="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
source "$REPO/scripts/lib/common.sh"

command -v spotify-launcher >/dev/null 2>&1 || bp_die "spotify-launcher is missing"
command -v spicetify >/dev/null 2>&1 || bp_die "spicetify is missing"

bash "$REPO/scripts/configure-caelestia-cli"

bp_info "Installing Spotify + Spicetify integration (theme remains user-managed)"

sudo install -Dm755 "$REPO/dotfiles/.local/bin/devos-spotify" /usr/local/bin/devos-spotify
mkdir -p "$HOME/.local/bin"
ln -sfn /usr/local/bin/devos-spotify "$HOME/.local/bin/devos-spotify"
install -Dm644 "$REPO/dotfiles/.local/share/applications/spotify-launcher.desktop" "$HOME/.local/share/applications/spotify-launcher.desktop"

# Retire every historical Blueprint-owned visual layer without touching themes
# installed by the user/Marketplace (Lucid, Bloom, etc.).
systemctl --user disable --now devos-spotify-theme.path >/dev/null 2>&1 || true
systemctl --user disable --now devos-spotify-theme.service >/dev/null 2>&1 || true
rm -f \
    "$HOME/.config/systemd/user/devos-spotify-theme.path" \
    "$HOME/.config/systemd/user/devos-spotify-theme.service" \
    "$HOME/.local/bin/devos-spotify-theme-bootstrap" \
    "$HOME/.local/bin/devos-spotify-theme-sync" \
    "$HOME/.config/spicetify/devillionner-overrides.css"
rm -rf "$HOME/.config/spicetify/Themes/devillionner-bloom"
systemctl --user daemon-reload

python - "$HOME/.config/mimeapps.list" <<'PY'
from configparser import RawConfigParser
from pathlib import Path
import sys

path = Path(sys.argv[1])
cfg = RawConfigParser(interpolation=None, strict=False)
cfg.optionxform = str
if path.exists():
    cfg.read(path, encoding="utf-8")
if not cfg.has_section("Default Applications"):
    cfg.add_section("Default Applications")
cfg.set("Default Applications", "x-scheme-handler/spotify", "spotify-launcher.desktop")
path.parent.mkdir(parents=True, exist_ok=True)
with path.open("w", encoding="utf-8") as handle:
    cfg.write(handle, space_around_delimiters=False)
PY

install -Dm644 "$REPO/dotfiles/.config/hypr/hyprland/rules.lua" "$HOME/.config/hypr/hyprland/rules.lua"

spotify-launcher --no-exec >/dev/null 2>&1 || bp_warn "spotify-launcher could not prefetch/update Spotify"

SPOTIFY_ROOT="$HOME/.local/share/spotify-launcher/install/usr/share/spotify"
PREFS="$HOME/.config/spotify/prefs"
if [[ -f "$PREFS" && -d "$SPOTIFY_ROOT" ]]; then
    # Only own the application paths. Never set current_theme/color_scheme or
    # overwrite Marketplace/user theme files.
    spicetify config spotify_path "$SPOTIFY_ROOT" prefs_path "$PREFS" >/dev/null || \
        bp_warn "Spicetify paths could not be refreshed"
else
    bp_warn "Spotify needs one normal first launch/login before Spicetify can apply themes."
fi

command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$HOME/.local/share/applications" >/dev/null 2>&1 || true

if [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] && command -v hyprctl >/dev/null 2>&1; then
    hyprctl reload >/dev/null 2>&1 || true
fi

bp_ok "Spotify integration ready: user-managed Spicetify theme, Super+M, spotify: links, single-instance launcher and Hyprland window policy"
