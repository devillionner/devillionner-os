#!/usr/bin/env bash
set -Eeuo pipefail

REPO="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
MAN="$REPO/manifests"

MAIN_PARTUUID="dd1a5d46-e370-454d-8278-2335f9eb1262"
TEST_PARTUUID="1c08b2fd-b4c8-4933-920b-80746d466558"
MODE="${1:-}"

info() { printf "\n==> %s\n" "$*"; }
ok()   { printf "    [OK] %s\n" "$*"; }
warn() { printf "    [WARN] %s\n" "$*" >&2; }
die()  { printf "\n    [SAFETY STOP] %s\n" "$*" >&2; exit 1; }

printf "========================================\n"
printf "       devillionner-os restore\n"
printf "========================================\n"

grep -Eq "^ID=\"?cachyos\"?$" /etc/os-release 2>/dev/null \
    || die "This restore is intended for CachyOS."

[[ $EUID -ne 0 ]] || die "Run this as your normal user, NOT as root."

ROOT_SRC="$(findmnt -no SOURCE /)"
ROOT_DEV="${ROOT_SRC%%[*}"
ROOT_DEV="$(readlink -f "$ROOT_DEV")"
ROOT_PARTUUID="$(lsblk -no PARTUUID "$ROOT_DEV" 2>/dev/null | head -n1 | xargs)"
VIRT="$(systemd-detect-virt 2>/dev/null || true)"

printf "Root device:   %s\n" "$ROOT_DEV"
printf "Root PARTUUID: %s\n" "${ROOT_PARTUUID:-unknown}"
printf "Virtualization: %s\n" "${VIRT:-none}"

if [[ "$ROOT_PARTUUID" == "$MAIN_PARTUUID" ]]; then
    die "You are on the MAIN CachyOS. Restore is blocked."
fi

if [[ "$MODE" == "--vm" ]]; then
    case "$VIRT" in
        kvm|qemu) ok "KVM/QEMU test VM confirmed" ;;
        *) die "--vm was requested, but this system is not a KVM/QEMU guest." ;;
    esac
elif [[ "$ROOT_PARTUUID" == "$TEST_PARTUUID" ]]; then
    ok "CachyOS Work partition confirmed"
else
    die "Unknown restore target. Use --vm only inside the Blueprint KVM test VM."
fi

printf "\nThis will install packages and restore dotfiles/services.\n"
printf "It will NOT repartition disks or modify Windows partitions.\n\n"
read -r -p "Type RESTORE to continue: " ANSWER
[[ "$ANSWER" == "RESTORE" ]] || die "Cancelled."

info "Authorizing sudo"
sudo -v

info "Installing restore prerequisites"
sudo pacman -Syu --needed --noconfirm base-devel git rsync

info "Installing repository packages"
mapfile -t REPO_PKGS < <(sed "/^[[:space:]]*$/d" "$MAN/packages-repo.txt")

if grep -qx "pipewire-jack" "$MAN/packages-repo.txt" \
    && pacman -Qq jack2 >/dev/null 2>&1; then
    info "Switching JACK implementation: jack2 -> pipewire-jack"
    printf 'y\ny\n' | sudo pacman -S --needed pipewire-jack
fi

if (( ${#REPO_PKGS[@]} > 0 )); then
    sudo pacman -S --needed --noconfirm "${REPO_PKGS[@]}"
fi

info "Installing AUR / foreign packages"
mapfile -t AUR_PKGS < <(sed "/^[[:space:]]*$/d" "$MAN/packages-aur.txt")

# Caelestia 2.x needs current upstream Quickshell. On fresh CachyOS, provider
# resolution can otherwise select noctalia-qs, which provides quickshell-git
# but is not compatible with Caelestia's current QML pragmas.
if grep -qx "caelestia-shell" "$MAN/packages-aur.txt" \
    && ! pacman -Qq quickshell-git >/dev/null 2>&1; then
    info "Installing upstream quickshell-git for Caelestia"
    TMP_QS="$(mktemp -d)"
    trap 'rm -rf "$TMP_QS"' EXIT
    git clone --depth 1 https://aur.archlinux.org/quickshell-git.git "$TMP_QS/quickshell-git"
    (
        cd "$TMP_QS/quickshell-git"
        makepkg -si --needed --noconfirm
    )
    rm -rf "$TMP_QS"
    trap - EXIT
fi

# caelestia-firefox-theme is an upstream-local Arch package, not an AUR package.
SPECIAL_CAEL_FIREFOX=false
FILTERED_AUR_PKGS=()
for PKG in "${AUR_PKGS[@]}"; do
    if [[ "$PKG" == "caelestia-firefox-theme" ]]; then
        SPECIAL_CAEL_FIREFOX=true
    else
        FILTERED_AUR_PKGS+=("$PKG")
    fi
done

if (( ${#FILTERED_AUR_PKGS[@]} > 0 )); then
    if ! command -v paru >/dev/null 2>&1; then
        sudo pacman -S --needed --noconfirm paru
    fi
    paru -S --needed --noconfirm "${FILTERED_AUR_PKGS[@]}"
fi

if [[ "$SPECIAL_CAEL_FIREFOX" == true ]] \
    && ! pacman -Qq caelestia-firefox-theme >/dev/null 2>&1; then
    info "Installing caelestia-firefox-theme from upstream Caelestia source"
    sudo pacman -S --needed --noconfirm inotify-tools
    TMP_CAEL="$(mktemp -d)"
    trap 'rm -rf "$TMP_CAEL"' EXIT
    git clone --depth 1 https://github.com/caelestia-dots/caelestia.git "$TMP_CAEL/caelestia"
    (
        cd "$TMP_CAEL/caelestia/packages/caelestia-firefox-theme"
        makepkg -si --needed --noconfirm
    )
    rm -rf "$TMP_CAEL"
    trap - EXIT
fi

if [[ -s "$MAN/flatpak-apps.txt" ]]; then
    info "Installing Flatpak applications"
    sudo pacman -S --needed --noconfirm flatpak
    if ! flatpak remotes --columns=name 2>/dev/null | grep -qx flathub; then
        flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo
    fi
    mapfile -t FLATPAKS < <(sed "/^[[:space:]]*$/d" "$MAN/flatpak-apps.txt")
    (( ${#FLATPAKS[@]} == 0 )) || flatpak install -y flathub "${FLATPAKS[@]}"
fi

info "Restoring dotfiles"
mkdir -p "$HOME/.config" "$HOME/.local"
rsync -a "$REPO/dotfiles/.config/" "$HOME/.config/"
rsync -a "$REPO/dotfiles/.local/"  "$HOME/.local/"
find "$HOME/.local/bin" -maxdepth 1 -type f -exec chmod +x {} + 2>/dev/null || true

mkdir -p "$HOME/.cache"
if [[ ! -e "$HOME/.cache/ff-audio-preset" ]]; then
    printf "%s\n" "Zenbook / Laptop" > "$HOME/.cache/ff-audio-preset"
fi

info "Configuring Fish"
FISH_BIN="$(command -v fish)"
CURRENT_LOGIN_SHELL="$(getent passwd "$USER" | cut -d: -f7)"
if [[ "$CURRENT_LOGIN_SHELL" != "$FISH_BIN" ]]; then
    chsh -s "$FISH_BIN" "$USER"
else
    ok "Fish already configured as login shell"
fi

info "Enabling recorded system services"
while IFS= read -r UNIT; do
    [[ -z "$UNIT" ]] && continue
    if systemctl cat "$UNIT" >/dev/null 2>&1; then
        if ! sudo systemctl enable "$UNIT" >/dev/null 2>&1; then
            warn "Could not enable $UNIT"
        fi
    else
        warn "Unit not available: $UNIT"
    fi
done < "$MAN/services-system.txt"

info "Enabling recorded user services"
systemctl --user daemon-reload
while IFS= read -r UNIT; do
    [[ -z "$UNIT" ]] && continue
    if systemctl --user cat "$UNIT" >/dev/null 2>&1; then
        if ! systemctl --user enable "$UNIT" >/dev/null 2>&1; then
            warn "Could not enable user unit $UNIT"
        fi
    else
        warn "User unit not available: $UNIT"
    fi
done < "$MAN/services-user.txt"

systemctl --user enable wireplumber.service >/dev/null 2>&1 || true
systemctl --user enable pipewire.socket >/dev/null 2>&1 || true
systemctl --user enable pipewire-pulse.socket >/dev/null 2>&1 || true

info "Running Blueprint validation"
if "$REPO/scripts/check"; then
    printf "\n========================================\n"
    printf "RESTORE COMPLETED\n"
    printf "Validation: PASS\n"
    printf "========================================\n"
else
    printf "\n========================================\n"
    printf "RESTORE COMPLETED WITH DIFFERENCES\n"
    printf "Review validation output above.\n"
    printf "========================================\n"
fi

printf "\nA reboot is recommended before final validation.\n"
