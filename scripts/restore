#!/usr/bin/env bash
set -Eeuo pipefail

REPO="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
MAN="$REPO/manifests/profiles"
FEATURE_MAN="$REPO/manifests/features"
source "$REPO/scripts/lib/common.sh"

MAIN_PARTUUID="dd1a5d46-e370-454d-8278-2335f9eb1262"
TEST_PARTUUID="1c08b2fd-b4c8-4933-920b-80746d466558"

PROFILE=""
KEYBOARD=""
TARGET=""
# TV Cast is a shared system feature: every Gaming/Work/Laboratory restore gets it.
FEATURES=("tvcast")

feature_enabled() {
    local wanted="$1" feature
    for feature in "${FEATURES[@]}"; do
        [[ "$feature" == "$wanted" ]] && return 0
    done
    return 1
}

while (($#)); do
    case "$1" in
        --profile)
            [[ $# -ge 2 ]] || bp_die "--profile needs a value"
            PROFILE="$(bp_normalize_profile "$2")" || bp_die "Unknown profile: $2"
            shift 2
            ;;
        --keyboard)
            [[ $# -ge 2 ]] || bp_die "--keyboard needs a value"
            case "$2" in
                windows|mac|copilot) KEYBOARD="$2" ;;
                *) bp_die "Unknown keyboard mode: $2" ;;
            esac
            shift 2
            ;;
        --feature)
            [[ $# -ge 2 ]] || bp_die "--feature needs a value"
            case "$2" in
                virtualization|tvcast)
                    feature_enabled "$2" || FEATURES+=("$2")
                    ;;
                *) bp_die "Unknown feature: $2" ;;
            esac
            shift 2
            ;;
        --vm) TARGET="vm"; shift ;;
        --test-partition) TARGET="test"; shift ;;
        *) bp_die "Unknown option: $1" ;;
    esac
done

[[ -n "$PROFILE" ]] || bp_die "Profile is required. Use scripts/install for the interactive installer."
[[ -n "$KEYBOARD" ]] || bp_die "Keyboard mode is required. Use scripts/install for the interactive installer."
[[ -n "$TARGET" ]] || bp_die "Target is required (--vm or --test-partition)."

printf "========================================\n"
printf "       devillionner-os restore v0.4\n"
printf "========================================\n"

grep -Eq '^ID="?cachyos"?$' /etc/os-release 2>/dev/null \
    || bp_die "This restore is intended for CachyOS."

[[ $EUID -ne 0 ]] || bp_die "Run this as your normal user, NOT as root."

ROOT_SRC="$(findmnt -no SOURCE /)"
ROOT_DEV="${ROOT_SRC%%[*}"
ROOT_DEV="$(readlink -f "$ROOT_DEV")"
ROOT_PARTUUID="$(bp_root_partuuid)"
VIRT="$(systemd-detect-virt 2>/dev/null || true)"

printf "Root device:     %s\n" "$ROOT_DEV"
printf "Root PARTUUID:   %s\n" "${ROOT_PARTUUID:-unknown}"
printf "Virtualization:  %s\n" "${VIRT:-none}"
printf "Profile:         %s\n" "$PROFILE"
printf "Features:        %s\n" "${FEATURES[*]:-none}"
printf "Keyboard:        %s\n" "$KEYBOARD"

if [[ "$ROOT_PARTUUID" == "$MAIN_PARTUUID" ]]; then
    bp_die "You are on the MAIN CachyOS. Restore is blocked."
fi

case "$TARGET" in
    vm)
        case "$VIRT" in
            kvm|qemu) bp_ok "KVM/QEMU test VM confirmed" ;;
            *) bp_die "--vm requested, but this is not a KVM/QEMU guest." ;;
        esac
        ;;
    test)
        [[ "$ROOT_PARTUUID" == "$TEST_PARTUUID" ]] \
            || bp_die "Reserved test partition not detected. Refusing physical restore."
        bp_ok "Reserved Blueprint test partition confirmed"
        ;;
esac

printf "\nThis installs the selected profile/features, restores desktop config, and creates a rollback point first.\n"
printf "It does NOT repartition disks, touch Windows partitions, or restore personal data.\n\n"
read -r -p "Type RESTORE to continue: " ANSWER
[[ "$ANSWER" == "RESTORE" ]] || bp_die "Cancelled."

bp_info "Authorizing sudo"
sudo -v

"$REPO/scripts/create-recovery-point" \
    "devillionner-os pre-restore ($PROFILE; ${FEATURES[*]:-no extra features})"

bp_info "Installing restore prerequisites"
sudo pacman -Syu --needed --noconfirm base-devel git rsync

mapfile -t REPO_PKGS < <(
    {
        bp_strip_manifest "$MAN/common-repo.txt"
        bp_strip_manifest "$MAN/$PROFILE-repo.txt"
        for feature in "${FEATURES[@]}"; do
            bp_strip_manifest "$FEATURE_MAN/$feature-repo.txt"
        done
    } | sort -u
)

mapfile -t AUR_PKGS < <(
    {
        bp_strip_manifest "$MAN/common-aur.txt"
        bp_strip_manifest "$MAN/$PROFILE-aur.txt"
        for feature in "${FEATURES[@]}"; do
            bp_strip_manifest "$FEATURE_MAN/$feature-aur.txt"
        done
    } | sort -u
)

bp_info "Installing repository packages (${#REPO_PKGS[@]})"

if printf '%s\n' "${REPO_PKGS[@]}" | grep -qx "pipewire-jack" \
    && pacman -Qq jack2 >/dev/null 2>&1; then
    bp_info "Switching JACK implementation: jack2 -> pipewire-jack"
    printf 'y\ny\n' | sudo pacman -S --needed pipewire-jack
fi

if ((${#REPO_PKGS[@]})); then
    sudo pacman -S --needed --noconfirm "${REPO_PKGS[@]}"
fi

NEED_QS=false
FILTERED_AUR=()
for pkg in "${AUR_PKGS[@]}"; do
    if [[ "$pkg" == "quickshell-git" ]]; then
        NEED_QS=true
    else
        FILTERED_AUR+=("$pkg")
    fi
done

if [[ "$NEED_QS" == true ]]; then
    QS_HEALTHY=false
    if pacman -Qq quickshell-git >/dev/null 2>&1 \
        && qs --version >/dev/null 2>&1; then
        QS_HEALTHY=true
    fi

    if [[ "$QS_HEALTHY" != true ]]; then
        bp_info "Building current quickshell-git for Caelestia"

        if pacman -Qq noctalia-qs >/dev/null 2>&1; then
            bp_info "Removing conflicting noctalia-qs provider"
            sudo pacman -R --noconfirm noctalia-qs
        fi

        TMP_QS="$(mktemp -d)"
        git clone --depth 1 \
            https://aur.archlinux.org/quickshell-git.git \
            "$TMP_QS/quickshell-git"
        (
            cd "$TMP_QS/quickshell-git"
            makepkg -si --needed --noconfirm
        )
        rm -rf "$TMP_QS"

        qs --version >/dev/null 2>&1 \
            || bp_die "quickshell-git still fails after rebuild."
        bp_ok "quickshell-git runtime healthy"
    else
        bp_ok "quickshell-git runtime healthy"
    fi
fi

if ((${#FILTERED_AUR[@]})); then
    if ! command -v paru >/dev/null 2>&1; then
        sudo pacman -S --needed --noconfirm paru
    fi
    bp_info "Installing AUR / foreign packages (${#FILTERED_AUR[@]})"
    paru -S --needed --noconfirm "${FILTERED_AUR[@]}"
fi

bp_info "Restoring dotfiles"
mkdir -p "$HOME/.config" "$HOME/.local"
rsync -a "$REPO/dotfiles/.config/" "$HOME/.config/"
rsync -a "$REPO/dotfiles/.local/" "$HOME/.local/"
find "$HOME/.local/bin" -maxdepth 1 -type f -exec chmod +x {} + 2>/dev/null || true

bp_info "Configuring keyboard"
"$REPO/scripts/configure-keyboard" "$KEYBOARD"

bp_info "Configuring hardware-specific behavior"
"$REPO/scripts/configure-hardware"

if [[ -f "$REPO/scripts/patch-caelestia-fullscreen" ]]; then
    bp_info "Applying Caelestia compatibility/UI patches"
    if ! bash "$REPO/scripts/patch-caelestia-fullscreen"; then
        bp_warn "Caelestia patch could not be applied; upstream files may have changed."
    fi
fi

if [[ -f "$REPO/scripts/configure-helium" ]]; then
    bp_info "Configuring Helium browser defaults"
    if ! bash "$REPO/scripts/configure-helium"; then
        bp_warn "Helium defaults could not be fully applied."
    fi
fi

if feature_enabled tvcast; then
    "$REPO/scripts/configure-tv-cast"
fi

if feature_enabled virtualization; then
    "$REPO/scripts/configure-virtualization"
fi

"$REPO/scripts/optimize-system" "$PROFILE"

bp_info "Configuring Fish"
FISH_BIN="$(command -v fish)"
CURRENT_LOGIN_SHELL="$(getent passwd "$USER" | cut -d: -f7)"
if [[ "$CURRENT_LOGIN_SHELL" != "$FISH_BIN" ]]; then
    chsh -s "$FISH_BIN" "$USER"
else
    bp_ok "Fish already configured as login shell"
fi

enable_system_manifest() {
    local file="$1" unit
    while IFS= read -r unit; do
        [[ -z "$unit" ]] && continue
        if systemctl cat "$unit" >/dev/null 2>&1; then
            sudo systemctl enable "$unit" >/dev/null 2>&1 \
                || bp_warn "Could not enable $unit"
        else
            bp_warn "Unit not available: $unit"
        fi
    done < <(bp_strip_manifest "$file")
}

enable_user_manifest() {
    local file="$1" unit
    while IFS= read -r unit; do
        [[ -z "$unit" ]] && continue
        if systemctl --user cat "$unit" >/dev/null 2>&1; then
            systemctl --user enable "$unit" >/dev/null 2>&1 \
                || bp_warn "Could not enable user unit $unit"
        else
            bp_warn "User unit not available: $unit"
        fi
    done < <(bp_strip_manifest "$file")
}

bp_info "Enabling services"
enable_system_manifest "$MAN/services-common.txt"
enable_system_manifest "$MAN/services-$PROFILE.txt"
for feature in "${FEATURES[@]}"; do
    enable_system_manifest "$FEATURE_MAN/services-$feature.txt"
done
systemctl --user daemon-reload
enable_user_manifest "$MAN/services-user-common.txt"

CONFIG_DIR="$(bp_config_dir)"
mkdir -p "$CONFIG_DIR"
printf '%s\n' "$PROFILE" > "$CONFIG_DIR/profile"
printf '%s\n' "$KEYBOARD" > "$CONFIG_DIR/keyboard-mode"
printf '%s\n' "${FEATURES[@]}" > "$CONFIG_DIR/features"

bp_info "Running Blueprint validation"
VALIDATION_PASS=true

if ! "$REPO/scripts/check" --profile "$PROFILE"; then
    VALIDATION_PASS=false
fi

if feature_enabled tvcast && ! "$REPO/scripts/check-tv-cast"; then
    VALIDATION_PASS=false
fi

if [[ "$VALIDATION_PASS" == true ]]; then
    printf "\n========================================\n"
    printf "RESTORE COMPLETED\n"
    printf "Profile: %s\n" "$PROFILE"
    printf "Features: %s\n" "${FEATURES[*]:-none}"
    printf "Validation: PASS\n"
    printf "========================================\n"
else
    printf "\n========================================\n"
    printf "RESTORE COMPLETED WITH DIFFERENCES\n"
    printf "Review validation output above.\n"
    printf "========================================\n"
fi

printf "\nReboot before final validation.\n"
