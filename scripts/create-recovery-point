#!/usr/bin/env bash
set -Eeuo pipefail

REPO="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
source "$REPO/scripts/lib/common.sh"

[[ $EUID -ne 0 ]] || bp_die "Run recovery creation as the restore user, not root."
for cmd in python3 btrfs findmnt sudo; do
    command -v "$cmd" >/dev/null || bp_die "Recovery prerequisite missing: $cmd"
done
[[ "${XDG_CONFIG_HOME:-$HOME/.config}" == "$HOME/.config" \
    && "${XDG_STATE_HOME:-$HOME/.local/state}" == "$HOME/.local/state" \
    && "${XDG_DATA_HOME:-$HOME/.local/share}" == "$HOME/.local/share" ]] \
    || bp_die "Relocated XDG directories require a separately validated recovery plan."

STATE_DIR="$(bp_state_dir)"
mkdir -p "$STATE_DIR"
bp_info "Creating coordinated root/home recovery point"
# Only publish after all snapshots and the manifest validate. Failure leaves
# the previous last-checkpoint untouched and stops restore before mutation.
MANIFEST="$(sudo python3 "$REPO/scripts/lib/recovery.py" create "$HOME" \
    "${1:-devillionner-os pre-restore}")"
[[ "$MANIFEST" == /.snapshots/devillionner-os/*/manifest.json ]] \
    || bp_die "Recovery helper returned an invalid manifest path"
TMP="$(mktemp "$STATE_DIR/.checkpoint.XXXXXXXX")"
trap 'rm -f -- "$TMP"' EXIT
printf 'bundle:%s\n' "$MANIFEST" > "$TMP"
mv -f -- "$TMP" "$STATE_DIR/last-checkpoint"
bp_ok "Verified recovery bundle: $MANIFEST"
