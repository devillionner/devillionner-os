#!/usr/bin/env bash
set -u

OK=0; WARN=0; FAIL=0
ok() { printf '  [OK]   %s\n' "$*"; OK=$((OK + 1)); }
warn() { printf '  [WARN] %s\n' "$*"; WARN=$((WARN + 1)); }
fail() { printf '  [FAIL] %s\n' "$*"; FAIL=$((FAIL + 1)); }

printf '========================================\n'
printf '       Spotify integration check\n'
printf '========================================\n'

for cmd in spotify-launcher spicetify devos-spotify; do
    command -v "$cmd" >/dev/null 2>&1 && ok "$cmd" || fail "$cmd missing"
done

for file in \
    "$HOME/.local/bin/devos-spotify-theme-bootstrap" \
    "$HOME/.local/bin/devos-spotify-theme-sync" \
    "$HOME/.config/spicetify/devillionner-overrides.css" \
    "$HOME/.config/systemd/user/devos-spotify-theme.path" \
    "$HOME/.config/systemd/user/devos-spotify-theme.service" \
    "$HOME/.local/share/applications/spotify-launcher.desktop"; do
    [[ -f "$file" ]] && ok "${file#$HOME/}" || fail "missing: ${file#$HOME/}"
done

DESKTOP="$HOME/.local/share/applications/spotify-launcher.desktop"
if grep -qx 'TryExec=devos-spotify' "$DESKTOP" 2>/dev/null \
    && grep -qx 'Exec=devos-spotify %U' "$DESKTOP" 2>/dev/null \
    && grep -qx 'MimeType=x-scheme-handler/spotify;' "$DESKTOP" 2>/dev/null; then
    ok "Spotify desktop entry preserves spotify: URI handling"
else
    fail "Spotify desktop entry is missing themed URI routing"
fi

LAUNCHER="$HOME/.local/bin/devos-spotify"
if grep -Fq 'org.mpris.MediaPlayer2.Player' "$LAUNCHER" 2>/dev/null \
    && grep -Fq 'OpenUri s "$SPOTIFY_URI"' "$LAUNCHER" 2>/dev/null \
    && grep -Fq 'spotify-launcher --skip-update "$SPOTIFY_URI"' "$LAUNCHER" 2>/dev/null; then
    ok "themed launcher supports MPRIS + spotify-launcher URI fallback"
else
    fail "themed launcher URI forwarding is incomplete"
fi

THEME="$HOME/.config/spicetify/Themes/devillionner-text"
OVERRIDES="$HOME/.config/spicetify/devillionner-overrides.css"
if [[ -f "$THEME/user.css" ]]; then
    ok "pinned text-theme CSS bootstrapped"
else
    fail "theme CSS not bootstrapped"
fi

grep -q '^\[Devillionner\]$' "$THEME/color.ini" 2>/dev/null && ok "adaptive color scheme generated" || fail "adaptive color.ini missing"

if command -v sha256sum >/dev/null 2>&1 \
    && [[ -f "$OVERRIDES" && -f "$THEME/overrides-sha256" ]]; then
    EXPECTED_HASH="$(sha256sum "$OVERRIDES" | awk '{print $1}')"
    STORED_HASH="$(cat "$THEME/overrides-sha256" 2>/dev/null || true)"
    if [[ "$EXPECTED_HASH" == "$STORED_HASH" ]]; then
        ok "latest Blueprint Spotify overrides are applied"
    else
        fail "generated Spotify CSS is stale; rerun configure-spotify or devos-spotify"
    fi
else
    fail "Spotify override fingerprint missing"
fi

if [[ -f "$THEME/upstream-revision" ]] \
    && grep -qx '3f55a3702bd6d87799dc97023e0fe2b11d88c704' "$THEME/upstream-revision"; then
    ok "pinned upstream text-theme revision recorded"
else
    fail "upstream Spotify theme revision marker missing or unexpected"
fi

systemctl --user is-enabled devos-spotify-theme.path >/dev/null 2>&1 && ok "palette watcher enabled" || fail "palette watcher not enabled"

if [[ -f "$HOME/.config/spotify/prefs" ]]; then
    ok "Spotify prefs exist"
    CFG="$HOME/.config/spicetify/config-xpui.ini"
    grep -Eq '^current_theme[[:space:]]*=[[:space:]]*devillionner-text' "$CFG" 2>/dev/null && ok "Spicetify theme selected" || warn "theme will be selected on next devos-spotify launch"
    grep -Eq '^color_scheme[[:space:]]*=[[:space:]]*Devillionner' "$CFG" 2>/dev/null && ok "adaptive scheme selected" || warn "scheme will be selected on next devos-spotify launch"
else
    warn "first Spotify login is still required before Spicetify can apply"
fi

printf '\n========================================\n'
printf 'OK: %d   WARN: %d   FAIL: %d\n' "$OK" "$WARN" "$FAIL"
if ((FAIL == 0)); then printf 'RESULT: PASS\n'; exit 0; fi
printf 'RESULT: FAIL\n'; exit 1
