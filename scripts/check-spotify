#!/usr/bin/env bash
set -u

OK=0; WARN=0; FAIL=0
ok() { printf '  [OK]   %s\n' "$*"; OK=$((OK + 1)); }
warn() { printf '  [WARN] %s\n' "$*"; WARN=$((WARN + 1)); }
fail() { printf '  [FAIL] %s\n' "$*"; FAIL=$((FAIL + 1)); }

printf '========================================\n'
printf '       Spotify integration check\n'
printf '========================================\n'

for cmd in spotify-launcher spicetify devos-spotify flock; do
    command -v "$cmd" >/dev/null 2>&1 && ok "$cmd" || fail "$cmd missing"
done

SYSTEM_LAUNCHER="/usr/local/bin/devos-spotify"
USER_LAUNCHER="$HOME/.local/bin/devos-spotify"
if [[ -x "$SYSTEM_LAUNCHER" ]]; then ok "system Spotify wrapper installed"; else fail "system Spotify wrapper missing"; fi
if [[ -L "$USER_LAUNCHER" ]] && [[ "$(readlink -f "$USER_LAUNCHER" 2>/dev/null || true)" == "$SYSTEM_LAUNCHER" ]]; then
    ok "user-local Spotify shim points to system wrapper"
else
    fail "user-local Spotify wrapper may shadow the system launcher"
fi

DESKTOP="$HOME/.local/share/applications/spotify-launcher.desktop"
[[ -f "$DESKTOP" ]] && ok ".local/share/applications/spotify-launcher.desktop" || fail "managed Spotify desktop entry missing"

CAELESTIA_CLI="$HOME/.config/caelestia/cli.json"
if python3 - "$CAELESTIA_CLI" <<'PY' >/dev/null 2>&1
import json, sys
from pathlib import Path
p = Path(sys.argv[1])
data = json.loads(p.read_text())
spotify = data["toggles"]["music"]["spotify"]
assert spotify.get("enable") is True
assert spotify.get("command") == ["devos-spotify"]
assert spotify.get("move") is True
matches = spotify.get("match")
assert {"class": "Spotify"} in matches
assert {"class": "spotify"} in matches
assert {"initialTitle": "Spotify"} in matches
assert {"initialTitle": "Spotify Free"} in matches
PY
then ok "Caelestia music toggle matches Spotify identity"; else fail "Caelestia Spotify toggle differs"; fi

HYPR_RULES="$HOME/.config/hypr/hyprland/rules.lua"
if grep -Fq '"Spotify|spotify"' "$HYPR_RULES" 2>/dev/null && grep -Fq '"Spotify|Spotify Free"' "$HYPR_RULES" 2>/dev/null; then
    ok "Hyprland music workspace matches Spotify identity"
else
    fail "Hyprland Spotify identity rules differ"
fi

if grep -qx 'TryExec=devos-spotify' "$DESKTOP" 2>/dev/null \
    && grep -qx 'Exec=devos-spotify %U' "$DESKTOP" 2>/dev/null \
    && grep -qx 'MimeType=x-scheme-handler/spotify;' "$DESKTOP" 2>/dev/null \
    && grep -qx 'StartupWMClass=spotify' "$DESKTOP" 2>/dev/null; then
    ok "Spotify desktop entry preserves URI and WM-class routing"
else
    fail "Spotify desktop entry routing differs"
fi

MIME="$HOME/.config/mimeapps.list"
grep -qx 'x-scheme-handler/spotify=spotify-launcher.desktop' "$MIME" 2>/dev/null && ok "spotify: protocol uses managed launcher" || fail "spotify: protocol handler differs"

if grep -Fq 'org.mpris.MediaPlayer2.Player' "$SYSTEM_LAUNCHER" 2>/dev/null \
    && grep -Fq 'OpenUri s "$SPOTIFY_URI"' "$SYSTEM_LAUNCHER" 2>/dev/null; then
    ok "launcher supports MPRIS URI forwarding"
else
    fail "launcher URI forwarding incomplete"
fi

if grep -Fq 'spotify-wrapper.lock' "$SYSTEM_LAUNCHER" 2>/dev/null \
    && grep -Fq 'exec 9>"$LOCK"' "$SYSTEM_LAUNCHER" 2>/dev/null \
    && grep -Fq 'flock -n 9' "$SYSTEM_LAUNCHER" 2>/dev/null; then
    ok "single managed Spotify wrapper enforced"
else
    fail "Spotify single-instance guard incomplete"
fi

# Theme ownership boundary: Blueprint must not keep historical theme automation.
legacy=0
for path in \
    "$HOME/.local/bin/devos-spotify-theme-bootstrap" \
    "$HOME/.local/bin/devos-spotify-theme-sync" \
    "$HOME/.config/systemd/user/devos-spotify-theme.path" \
    "$HOME/.config/systemd/user/devos-spotify-theme.service" \
    "$HOME/.config/spicetify/devillionner-overrides.css" \
    "$HOME/.config/spicetify/Themes/devillionner-bloom"; do
    [[ -e "$path" || -L "$path" ]] && legacy=$((legacy + 1))
done
if ((legacy == 0)); then ok "Blueprint theme automation retired; Marketplace/user themes are untouched"; else fail "$legacy legacy Blueprint Spotify theme artifact(s) remain"; fi

if systemctl --user is-enabled devos-spotify-theme.path >/dev/null 2>&1; then
    fail "legacy Spotify palette watcher still enabled"
else
    ok "no Blueprint theme watcher enabled"
fi

PREFS="$HOME/.config/spotify/prefs"
CFG="$HOME/.config/spicetify/config-xpui.ini"
if [[ -f "$PREFS" ]]; then
    ok "Spotify prefs exist"
    if [[ -f "$CFG" ]]; then
        theme="$(sed -n 's/^current_theme[[:space:]]*=[[:space:]]*//p' "$CFG" | tail -n1)"
        scheme="$(sed -n 's/^color_scheme[[:space:]]*=[[:space:]]*//p' "$CFG" | tail -n1)"
        [[ -n "$theme" ]] && ok "user-selected Spicetify theme: $theme" || warn "no custom Spicetify theme selected yet"
        [[ -n "$scheme" ]] && ok "user-selected color scheme: $scheme" || true
    else
        warn "Spicetify config not generated yet"
    fi
else
    warn "first Spotify login is still required before Spicetify themes can apply"
fi

printf '\n========================================\n'
printf 'OK: %d   WARN: %d   FAIL: %d\n' "$OK" "$WARN" "$FAIL"
if ((FAIL == 0)); then printf 'RESULT: PASS\n'; exit 0; fi
printf 'RESULT: FAIL\n'; exit 1
