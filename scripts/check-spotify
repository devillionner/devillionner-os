#!/usr/bin/env bash
set -u

OK=0; WARN=0; FAIL=0
ok() { printf '  [OK]   %s\n' "$*"; OK=$((OK + 1)); }
warn() { printf '  [WARN] %s\n' "$*"; WARN=$((WARN + 1)); }
fail() { printf '  [FAIL] %s\n' "$*"; FAIL=$((FAIL + 1)); }

printf '========================================\n'
printf '       Spotify integration check\n'
printf '========================================\n'

for cmd in spotify-launcher spicetify devos-spotify devos-spotify-experience flock; do
    command -v "$cmd" >/dev/null 2>&1 && ok "$cmd" || fail "$cmd missing"
done

SYSTEM_LAUNCHER="/usr/local/bin/devos-spotify"
USER_LAUNCHER="$HOME/.local/bin/devos-spotify"
SYSTEM_EXPERIENCE="/usr/local/bin/devos-spotify-experience"
USER_EXPERIENCE="$HOME/.local/bin/devos-spotify-experience"
SYSTEM_UI="/usr/local/share/devos/spotify/devos-clean-ui.js"
LAUNCHER_CONFIG="$HOME/.config/spotify-launcher.conf"

[[ -x "$SYSTEM_LAUNCHER" ]] && ok "system Spotify wrapper installed" || fail "system Spotify wrapper missing"
if [[ -L "$USER_LAUNCHER" ]] && [[ "$(readlink -f "$USER_LAUNCHER" 2>/dev/null || true)" == "$SYSTEM_LAUNCHER" ]]; then
    ok "user-local Spotify shim points to system wrapper"
else
    fail "user-local Spotify wrapper may shadow the system launcher"
fi
[[ -x "$SYSTEM_EXPERIENCE" ]] && ok "Spotify experience helper installed" || fail "Spotify experience helper missing"
if [[ -L "$USER_EXPERIENCE" ]] && [[ "$(readlink -f "$USER_EXPERIENCE" 2>/dev/null || true)" == "$SYSTEM_EXPERIENCE" ]]; then
    ok "user-local experience shim points to system helper"
else
    fail "user-local Spotify experience helper differs"
fi
[[ -s "$SYSTEM_UI" ]] && ok "curated Spotify UI extension installed" || fail "curated Spotify UI extension missing"

if [[ -f "$LAUNCHER_CONFIG" ]] \
    && grep -Fqx '[spotify]' "$LAUNCHER_CONFIG" \
    && grep -Fqx 'extra_arguments = ["--enable-features=UseOzonePlatform", "--ozone-platform=wayland"]' "$LAUNCHER_CONFIG"; then
    ok "spotify-launcher is pinned to native Wayland"
else
    fail "spotify-launcher native Wayland config differs"
fi

DESKTOP="$HOME/.local/share/applications/spotify-launcher.desktop"
[[ -f "$DESKTOP" ]] && ok ".local/share/applications/spotify-launcher.desktop" || fail "managed Spotify desktop entry missing"

CAELESTIA_CLI="$HOME/.config/caelestia/cli.json"
if python3 - "$CAELESTIA_CLI" <<'PY' >/dev/null 2>&1
import json, sys
from pathlib import Path
p = Path(sys.argv[1])
data = json.loads(p.read_text())
spotify = data["toggles"]["music"]["spotify"]
assert spotify.get("enable") is True
assert spotify.get("command") == ["devos-spotify"]
assert spotify.get("move") is True
matches = spotify.get("match")
assert {"class": "Spotify"} in matches
assert {"class": "spotify"} in matches
assert {"initialTitle": "Spotify"} in matches
assert {"initialTitle": "Spotify Free"} in matches
PY
then ok "Caelestia music toggle matches Spotify identity"; else fail "Caelestia Spotify toggle differs"; fi

HYPR_RULES="$HOME/.config/hypr/hyprland/rules.lua"
if grep -Fq '"Spotify|spotify"' "$HYPR_RULES" 2>/dev/null && grep -Fq '"Spotify|Spotify Free"' "$HYPR_RULES" 2>/dev/null; then
    ok "Hyprland music workspace matches Spotify identity"
else
    fail "Hyprland Spotify identity rules differ"
fi

if grep -qx 'TryExec=devos-spotify' "$DESKTOP" 2>/dev/null \
    && grep -qx 'Exec=devos-spotify %U' "$DESKTOP" 2>/dev/null \
    && grep -qx 'MimeType=x-scheme-handler/spotify;' "$DESKTOP" 2>/dev/null \
    && grep -qx 'StartupWMClass=spotify' "$DESKTOP" 2>/dev/null; then
    ok "Spotify desktop entry preserves URI and WM-class routing"
else
    fail "Spotify desktop entry routing differs"
fi

MIME="$HOME/.config/mimeapps.list"
grep -qx 'x-scheme-handler/spotify=spotify-launcher.desktop' "$MIME" 2>/dev/null && ok "spotify: protocol uses managed launcher" || fail "spotify: protocol handler differs"

if grep -Fq 'org.mpris.MediaPlayer2.Player' "$SYSTEM_LAUNCHER" 2>/dev/null \
    && grep -Fq 'OpenUri s "$SPOTIFY_URI"' "$SYSTEM_LAUNCHER" 2>/dev/null; then
    ok "launcher supports MPRIS URI forwarding"
else
    fail "launcher URI forwarding incomplete"
fi

if grep -Fq 'spotify-wrapper.lock' "$SYSTEM_LAUNCHER" 2>/dev/null \
    && grep -Fq 'exec 9>"$LOCK"' "$SYSTEM_LAUNCHER" 2>/dev/null \
    && grep -Fq 'flock -n 9' "$SYSTEM_LAUNCHER" 2>/dev/null \
    && grep -Fq 'devos-spotify-experience' "$SYSTEM_LAUNCHER" 2>/dev/null; then
    ok "single managed wrapper auto-prepares the Spotify experience"
else
    fail "Spotify wrapper lifecycle/experience hook incomplete"
fi

legacy=0
for path in \
    "$HOME/.local/bin/devos-spotify-theme-bootstrap" \
    "$HOME/.local/bin/devos-spotify-theme-sync" \
    "$HOME/.config/systemd/user/devos-spotify-theme.path" \
    "$HOME/.config/systemd/user/devos-spotify-theme.service" \
    "$HOME/.config/spicetify/devillionner-overrides.css" \
    "$HOME/.config/spicetify/Themes/devillionner-bloom"; do
    [[ -e "$path" || -L "$path" ]] && legacy=$((legacy + 1))
done
if ((legacy == 0)); then ok "legacy Blueprint Bloom automation retired"; else fail "$legacy legacy Blueprint Spotify artifact(s) remain"; fi

if systemctl --user is-enabled devos-spotify-theme.path >/dev/null 2>&1; then
    fail "legacy Spotify palette watcher still enabled"
else
    ok "no legacy Spotify palette watcher enabled"
fi

PREFS="$HOME/.config/spotify/prefs"
CFG="$HOME/.config/spicetify/config-xpui.ini"
THEME="$HOME/.config/spicetify/Themes/Lucid"
USER_UI="$HOME/.config/spicetify/Extensions/devos-clean-ui.js"
IVLYRICS="$HOME/.config/spicetify/CustomApps/ivLyrics"

if [[ -f "$PREFS" ]]; then
    ok "Spotify prefs exist"

    if [[ -s "$THEME/user.css" && -s "$THEME/color.ini" && -s "$THEME/theme.js" ]] \
        && [[ "$(cat "$THEME/.devos-upstream-revision" 2>/dev/null || true)" == "5c5bead49d5dad971e0bb38d64e7dee88463cf83" ]]; then
        ok "current Lucid theme assets installed from pinned manifest identity"
    else
        fail "Lucid theme assets/revision incomplete"
    fi

    if [[ -s "$IVLYRICS/index.js" && -s "$IVLYRICS/manifest.json" ]] \
        && [[ "$(tr -d '[:space:]' < "$IVLYRICS/version.txt" 2>/dev/null || true)" == "6.6.13" ]]; then
        ok "ivLyrics 6.6.13 installed"
    else
        fail "ivLyrics installation/version incomplete"
    fi

    if [[ -s "$USER_UI" ]] && cmp -s "$SYSTEM_UI" "$USER_UI"; then
        ok "curated cleanup/native-progress/Oneko extension matches Blueprint"
    else
        fail "curated Spotify UI extension differs"
    fi

    if [[ -f "$CFG" ]] \
        && grep -Eq '^current_theme[[:space:]]*=[[:space:]]*Lucid[[:space:]]*$' "$CFG" \
        && grep -Eq '^color_scheme[[:space:]]*=[[:space:]]*dark[[:space:]]*$' "$CFG" \
        && grep -Eq '^extensions[[:space:]]*=.*devos-clean-ui\.js' "$CFG" \
        && grep -Eq '^custom_apps[[:space:]]*=.*ivLyrics' "$CFG" \
        && grep -Eq '^inject_css[[:space:]]*=[[:space:]]*1[[:space:]]*$' "$CFG" \
        && grep -Eq '^replace_colors[[:space:]]*=[[:space:]]*1[[:space:]]*$' "$CFG" \
        && grep -Eq '^overwrite_assets[[:space:]]*=[[:space:]]*1[[:space:]]*$' "$CFG" \
        && grep -Eq '^inject_theme_js[[:space:]]*=[[:space:]]*1[[:space:]]*$' "$CFG"; then
        ok "Lucid + ivLyrics + curated extension selected"
    else
        fail "Spicetify curated experience configuration incomplete"
    fi
else
    warn "first Spotify login is still required; experience will bootstrap on next managed launch"
fi

printf '\n========================================\n'
printf 'OK: %d   WARN: %d   FAIL: %d\n' "$OK" "$WARN" "$FAIL"
if ((FAIL == 0)); then printf 'RESULT: PASS\n'; exit 0; fi
printf 'RESULT: FAIL\n'; exit 1
