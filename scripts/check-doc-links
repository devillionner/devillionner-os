#!/usr/bin/env bash
set -Eeuo pipefail

REPO="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

python3 - "$REPO" <<'PY'
import re
import sys
from pathlib import Path
from urllib.parse import unquote

root = Path(sys.argv[1]).resolve()
markdown_files = []
readme = root / "README.md"
if readme.exists():
    markdown_files.append(readme)
docs = root / "docs"
if docs.exists():
    markdown_files.extend(sorted(docs.rglob("*.md")))

# Standard inline Markdown links/images. External URLs and in-document anchors
# are intentionally ignored; this check owns only repository-local targets.
link_re = re.compile(r"!?\[[^\]]*\]\(([^)]+)\)")
errors = []
checked = 0

for source in markdown_files:
    text = source.read_text(encoding="utf-8")
    for match in link_re.finditer(text):
        raw = match.group(1).strip()
        if not raw:
            continue
        if raw.startswith("<") and ">" in raw:
            destination = raw[1:raw.index(">")]
        else:
            # Optional Markdown link titles follow the destination after
            # whitespace; Blueprint local paths intentionally contain no spaces.
            destination = raw.split(maxsplit=1)[0]

        lower = destination.lower()
        if lower.startswith(("http://", "https://", "mailto:", "tel:", "data:")):
            continue
        if destination.startswith("#"):
            continue

        destination = destination.split("#", 1)[0].split("?", 1)[0]
        if not destination:
            continue
        destination = unquote(destination)

        path = Path(destination)
        if path.is_absolute():
            # Absolute paths are website/runtime paths, not repository files.
            continue

        target = (source.parent / path).resolve()
        try:
            target.relative_to(root)
        except ValueError:
            errors.append(
                f"{source.relative_to(root)}: local link escapes repository: {destination}"
            )
            continue

        checked += 1
        if not target.exists():
            errors.append(
                f"{source.relative_to(root)}: missing local link target: {destination}"
            )

if errors:
    print("Documentation link errors:", file=sys.stderr)
    for error in errors:
        print(f"  - {error}", file=sys.stderr)
    raise SystemExit(1)

print(f"Documentation local links: PASS ({checked} checked across {len(markdown_files)} Markdown files)")
PY
