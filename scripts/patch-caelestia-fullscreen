#!/usr/bin/env bash
set -Eeuo pipefail

info() { printf "==> %s\n" "$*"; }
ok()   { printf "    [OK] %s\n" "$*"; }
warn() { printf "    [WARN] %s\n" "$*" >&2; }

if ! pacman -Qq caelestia-shell >/dev/null 2>&1; then
    warn "caelestia-shell is not installed; skipping Caelestia patches"
    exit 0
fi

SHORTCUTS="$(pacman -Ql caelestia-shell | awk '/\/modules\/Shortcuts\.qml$/ {print $2; exit}')"
CONTENT="$(pacman -Ql caelestia-shell | awk '/\/modules\/drawers\/ContentWindow\.qml$/ {print $2; exit}')"
SHELL_QML="/etc/xdg/quickshell/caelestia/shell.qml"

if [[ ! -f "$SHELL_QML" ]]; then
    SHELL_QML="$(pacman -Ql caelestia-shell | awk '/\/shell\.qml$/ {print $2; exit}')"
fi

if [[ -z "$SHORTCUTS" || -z "$CONTENT" || -z "$SHELL_QML" || ! -f "$SHELL_QML" ]]; then
    warn "Could not locate required Caelestia QML files; skipping patches"
    exit 0
fi

info "Patching Caelestia fullscreen sidebar behavior and runtime environment"

sudo python - "$SHORTCUTS" "$CONTENT" "$SHELL_QML" <<'PY'
from pathlib import Path
import sys

shortcuts = Path(sys.argv[1])
content = Path(sys.argv[2])
shell_qml = Path(sys.argv[3])

# Allow SUPER+N/sidebar shortcut while a fullscreen client is active.
s = shortcuts.read_text()
old_sidebar = '''    CustomShortcut {
        // qmllint enable unresolved-type
        name: "sidebar"
        description: "Toggle sidebar"
        onPressed: {
            if (root.hasFullscreen)
                return;
            const screenState = ShellState.forActive();
            screenState.sidebar = !screenState.sidebar;
        }
    }'''
new_sidebar = '''    CustomShortcut {
        // qmllint enable unresolved-type
        name: "sidebar"
        description: "Toggle sidebar"
        onPressed: {
            const screenState = ShellState.forActive();
            screenState.sidebar = !screenState.sidebar;
        }
    }'''

if new_sidebar in s:
    print("Shortcuts.qml: already patched")
elif old_sidebar in s:
    shortcuts.write_text(s.replace(old_sidebar, new_sidebar, 1))
    print("Shortcuts.qml: patched")
else:
    raise SystemExit("Shortcuts.qml: expected sidebar block not found; refusing to modify")

# Keep fullscreen input masked normally, but make the sidebar interactive while open.
c = content.read_text()
old_mask = "mask: hasFullscreen ? emptyRegion : regions"
new_mask = "mask: hasFullscreen && !screenState.sidebar ? emptyRegion : regions"

if new_mask in c:
    print("ContentWindow.qml: already patched")
elif old_mask in c:
    content.write_text(c.replace(old_mask, new_mask, 1))
    print("ContentWindow.qml: patched")
else:
    raise SystemExit("ContentWindow.qml: expected fullscreen mask not found; refusing to modify")

# Caelestia currently needs these values forced with Env rather than DefaultEnv
# on this setup; with DefaultEnv the shell may start without rendering.
env_names = (
    "QS_NO_RELOAD_POPUP",
    "QS_DROP_EXPENSIVE_FONTS",
    "QSG_RENDER_LOOP",
    "QT_QUICK_FLICKABLE_WHEEL_DECELERATION",
)

q = shell_qml.read_text()
changed = []
already = []
missing = []

for name in env_names:
    old = f"//@ pragma DefaultEnv {name}="
    new = f"//@ pragma Env {name}="

    if new in q:
        already.append(name)
    elif old in q:
        q = q.replace(old, new, 1)
        changed.append(name)
    else:
        missing.append(name)

if missing:
    raise SystemExit(
        "shell.qml: expected environment pragmas not found: "
        + ", ".join(missing)
    )

if changed:
    shell_qml.write_text(q)
    print("shell.qml: Env patched: " + ", ".join(changed))
else:
    print("shell.qml: environment pragmas already patched")
PY

ok "Caelestia patches applied"
