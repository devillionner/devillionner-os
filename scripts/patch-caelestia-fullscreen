#!/usr/bin/env bash
set -Eeuo pipefail

info() { printf "==> %s\n" "$*"; }
ok()   { printf "    [OK] %s\n" "$*"; }
warn() { printf "    [WARN] %s\n" "$*" >&2; }

if ! pacman -Qq caelestia-shell >/dev/null 2>&1; then
    warn "caelestia-shell is not installed; skipping Caelestia patches"
    exit 0
fi

SHORTCUTS="$(pacman -Ql caelestia-shell | awk '/\/modules\/Shortcuts\.qml$/ {print $2; exit}')"
CONTENT="$(pacman -Ql caelestia-shell | awk '/\/modules\/drawers\/ContentWindow\.qml$/ {print $2; exit}')"
SHELL_QML="/etc/xdg/quickshell/caelestia/shell.qml"

if [[ ! -f "$SHELL_QML" ]]; then
    SHELL_QML="$(pacman -Ql caelestia-shell | awk '/\/shell\.qml$/ {print $2; exit}')"
fi

if [[ -z "$SHORTCUTS" || -z "$CONTENT" || -z "$SHELL_QML" || ! -f "$SHELL_QML" ]]; then
    warn "Could not locate required Caelestia QML files; skipping patches"
    exit 0
fi

info "Patching Caelestia fullscreen sidebar behavior and runtime environment"

sudo python - "$SHORTCUTS" "$CONTENT" "$SHELL_QML" <<'PY'
from pathlib import Path
import sys

shortcuts = Path(sys.argv[1])
content = Path(sys.argv[2])
shell_qml = Path(sys.argv[3])

# Read everything first. No package file is modified until every expected
# upstream/patched state has been recognized successfully.
s = shortcuts.read_text(encoding="utf-8")
c = content.read_text(encoding="utf-8")
q = shell_qml.read_text(encoding="utf-8")

old_sidebar = '''    CustomShortcut {
        // qmllint enable unresolved-type
        name: "sidebar"
        description: "Toggle sidebar"
        onPressed: {
            if (root.hasFullscreen)
                return;
            const screenState = ShellState.forActive();
            screenState.sidebar = !screenState.sidebar;
        }
    }'''
new_sidebar = '''    CustomShortcut {
        // qmllint enable unresolved-type
        name: "sidebar"
        description: "Toggle sidebar"
        onPressed: {
            const screenState = ShellState.forActive();
            screenState.sidebar = !screenState.sidebar;
        }
    }'''

if new_sidebar in s:
    sidebar_state = "already"
elif old_sidebar in s:
    sidebar_state = "needs"
else:
    raise SystemExit("Shortcuts.qml: expected sidebar block not found; refusing to modify anything")

old_mask = "mask: hasFullscreen ? emptyRegion : regions"
new_mask = "mask: hasFullscreen && !screenState.sidebar ? emptyRegion : regions"
if new_mask in c:
    mask_state = "already"
elif old_mask in c:
    mask_state = "needs"
else:
    raise SystemExit("ContentWindow.qml: expected fullscreen mask not found; refusing to modify anything")

env_names = (
    "QS_NO_RELOAD_POPUP",
    "QS_DROP_EXPENSIVE_FONTS",
    "QSG_RENDER_LOOP",
    "QT_QUICK_FLICKABLE_WHEEL_DECELERATION",
)
env_states = {}
missing = []
for name in env_names:
    old = f"//@ pragma DefaultEnv {name}="
    new = f"//@ pragma Env {name}="
    if new in q:
        env_states[name] = "already"
    elif old in q:
        env_states[name] = "needs"
    else:
        missing.append(name)

if missing:
    raise SystemExit(
        "shell.qml: expected environment pragmas not found: "
        + ", ".join(missing)
        + "; refusing to modify anything"
    )

# All preflight checks passed. Build the complete target contents in memory.
new_s = s.replace(old_sidebar, new_sidebar, 1) if sidebar_state == "needs" else s
new_c = c.replace(old_mask, new_mask, 1) if mask_state == "needs" else c
new_q = q
changed_env = []
for name, state in env_states.items():
    if state != "needs":
        continue
    old = f"//@ pragma DefaultEnv {name}="
    new = f"//@ pragma Env {name}="
    new_q = new_q.replace(old, new, 1)
    changed_env.append(name)

# Write only after the full package contract was validated.
if new_s != s:
    shortcuts.write_text(new_s, encoding="utf-8")
    print("Shortcuts.qml: patched")
else:
    print("Shortcuts.qml: already patched")

if new_c != c:
    content.write_text(new_c, encoding="utf-8")
    print("ContentWindow.qml: patched")
else:
    print("ContentWindow.qml: already patched")

if new_q != q:
    shell_qml.write_text(new_q, encoding="utf-8")
    print("shell.qml: Env patched: " + ", ".join(changed_env))
else:
    print("shell.qml: environment pragmas already patched")
PY

ok "Caelestia fullscreen/runtime patches applied"

NEXUS_STATE="$(pacman -Ql caelestia-shell | awk '/\/modules\/nexus\/NexusState\.qml$/ {print $2; exit}')"
NETWORK_LIST="$(pacman -Ql caelestia-shell | awk '/\/modules\/nexus\/common\/NetworkList\.qml$/ {print $2; exit}')"
ADD_NETWORK="$(pacman -Ql caelestia-shell | awk '/\/modules\/nexus\/pages\/network\/AddNetworkPage\.qml$/ {print $2; exit}')"
NETWORK_CONNECTION="$(pacman -Ql caelestia-shell | awk '/\/utils\/NetworkConnection\.qml$/ {print $2; exit}')"
NMCLI="$(pacman -Ql caelestia-shell | awk '/\/services\/Nmcli\.qml$/ {print $2; exit}')"

for file in "$NEXUS_STATE" "$NETWORK_LIST" "$ADD_NETWORK" "$NETWORK_CONNECTION" "$NMCLI"; do
    if [[ -z "$file" || ! -f "$file" ]]; then
        warn "Could not locate all Caelestia Wi-Fi QML files; skipping Wi-Fi patch"
        exit 0
    fi
done

info "Patching Caelestia Wi-Fi password flow and exact SSID handling"

sudo python - "$NEXUS_STATE" "$NETWORK_LIST" "$ADD_NETWORK" "$NETWORK_CONNECTION" "$NMCLI" <<'PY'
from pathlib import Path
import sys

nexus_state, network_list, add_network, network_connection, nmcli = map(Path, sys.argv[1:])
texts = {p: p.read_text(encoding="utf-8") for p in (nexus_state, network_list, add_network, network_connection, nmcli)}

def replace_known(path, old, new, label):
    text = texts[path]
    if new in text:
        print(f"{path.name}: {label} already patched")
        return
    if old not in text:
        raise SystemExit(f"{path.name}: expected upstream block for {label} not found; refusing Wi-Fi patch")
    if text.count(old) != 1:
        raise SystemExit(f"{path.name}: expected exactly one upstream block for {label}")
    texts[path] = text.replace(old, new, 1)
    print(f"{path.name}: {label} patched")

def migrate_live(path, old, new, label):
    text = texts[path]
    if old not in text:
        return
    if text.count(old) != 1:
        raise SystemExit(f"{path.name}: ambiguous live-host state for {label}")
    texts[path] = text.replace(old, new, 1)
    print(f"{path.name}: {label} migrated")

# Normalize the Wi-Fi variant proven interactively on the physical host before
# this patch became Blueprint-managed. This keeps targeted apply idempotent.
migrate_live(
    network_connection,
    '''        // For a secured network without a saved profile, ask for the password
        // before disconnecting the current network. This keeps connectivity alive
        // while the user enters credentials and avoids a pointless failed attempt.
''',
    '''        // Ask for credentials before disconnecting the current network.
''',
    "live credential-first comment",
)

migrate_live(
    nmcli,
    '''                // SSIDs may legally contain backslashes and leading/trailing spaces.
                // Preserve them exactly; nmcli escapes both ':' and '\\' in terse output.
''',
    '''                // SSIDs are byte-significant: preserve backslashes, case and whitespace.
''',
    "live exact-SSID parser comment",
)

migrate_live(
    nmcli,
    '''        // SSIDs are case-sensitive byte strings and spaces are significant.
        if (root.active && root.active.ssid === ssid)
''',
    '''        if (root.active && root.active.ssid === ssid)
''',
    "live exact-SSID match comment",
)

if 'property bool attempted: false' in texts[add_network]:
    migrate_live(
        add_network,
        '''    property bool attempted: false
    property string targetSsid: ""
''',
        '''    property bool attempted: false
    property string targetSsid: ""
    property string failureReason: ""
''',
        "live failure-reason state",
    )
    migrate_live(
        add_network,
        '''        // Never trim an SSID selected from scan results: leading/trailing spaces
        // are valid and are part of the network name.
        const ssid = root.targetSsid || ssidField.text;
''',
        '''        const ssid = root.targetSsid || ssidField.text;
''',
        "live exact-SSID submit comment",
    )
    migrate_live(
        add_network,
        '''        root.failed = false;
        root.connecting = true;
        root.attempted = true;
''',
        '''        root.failed = false;
        root.failureReason = "";
        root.connecting = true;
        root.attempted = true;
''',
        "live failure-reason reset",
    )
    migrate_live(
        add_network,
        '''            } else {
                root.failed = true;
                if (root.secured)
                    passwordField.isError = true;
                Nmcli.forgetNetwork(ssid);
            }
''',
        '''            } else {
                root.failed = true;
                const detail = (((result && result.error) || "") + " " + ((result && result.output) || "")).toLowerCase();
                if ((result && result.needsPassword) || detail.includes("secret") || detail.includes("password"))
                    root.failureReason = Tr.tr("Authentication failed — check the password");
                else if (detail.includes("ssid-not-found") || detail.includes("not found") || detail.includes("no network with ssid"))
                    root.failureReason = Tr.tr("Network not found — rescan and try again");
                else
                    root.failureReason = Tr.tr("Connection failed — try again");
                if (root.secured)
                    passwordField.isError = true;
                Nmcli.forgetNetwork(ssid);
            }
''',
        "live connection error classification",
    )
    migrate_live(
        add_network,
        '''        const target = root.targetSsid ? Nmcli.findNetwork(root.targetSsid) : null;
        if (target) {
            // Use the scanned access point (including its exact SSID and BSSID).
            NetworkConnection.connectWithPassword(target, passwordField.text, handleResult);
        } else {
            Nmcli.addHiddenNetwork(ssid, root.secured ? passwordField.text : "", root.secured ? "wpa" : "none", hiddenToggle.checked, handleResult);
        }
''',
        '''        const target = root.targetSsid ? Nmcli.findNetwork(root.targetSsid) : null;
        if (target)
            NetworkConnection.connectWithPassword(target, passwordField.text, handleResult);
        else
            Nmcli.addHiddenNetwork(ssid, root.secured ? passwordField.text : "", root.secured ? "wpa" : "none", hiddenToggle.checked, handleResult);
''',
        "live scanned-BSSID connect style",
    )

replace_known(nexus_state,
'''    property string selectedNetworkSsid
    property string selectedEthernetInterface
''',
'''    property string selectedNetworkSsid
    property string pendingNetworkSsid
    property string selectedEthernetInterface
''', "pending network state")

replace_known(network_list,
'''            if (!modelData.active) {
                NetworkConnection.handleConnect(modelData);
                currentSelected = true;
                root.networkSelected(modelData);
''',
'''            if (!modelData.active) {
                NetworkConnection.handleConnect(modelData, null, target => {
                    network.currentSelected = false;
                    root.nState.pendingNetworkSsid = target.ssid;
                    root.nState.openSubPage(2);
                });
                currentSelected = true;
                root.networkSelected(modelData);
''', "Nexus password prompt routing")

replace_known(network_connection,
'''        if (Nmcli.active && Nmcli.active.ssid !== network.ssid) {
            Nmcli.disconnectFromNetwork();
            Qt.callLater(() => {
                root.connectToNetwork(network, session, onPasswordNeeded);
            });
        } else {
            root.connectToNetwork(network, session, onPasswordNeeded);
        }
''',
'''        // Ask for credentials before disconnecting the current network.
        if (network.isSecure && !Nmcli.hasSavedProfile(network.ssid)) {
            if (session && session.network) {
                session.network.showPasswordDialog = true;
                session.network.pendingNetwork = network;
            } else if (onPasswordNeeded) {
                onPasswordNeeded(network);
            }
            return;
        }

        if (Nmcli.active && Nmcli.active.ssid !== network.ssid) {
            Nmcli.disconnectFromNetwork();
            Qt.callLater(() => {
                root.connectToNetwork(network, session, onPasswordNeeded);
            });
        } else {
            root.connectToNetwork(network, session, onPasswordNeeded);
        }
''', "credential-first connection flow")

replace_known(nmcli,
'''    function parseNetworkOutput(output: string): list<var> {
        if (!output || output.length === 0) {
            return [];
        }

        const PLACEHOLDER = "STRINGWHICHHOPEFULLYWONTBEUSED";
        const rep = new RegExp("\\\\:", "g");
        const rep2 = new RegExp(PLACEHOLDER, "g");

        const allNetworks = output.trim().split("\n").filter(line => line && line.length > 0).map(n => {
            const net = n.replace(rep, PLACEHOLDER).split(":");
            return {
                active: net[0] === "yes",
                strength: parseInt(net[1] || "0", 10) || 0,
                frequency: parseInt(net[2] || "0", 10) || 0,
                ssid: (net[3]?.replace(rep2, ":") ?? "").trim(),
                bssid: (net[4]?.replace(rep2, ":") ?? "").trim(),
                security: (net[5] ?? "").trim()
            };
        }).filter(n => n.ssid && n.ssid.length > 0);

        return allNetworks;
    }
''',
'''    function parseNmcliTerseLine(line: string): list<string> {
        const fields = [];
        let current = "";
        let escaped = false;

        for (let i = 0; i < line.length; i++) {
            const ch = line[i];
            if (escaped) {
                current += ch;
                escaped = false;
            } else if (ch === "\\") {
                escaped = true;
            } else if (ch === ":") {
                fields.push(current);
                current = "";
            } else {
                current += ch;
            }
        }

        if (escaped)
            current += "\\";

        fields.push(current);
        return fields;
    }

    function parseNetworkOutput(output: string): list<var> {
        if (!output || output.length === 0) {
            return [];
        }

        const allNetworks = output.split("\n").filter(line => line && line.length > 0).map(line => {
            const net = parseNmcliTerseLine(line);
            return {
                active: net[0] === "yes",
                strength: parseInt(net[1] || "0", 10) || 0,
                frequency: parseInt(net[2] || "0", 10) || 0,
                // SSIDs are byte-significant: preserve backslashes, case and whitespace.
                ssid: net[3] ?? "",
                bssid: (net[4] ?? "").trim(),
                security: (net[5] ?? "").trim()
            };
        }).filter(n => n.ssid && n.ssid.length > 0);

        return allNetworks;
    }
''', "nmcli escaped-field parser")

replace_known(nmcli,
