replace_known(add_network,
'''    function submit(): void {
        const ssid = ssidField.text.trim();
        if (ssid.length === 0) {
            ssidField.isError = true;
            ssidField.forceActiveFocus();
            return;
        }
        if (root.secured && passwordField.text.length < 8) {
            passwordField.isError = true;
            passwordField.forceActiveFocus();
            return;
        }

        root.failed = false;
        root.connecting = true;

        Nmcli.addHiddenNetwork(ssid, root.secured ? passwordField.text : "", root.secured ? "wpa" : "none", hiddenToggle.checked, result => {
            root.connecting = false;
            if (result && result.success) {
                root.success = true;
                root.nState.closeSubPage();
            } else {
                root.failed = true;
                if (root.secured)
                    passwordField.isError = true;
                // Clean up the half-created profile so a retry starts fresh.
                Nmcli.forgetNetwork(ssid);
            }
        });
    }
''',
'''    function submit(): void {
        const ssid = root.targetSsid || ssidField.text;
        if (ssid.length === 0) {
            ssidField.isError = true;
            ssidField.forceActiveFocus();
            return;
        }
        if (root.secured && passwordField.text.length < 8) {
            passwordField.isError = true;
            passwordField.forceActiveFocus();
            return;
        }

        root.failed = false;
        root.failureReason = "";
        root.connecting = true;
        root.attempted = true;

        const handleResult = result => {
            root.connecting = false;
            if (result && result.success) {
                root.success = true;
                root.nState.pendingNetworkSsid = "";
                root.nState.closeSubPage();
            } else {
                root.failed = true;
                const detail = (((result && result.error) || "") + " " + ((result && result.output) || "")).toLowerCase();
                if ((result && result.needsPassword) || detail.includes("secret") || detail.includes("password"))
                    root.failureReason = Tr.tr("Authentication failed — check the password");
                else if (detail.includes("ssid-not-found") || detail.includes("not found") || detail.includes("no network with ssid"))
                    root.failureReason = Tr.tr("Network not found — rescan and try again");
                else
                    root.failureReason = Tr.tr("Connection failed — try again");
                if (root.secured)
                    passwordField.isError = true;
                Nmcli.forgetNetwork(ssid);
            }
        };

        const target = root.targetSsid ? Nmcli.findNetwork(root.targetSsid) : null;
        if (target)
            NetworkConnection.connectWithPassword(target, passwordField.text, handleResult);
        else
            Nmcli.addHiddenNetwork(ssid, root.secured ? passwordField.text : "", root.secured ? "wpa" : "none", hiddenToggle.checked, handleResult);
    }
''', "exact-SSID connect flow")

