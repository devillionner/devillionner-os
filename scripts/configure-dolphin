#!/usr/bin/env bash
set -Eeuo pipefail

REPO="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
source "$REPO/scripts/lib/common.sh"

command -v dolphin >/dev/null 2>&1 || bp_die "Dolphin is not installed. Run the Blueprint restore or install the new common packages first."
command -v kwriteconfig6 >/dev/null 2>&1 || bp_die "kwriteconfig6 is required by Dolphin configuration"

mkdir -p \
    "$HOME/.config" \
    "$HOME/.local/state" \
    "$HOME/.config/caelestia" \
    "$HOME/.local/share/applications" \
    "$HOME/.local/share/dolphin/view_properties/global"
CONFIG_DIR="$(bp_config_dir)"
mkdir -p "$CONFIG_DIR"

"$REPO/scripts/configure-colloid-icons"
bash "$REPO/scripts/configure-caelestia-cli"

bp_info "Configuring Dolphin as the default file manager"

# Keep Darkly globally, but launch Dolphin through qtengine's widget style.
# This avoids the current Darkly/Dolphin selected+hover/focus rendering glitch
# without changing the appearance of other Qt applications.
sudo install -Dm755 \
    "$REPO/components/dolphin/devos-dolphin" \
    /usr/local/bin/devos-dolphin

# Keep the standalone configurator useful after an incremental git pull too.
# A full restore already rsyncs the canonical file, while an existing Caelestia
# installation may turn hypr-vars.lua into a symlink or add unrelated user
# overrides. Own only fileExplorer and preserve everything else.
python3 \
    "$REPO/scripts/lib/set-caelestia-file-explorer.py" \
    "$REPO/dotfiles/.config/caelestia/hypr-vars.lua" \
    "$HOME/.config/caelestia/hypr-vars.lua"

# Shadow Dolphin's system desktop file so application-menu launches and folder
# opens also use the Dolphin-only qtengine wrapper. Preserve upstream actions
# and metadata rather than maintaining a second hand-written desktop entry.
python3 - <<'PY'
from pathlib import Path

src = Path("/usr/share/applications/org.kde.dolphin.desktop")
dst = Path.home() / ".local/share/applications/org.kde.dolphin.desktop"
wrapper = "/usr/local/bin/devos-dolphin"

if src.exists():
    lines = src.read_text(encoding="utf-8").splitlines()
    out = []
    for line in lines:
        if line.startswith("Exec=dolphin"):
            line = "Exec=" + wrapper + line[len("Exec=dolphin"):]
        elif line.startswith("DBusActivatable="):
            line = "DBusActivatable=false"
        out.append(line)
    dst.write_text("\n".join(out) + "\n", encoding="utf-8")
else:
    dst.write_text(
        "[Desktop Entry]\n"
        "Type=Application\n"
        "Name=Dolphin\n"
        "GenericName=File Manager\n"
        "Icon=system-file-manager\n"
        f"Exec={wrapper} %U\n"
        "Terminal=false\n"
        "MimeType=inode/directory;\n"
        "Categories=Qt;KDE;System;FileTools;FileManager;\n",
        encoding="utf-8",
    )
PY

# Reproduce the tested local Dolphin/KDE settings without copying transient
# timestamps, machine-specific disk UUIDs or absolute home paths.
kwriteconfig6 --file dolphinrc --group KDE --key SingleClick false
kwriteconfig6 --file dolphinrc --group General --key GlobalViewProps true
kwriteconfig6 --file dolphinrc --group General --key EnlargeSmallPreviews true
kwriteconfig6 --file dolphinrc --group "KFileDialog Settings" --key "Places Icons Auto-resize" false
kwriteconfig6 --file dolphinrc --group "KFileDialog Settings" --key "Places Icons Static Size" 16
kwriteconfig6 --file dolphinrc --group MainWindow --key MenuBar Disabled
kwriteconfig6 --file dolphinrc --group PlacesPanel --key IconSize 16
python3 \
    "$REPO/scripts/lib/set-dolphin-global-view.py" \
    "$HOME/.local/share/dolphin/view_properties/global/.directory"
kwriteconfig6 --file kdeglobals --group KDE --key SingleClick false
kwriteconfig6 --file kdeglobals --group Icons --key Theme Colloid-Dark
kwriteconfig6 --file kiorc --group Confirmations --key ConfirmDelete true

# Caelestia cli.json (including Colloid-Dark) is owned centrally by
# configure-caelestia-cli. Dolphin only maintains its qtengine companion state
# here. Folder colour remains adaptive because the normal Colloid install is
# used (no --notint).
python3 - <<'PY'
import json
from pathlib import Path

home = Path.home()
qtengine = home / ".config/qtengine/config.json"
if qtengine.exists():
    try:
        qdata = json.loads(qtengine.read_text())
    except (json.JSONDecodeError, OSError):
        qdata = None
    if isinstance(qdata, dict):
        qtheme = qdata.setdefault("theme", {})
        if not isinstance(qtheme, dict):
            qtheme = {}
            qdata["theme"] = qtheme
        qtheme["style"] = "Darkly"
        qtheme["iconTheme"] = "Colloid-Dark"
        # This legacy duplicate disagreed with the tested host and could leave
        # stale Papirus/Colloid values competing with theme.iconTheme.
        qdata.pop("iconTheme", None)
        qtengine.write_text(json.dumps(qdata, indent=4, ensure_ascii=False) + "\n")
PY

if command -v dconf >/dev/null 2>&1; then
    dconf write /org/gnome/desktop/interface/icon-theme "'Colloid-Dark'" >/dev/null 2>&1 || true
fi

# Preserve unrelated browser/protocol associations. Only the associations that
# were present on the tested host are managed here.
python3 - <<'PY'
from configparser import RawConfigParser
from pathlib import Path

path = Path.home() / ".config/mimeapps.list"
cfg = RawConfigParser(interpolation=None, strict=False)
cfg.optionxform = str
if path.exists():
    cfg.read(path, encoding="utf-8")
if not cfg.has_section("Default Applications"):
    cfg.add_section("Default Applications")
defaults = {
    "inode/directory": "org.kde.dolphin.desktop",
    "image/jpeg": "swappy.desktop",
    "image/png": "swappy.desktop",
    "image/webp": "swappy.desktop",
}
for mime, desktop in defaults.items():
    cfg.set("Default Applications", mime, desktop)
with path.open("w", encoding="utf-8") as handle:
    cfg.write(handle, space_around_delimiters=False)
PY

# The Information panel is part of QMainWindow state rather than dolphinrc.
# On the first Blueprint configuration, create that state through Dolphin's
# own action API instead of committing a resolution-specific binary state blob.
LAYOUT_MARKER="$CONFIG_DIR/dolphin-information-panel"
if [[ ! -f "$LAYOUT_MARKER" ]]; then
    if command -v busctl >/dev/null 2>&1 && [[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ]]; then
        LOG="$(mktemp)"
        QT_QPA_PLATFORM=offscreen /usr/local/bin/devos-dolphin --new-window "$HOME" >"$LOG" 2>&1 &
        DOLPHIN_PID=$!
        SERVICE=""

        for _ in $(seq 1 60); do
            SERVICE="$(
                busctl --user list --no-legend 2>/dev/null |
                awk -v pid="$DOLPHIN_PID" '$1 ~ /^org\.kde\.dolphin/ && $2 == pid {print $1; exit}'
            )"
            [[ -n "$SERVICE" ]] && break
            kill -0 "$DOLPHIN_PID" 2>/dev/null || break
            sleep 0.1
        done

        if [[ -n "$SERVICE" ]] && busctl --user call \
            "$SERVICE" \
            /dolphin/Dolphin_1 \
            org.kde.KMainWindow \
            activateAction s show_information_panel >/dev/null 2>&1; then
            sleep 0.2
            busctl --user call \
                "$SERVICE" \
                /dolphin/Dolphin_1 \
                org.kde.KMainWindow \
                activateAction s file_quit >/dev/null 2>&1 || true

            for _ in $(seq 1 30); do
                kill -0 "$DOLPHIN_PID" 2>/dev/null || break
                sleep 0.1
            done

            if grep -q '^State=' "$HOME/.local/state/dolphinstaterc" 2>/dev/null; then
                touch "$LAYOUT_MARKER"
                bp_ok "Dolphin Information panel enabled"
            else
                bp_warn "Dolphin layout state was not saved; preview panel will be rechecked interactively"
            fi
        else
            bp_warn "Could not initialize Dolphin Information panel through D-Bus"
        fi

        kill "$DOLPHIN_PID" >/dev/null 2>&1 || true
        wait "$DOLPHIN_PID" 2>/dev/null || true
        rm -f "$LOG"
    else
        bp_warn "No user D-Bus session; Dolphin Information panel initialization deferred"
    fi
else
    bp_ok "Dolphin Information panel already initialized"
fi

bp_ok "Dolphin configured: Colloid-Dark, adaptive folders, previews, qtengine-only Dolphin style"
