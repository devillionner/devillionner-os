#!/usr/bin/env bash
set -u

REPO="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

OK=0; WARN=0; FAIL=0
ok() { printf '  [OK]   %s\n' "$*"; OK=$((OK + 1)); }
warn() { printf '  [WARN] %s\n' "$*"; WARN=$((WARN + 1)); }
fail() { printf '  [FAIL] %s\n' "$*"; FAIL=$((FAIL + 1)); }

printf '========================================\n'
printf '       Caelestia shell check\n'
printf '========================================\n'

SHELL_JSON="$HOME/.config/caelestia/shell.json"

if [[ -f "$SHELL_JSON" ]]; then
    ok "shell.json exists"
else
    fail "shell.json missing"
fi

if python3 - "$SHELL_JSON" <<'PY' >/dev/null 2>&1
import json
import sys
from pathlib import Path

p = Path(sys.argv[1])
data = json.loads(p.read_text(encoding="utf-8"))

assert data["appearance"]["transparency"]["enabled"] is True
assert data["dashboard"]["enabled"] is True
assert data["dashboard"]["showDashboard"] is True
assert data["dashboard"]["showOnHover"] is True

general = data["general"]
assert general["logo"] == "caelestia"
assert general["showOverFullscreen"] is True
assert general["apps"]["explorer"] == ["dolphin"]
assert general["apps"]["playback"] == ["clapper"]
assert general["apps"]["terminal"] == ["kitty"]

idle = general["idle"]
assert idle["lockBeforeSleep"] is True
assert idle["inhibitWhenAudio"] is True
assert idle["inhibitWhenCharging"] is False
assert idle["timeouts"] == [
    {"timeout": 1800, "idleAction": "lock"},
    {"timeout": 2100, "idleAction": "dpms off", "returnAction": "dpms on"},
    {"timeout": 3600, "idleAction": ["suspendThenHibernate"]},
]

assert data["services"]["brightnessIncrement"] == 0.05
assert data["services"]["defaultPlayer"] == "Spotify"
assert data["utilities"]["toasts"]["nowPlaying"] is False
assert data["utilities"]["toasts"]["fullscreen"] == "all"
PY
then
    ok "managed Caelestia shell settings match Blueprint"
else
    fail "shell.json is invalid or managed values differ"
fi

BRANDING_DRIFT=0
for pkg in cachyos-hello cachyos-packageinstaller cachyos-wallpapers; do
    if pacman -Qq "$pkg" >/dev/null 2>&1; then
        printf '         redundant branded package: %s\n' "$pkg"
        BRANDING_DRIFT=$((BRANDING_DRIFT + 1))
    fi
done
((BRANDING_DRIFT == 0)) \
    && ok "pure CachyOS desktop branding packages absent" \
    || fail "$BRANDING_DRIFT pure CachyOS desktop branding package(s) installed"

UPDATE_TIMER_STATE="$(systemctl --user is-enabled arch-update.timer 2>/dev/null || true)"
case "$UPDATE_TIMER_STATE" in
    masked|not-found|"") ok "Cachy-Update background timer suppressed" ;;
    *) fail "Cachy-Update background timer is $UPDATE_TIMER_STATE" ;;
esac

if pgrep -f "^/usr/lib/arch-update/arch-update-tray$" >/dev/null 2>&1; then
    fail "Cachy-Update tray process is running"
else
    ok "Cachy-Update tray process absent"
fi

if grep -Fq 'Hidden=true' "$HOME/.config/autostart/arch-update-tray.desktop" 2>/dev/null; then
    ok "system Cachy-Update autostart is user-overridden"
else
    fail "Cachy-Update autostart override missing"
fi

if [[ -f /usr/share/applications/arch-update.desktop ]] \
    && [[ ! -e "$HOME/.local/share/applications/arch-update.desktop" ]]; then
    ok "manual Cachy-Update launcher available"
else
    fail "manual Cachy-Update launcher is missing or user-hidden"
fi

HIDDEN_LAUNCHERS=0
for desktop in \
    arch-update-tray.desktop \
    cachyos-hello.desktop \
    cachyos-pi.desktop \
    org.cachyos.KernelManager.desktop
do
    grep -Fq 'Hidden=true' "$HOME/.local/share/applications/$desktop" 2>/dev/null \
        || HIDDEN_LAUNCHERS=$((HIDDEN_LAUNCHERS + 1))
done
((HIDDEN_LAUNCHERS == 0)) \
    && ok "background/branding-only CachyOS launcher entries hidden" \
    || fail "$HIDDEN_LAUNCHERS background/branding launcher override(s) missing"

if command -v caelestia >/dev/null 2>&1; then
    ok "caelestia CLI available"
else
    warn "caelestia CLI not found in PATH"
fi

printf '\n'
if bash "$REPO/scripts/check-caelestia-patches"; then
    ok "installed Caelestia package patches match Blueprint"
else
    fail "installed Caelestia package patches differ or upstream changed"
fi

printf '\n========================================\n'
printf 'Caelestia summary: OK: %d   WARN: %d   FAIL: %d\n' "$OK" "$WARN" "$FAIL"
if ((FAIL == 0)); then
    printf 'RESULT: PASS\n'
    exit 0
fi
printf 'RESULT: FAIL\n'
exit 1
