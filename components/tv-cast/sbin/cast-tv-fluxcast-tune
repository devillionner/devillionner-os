#!/usr/bin/env python3
"""Re-apply the tested FluxCast low-latency settings after package upgrades.

The patch is deliberately conservative: only known upstream patterns are
rewritten. If FluxCast changes its command construction, emit a warning and
leave the unknown section untouched instead of guessing.
"""

from pathlib import Path
import re
import sys

path = Path("/opt/fluxcast/wfd/media/wlroots.py")

if not path.exists():
    print(f"TV Cast: FluxCast media file not found: {path}", file=sys.stderr)
    raise SystemExit(0)

text = path.read_text(encoding="utf-8")
updated = text
warnings: list[str] = []

queue_tuned = re.search(r'"-thread_queue_size"\s*,\s*"32"', updated)
queue_old = re.search(r'"-thread_queue_size"\s*,\s*"1024"', updated)

if queue_old:
    updated = re.sub(
        r'("-thread_queue_size"\s*,\s*)"1024"',
        r'\g<1>"32"',
        updated,
    )
elif not queue_tuned:
    warnings.append(
        "thread_queue_size pattern changed; expected 1024 or already-tuned 32"
    )

preset_tuned = re.search(r'"-preset"\s*,\s*"ultrafast"\s*,', updated)
preset_old_pattern = (
    r'("-preset"\s*,\s*)"ultrafast"\s+if\s+parsed_out\[1\]\s*>\s*1080'
    r'\s+else\s+"veryfast"'
)

if re.search(preset_old_pattern, updated):
    updated = re.sub(preset_old_pattern, r'\g<1>"ultrafast"', updated)
elif not preset_tuned:
    warnings.append(
        "x264 preset pattern changed; expected conditional ultrafast/veryfast "
        "or already-tuned ultrafast"
    )

if updated != text:
    path.write_text(updated, encoding="utf-8")
    print("TV Cast: applied FluxCast low-latency tuning")

for warning in warnings:
    print(f"TV Cast WARNING: {warning}", file=sys.stderr)

# Warnings intentionally do not fail pacman transactions.
raise SystemExit(0)
