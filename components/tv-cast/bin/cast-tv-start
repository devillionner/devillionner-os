#!/usr/bin/env bash

MODE="${1:-30}"

case "$MODE" in
    30|60|low) ;;
    *) exit 1 ;;
esac

SESSION="cast-tv"
RUNTIME="${XDG_RUNTIME_DIR:-/tmp}"
STATE="$RUNTIME/cast-tv-was-muted"
PROFILE="$RUNTIME/cast-tv-profile"
SWITCH="$RUNTIME/cast-tv-switching"

# Якщо старої сесії немає — прибираємо можливий stale state.
if ! tmux has-session -t "$SESSION" 2>/dev/null; then
    rm -f "$SWITCH" "$PROFILE"

    if [ -f "$STATE" ]; then
        if [ "$(cat "$STATE")" = "0" ]; then
            wpctl set-mute @DEFAULT_AUDIO_SINK@ 0 >/dev/null 2>&1 || true
        fi
        rm -f "$STATE"
    fi
fi

# Якщо щось вже працює — гарантовано завершуємо перед новим режимом.
if tmux has-session -t "$SESSION" 2>/dev/null; then
    touch "$SWITCH"

    /usr/local/bin/cast-tv-stop --switch >/dev/null 2>&1 || true

    for _ in $(seq 1 40); do
        tmux has-session -t "$SESSION" 2>/dev/null || break
        sleep 0.1
    done
fi

echo "$MODE" > "$PROFILE"

tmux new-session -d \
    -s "$SESSION" \
    "/usr/local/lib/cast-tv-worker $MODE"

rm -f "$SWITCH"
