#!/usr/bin/env bash
source /usr/local/lib/cast-tv-i18n

MODE="$1"

case "$MODE" in
    30) MODE_LABEL="$TXT_30" ;;
    60) MODE_LABEL="$TXT_60" ;;
    low) MODE_LABEL="$TXT_LOW" ;;
    *) exit 1 ;;
esac

for _ in $(seq 1 240); do
    INFO=$(/usr/local/bin/cast-tv-status 2>/dev/null || echo "off|")

    STATE="${INFO%%|*}"
    CURRENT_MODE="${INFO#*|}"

    if [ "$STATE" = "connected" ] && [ "$CURRENT_MODE" = "$MODE" ]; then
        notify-send \
            --app-name="TV Cast" \
            --icon=video-display \
            "TV Cast" \
            "$TXT_CONNECTED_NOTIFICATION • $MODE_LABEL"
        exit 0
    fi

    [ "$STATE" = "off" ] && exit 0

    if [ -n "$CURRENT_MODE" ] && [ "$CURRENT_MODE" != "$MODE" ]; then
        exit 0
    fi

    sleep 0.25
done
