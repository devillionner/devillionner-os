#!/usr/bin/env bash
set -Eeuo pipefail

PIN="3f55a3702bd6d87799dc97023e0fe2b11d88c704"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
THEME_DIR="$CONFIG_HOME/spicetify/Themes/devillionner-sleek"
REVISION="$THEME_DIR/upstream-revision"
BASE="$THEME_DIR/upstream-theme"
CSS="$THEME_DIR/user.css"
URL="https://raw.githubusercontent.com/spicetify/spicetify-themes/$PIN/Sleek/user.css"

mkdir -p "$THEME_DIR"
command -v curl >/dev/null 2>&1 || {
    printf 'devos-spotify: curl is required to bootstrap Sleek\n' >&2
    exit 1
}

if [[ -f "$CSS" \
    && -f "$REVISION" \
    && -f "$BASE" \
    && "$(cat "$REVISION")" == "$PIN" \
    && "$(cat "$BASE")" == "Sleek" ]]; then
    exit 0
fi

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

# Keep the community theme itself untouched. Blueprint owns only the pin and
# the generated Caelestia color.ini; it no longer patches Spotify pane geometry.
curl -fsSL "$URL" -o "$tmp"
[[ -s "$tmp" ]] || {
    printf 'devos-spotify: downloaded Sleek CSS is empty\n' >&2
    exit 1
}

install -m644 "$tmp" "$CSS"
printf '%s\n' "$PIN" > "$REVISION"
printf '%s\n' "Sleek" > "$BASE"

# Retire the old Blueprint-patched text-theme cache only after the replacement
# has been built successfully. This path was fully Blueprint-owned.
rm -rf "$CONFIG_HOME/spicetify/Themes/devillionner-text"
rm -f "$CONFIG_HOME/spicetify/devillionner-overrides.css"
