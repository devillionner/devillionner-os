#!/usr/bin/env bash
set -Eeuo pipefail

PIN="654cfed682b94613b0029997ffafc1eadccc5bef"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
THEME_DIR="$CONFIG_HOME/spicetify/Themes/devillionner-bloom"
REVISION="$THEME_DIR/upstream-revision"
BASE="$THEME_DIR/upstream-theme"
CSS="$THEME_DIR/user.css"
JS="$THEME_DIR/theme.js"
BASE_URL="https://raw.githubusercontent.com/nimsandu/spicetify-bloom/$PIN/src"

mkdir -p "$THEME_DIR"
command -v curl >/dev/null 2>&1 || {
    printf 'devos-spotify: curl is required to bootstrap Bloom\n' >&2
    exit 1
}

if [[ -f "$CSS" \
    && -f "$JS" \
    && -f "$REVISION" \
    && -f "$BASE" \
    && "$(cat "$REVISION")" == "$PIN" \
    && "$(cat "$BASE")" == "Bloom" ]]; then
    exit 0
fi

tmp_css="$(mktemp)"
tmp_js="$(mktemp)"
trap 'rm -f "$tmp_css" "$tmp_js"' EXIT

# Keep Bloom's visual implementation intact. Blueprint owns only the pinned
# upstream revision and the generated adaptive color.ini; no pane geometry is
# patched locally anymore.
curl -fsSL "$BASE_URL/user.css" -o "$tmp_css"
curl -fsSL "$BASE_URL/theme.js" -o "$tmp_js"
[[ -s "$tmp_css" && -s "$tmp_js" ]] || {
    printf 'devos-spotify: downloaded Bloom theme is incomplete\n' >&2
    exit 1
}

install -m644 "$tmp_css" "$CSS"
install -m644 "$tmp_js" "$JS"
printf '%s\n' "$PIN" > "$REVISION"
printf '%s\n' "Bloom" > "$BASE"

# Retire previous Blueprint-owned theme experiments only after Bloom has been
# built successfully. User-installed Marketplace/community themes are untouched.
rm -rf \
    "$CONFIG_HOME/spicetify/Themes/devillionner-text" \
    "$CONFIG_HOME/spicetify/Themes/devillionner-sleek"
rm -f "$CONFIG_HOME/spicetify/devillionner-overrides.css"
