#!/usr/bin/env bash
set -euo pipefail

# Keep the BitTorrent backend independent from the Fragments UI. The UI may be
# closed normally; Transmission and the Caelestia tray continue in user services.
systemctl --user start devos-fragments-daemon.service devos-fragments-tray.service >/dev/null 2>&1 || true

exec /usr/bin/fragments "$@"
