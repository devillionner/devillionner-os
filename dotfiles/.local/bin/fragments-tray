#!/usr/bin/env python3
import os
import re
import signal
import subprocess

import dbus
import dbus.service
from dbus.mainloop.glib import DBusGMainLoop
from gi.repository import GLib

SNI_IFACE = "org.kde.StatusNotifierItem"
MENU_IFACE = "com.canonical.dbusmenu"
SNI_PATH = "/StatusNotifierItem"
MENU_PATH = "/Menu"
BUS_NAME = "org.kde.StatusNotifierItem.Fragments"
WATCHER = "org.kde.StatusNotifierWatcher"

def run_quiet(*args):
    subprocess.Popen(
        list(args),
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True,
    )

def transmission_info():
    env = dict(os.environ)
    env["LC_ALL"] = "C"
    try:
        out = subprocess.run(
            ["transmission-remote", "127.0.0.1:9091", "-t", "all", "-i"],
            env=env,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            timeout=2,
            check=False,
        ).stdout
    except Exception:
        return []

    torrents = []
    current = None
    for line in out.splitlines():
        m = re.match(r"^  Id: (\d+)$", line)
        if m:
            if current:
                torrents.append(current)
            current = {"id": int(m.group(1))}
            continue
        if not current:
            continue

        for key, prefix in (
            ("name", "  Name: "),
            ("state", "  State: "),
            ("progress", "  Percent Done: "),
            ("down", "  Download Speed: "),
            ("up", "  Upload Speed: "),
            ("location", "  Location: "),
        ):
            if line.startswith(prefix):
                current[key] = line[len(prefix):].strip()
                break

    if current:
        torrents.append(current)
    return torrents

def torrent_label(t):
    name = t.get("name", f"Torrent {t.get('id', '?')}")
    state = t.get("state", "")
    progress = t.get("progress", "?")
    down = t.get("down", "0 B/s")

    try:
        pct = float(progress.rstrip("%"))
    except Exception:
        pct = 0.0

    if pct >= 100:
        icon = "✓"
    elif "Verifying" in state:
        icon = "◌"
    elif state in ("Up & Down", "Downloading") or "Down" in state:
        icon = "↓"
    elif state in ("Seeding", "Uploading"):
        icon = "↑"
    elif state == "Stopped":
        icon = "⏸"
    else:
        icon = "•"

    progress_text = f"{pct:.0f}%" if pct == round(pct) else f"{pct:.1f}%"
    parts = [f"{icon} {name}", progress_text]
    if down not in ("0 B/s", "0.0 kB/s", "0.0 MB/s") and pct < 100:
        parts.append(down)
    return " · ".join(parts)

class FragmentsMenu(dbus.service.Object):
    def __init__(self, bus_name):
        super().__init__(bus_name, MENU_PATH)
        self.revision = 1
        self.torrents = transmission_info()

    def refresh(self):
        latest = transmission_info()
        if latest != self.torrents:
            self.torrents = latest
            self.revision += 1
            return True
        return False

    def torrent_for_item(self, item_id):
        if 1000 <= item_id < 2000:
            tid = item_id - 1000
            return next((t for t in self.torrents if t.get("id") == tid), None)
        return None

    def item_props(self, item_id):
        item_id = int(item_id)

        props = {
            0: {"children-display": dbus.String("submenu", variant_level=1)},
            1: {"label": dbus.String("Open Fragments", variant_level=1)},
            10: {
                "label": dbus.String(f"Torrents ({len(self.torrents)})", variant_level=1),
                "children-display": dbus.String("submenu", variant_level=1),
            },
            2: {
                "type": dbus.String("separator", variant_level=1),
                "enabled": dbus.Boolean(True, variant_level=1),
            },
            3: {"label": dbus.String("Pause all", variant_level=1)},
            4: {"label": dbus.String("Resume all", variant_level=1)},
            5: {
                "type": dbus.String("separator", variant_level=1),
                "enabled": dbus.Boolean(True, variant_level=1),
            },
            6: {"label": dbus.String("Stop torrent service", variant_level=1)},
        }

        torrent = self.torrent_for_item(item_id)
        if torrent:
            props[item_id] = {
                "label": dbus.String(torrent_label(torrent), variant_level=1),
                "enabled": dbus.Boolean(True, variant_level=1),
            }

        if item_id == 11 and not self.torrents:
            props[item_id] = {
                "label": dbus.String("No torrents", variant_level=1),
                "enabled": dbus.Boolean(False, variant_level=1),
            }

        return dbus.Dictionary(props.get(item_id, {}), signature="sv")

    def child_ids(self, item_id):
        item_id = int(item_id)
        if item_id == 0:
            return [1, 10, 2, 3, 4, 5, 6]
        if item_id == 10:
            return [1000 + t["id"] for t in self.torrents] or [11]
        return []

    def node(self, item_id, depth):
        item_id = int(item_id)
        children = dbus.Array([], signature="v")
        if depth != 0:
            next_depth = depth - 1 if depth > 0 else depth
            for child_id in self.child_ids(item_id):
                child = self.node(child_id, next_depth)
                children.append(dbus.Struct(child, variant_level=1))
        return dbus.Struct((dbus.Int32(item_id), self.item_props(item_id), children))

    @dbus.service.method(MENU_IFACE, in_signature="iias", out_signature="u(ia{sv}av)")
    def GetLayout(self, parent_id, recursion_depth, property_names):
        self.refresh()
        return dbus.UInt32(self.revision), self.node(parent_id, int(recursion_depth))

    @dbus.service.method(MENU_IFACE, in_signature="aias", out_signature="a(ia{sv})")
    def GetGroupProperties(self, ids, property_names):
        self.refresh()
        return dbus.Array(
            [dbus.Struct((dbus.Int32(i), self.item_props(i))) for i in ids],
            signature="(ia{sv})",
        )

    @dbus.service.method(MENU_IFACE, in_signature="is", out_signature="v")
    def GetProperty(self, item_id, name):
        self.refresh()
        props = self.item_props(item_id)
        return props.get(name, dbus.String("", variant_level=1))

    def handle_click(self, item_id):
        item_id = int(item_id)
        if item_id == 1 or 1000 <= item_id < 2000:
            run_quiet(os.path.expanduser("~/.local/bin/fragments-caelestia"))
        elif item_id == 3:
            run_quiet("transmission-remote", "127.0.0.1:9091", "-t", "all", "-S")
        elif item_id == 4:
            run_quiet("transmission-remote", "127.0.0.1:9091", "-t", "all", "-s")
        elif item_id == 6:
            run_quiet(
                "sh",
                "-lc",
                "pkill -TERM -x fragments 2>/dev/null || true; "
                "systemctl --user stop devos-fragments-daemon.service devos-fragments-tray.service",
            )

    @dbus.service.method(MENU_IFACE, in_signature="isvu", out_signature="")
    def Event(self, item_id, event_id, data, timestamp):
        if str(event_id) == "clicked":
            self.handle_click(item_id)

    @dbus.service.method(MENU_IFACE, in_signature="a(isvu)", out_signature="ai")
    def EventGroup(self, events):
        for item_id, event_id, data, timestamp in events:
            if str(event_id) == "clicked":
                self.handle_click(item_id)
        return dbus.Array([], signature="i")

    @dbus.service.method(MENU_IFACE, in_signature="i", out_signature="b")
    def AboutToShow(self, item_id):
        changed = self.refresh()
        if changed:
            self.LayoutUpdated(dbus.UInt32(self.revision), dbus.Int32(int(item_id)))
        return dbus.Boolean(changed)

    @dbus.service.method(MENU_IFACE, in_signature="ai", out_signature="aiai")
    def AboutToShowGroup(self, ids):
        changed = self.refresh()
        if changed:
            for item_id in ids:
                self.LayoutUpdated(dbus.UInt32(self.revision), dbus.Int32(int(item_id)))
        return dbus.Array([], signature="i"), dbus.Array([], signature="i")

    @dbus.service.method(dbus.PROPERTIES_IFACE, in_signature="ss", out_signature="v")
    def Get(self, interface, prop):
        if interface != MENU_IFACE:
            raise dbus.exceptions.DBusException("org.freedesktop.DBus.Error.InvalidArgs", "Unknown interface")
        values = {
            "Version": dbus.UInt32(3, variant_level=1),
            "TextDirection": dbus.String("ltr", variant_level=1),
            "Status": dbus.String("normal", variant_level=1),
            "IconThemePath": dbus.Array([], signature="s", variant_level=1),
        }
        if prop not in values:
            raise dbus.exceptions.DBusException("org.freedesktop.DBus.Error.InvalidArgs", "Unknown property")
        return values[prop]

    @dbus.service.method(dbus.PROPERTIES_IFACE, in_signature="s", out_signature="a{sv}")
    def GetAll(self, interface):
        if interface != MENU_IFACE:
            return {}
        return {
            "Version": dbus.UInt32(3, variant_level=1),
            "TextDirection": dbus.String("ltr", variant_level=1),
            "Status": dbus.String("normal", variant_level=1),
            "IconThemePath": dbus.Array([], signature="s", variant_level=1),
        }

    @dbus.service.method(dbus.PROPERTIES_IFACE, in_signature="ssv", out_signature="")
    def Set(self, interface, prop, value):
        raise dbus.exceptions.DBusException("org.freedesktop.DBus.Error.PropertyReadOnly", "Read-only")

    @dbus.service.signal(MENU_IFACE, signature="ui")
    def LayoutUpdated(self, revision, parent):
        pass

    @dbus.service.signal(MENU_IFACE, signature="a(ia{sv})a(ias)")
    def ItemsPropertiesUpdated(self, updated, removed):
        pass

    @dbus.service.signal(MENU_IFACE, signature="iu")
    def ItemActivationRequested(self, item_id, timestamp):
        pass

class FragmentsTray(dbus.service.Object):
    def __init__(self, bus):
        self.bus_name = dbus.service.BusName(BUS_NAME, bus=bus, allow_replacement=True, replace_existing=True)
        super().__init__(self.bus_name, SNI_PATH)
        self.menu = FragmentsMenu(self.bus_name)

    def props(self):
        return {
            "Category": dbus.String("ApplicationStatus"),
            "Id": dbus.String("fragments"),
            "Title": dbus.String("Fragments"),
            "Status": dbus.String("Active"),
            "WindowId": dbus.UInt32(0),
            "IconName": dbus.String("de.haeckerfelix.Fragments"),
            "IconThemePath": dbus.String(""),
            "AttentionIconName": dbus.String("de.haeckerfelix.Fragments"),
            "OverlayIconName": dbus.String(""),
            "ItemIsMenu": dbus.Boolean(False),
            "Menu": dbus.ObjectPath(MENU_PATH),
            "ToolTip": dbus.Struct((
                dbus.String("de.haeckerfelix.Fragments"),
                dbus.Array([], signature="(iiay)"),
                dbus.String("Fragments"),
                dbus.String(""),
            )),
        }

    @dbus.service.method(dbus.PROPERTIES_IFACE, in_signature="ss", out_signature="v")
    def Get(self, interface, prop):
        if interface != SNI_IFACE:
            raise dbus.exceptions.DBusException("org.freedesktop.DBus.Error.InvalidArgs", "Unknown interface")
        props = self.props()
        if prop not in props:
            raise dbus.exceptions.DBusException("org.freedesktop.DBus.Error.InvalidArgs", "Unknown property")
        return props[prop]

    @dbus.service.method(dbus.PROPERTIES_IFACE, in_signature="s", out_signature="a{sv}")
    def GetAll(self, interface):
        return self.props() if interface == SNI_IFACE else {}

    @dbus.service.method(dbus.PROPERTIES_IFACE, in_signature="ssv", out_signature="")
    def Set(self, interface, prop, value):
        raise dbus.exceptions.DBusException("org.freedesktop.DBus.Error.PropertyReadOnly", "Read-only")

    def show(self):
        run_quiet(os.path.expanduser("~/.local/bin/fragments-caelestia"))

    @dbus.service.method(SNI_IFACE, in_signature="ii", out_signature="")
    def Activate(self, x, y):
        self.show()

    @dbus.service.method(SNI_IFACE, in_signature="ii", out_signature="")
    def SecondaryActivate(self, x, y):
        self.show()

    @dbus.service.method(SNI_IFACE, in_signature="ii", out_signature="")
    def ContextMenu(self, x, y):
        pass

    @dbus.service.method(SNI_IFACE, in_signature="is", out_signature="")
    def Scroll(self, delta, orientation):
        pass

    @dbus.service.signal(SNI_IFACE, signature="")
    def NewIcon(self):
        pass

    @dbus.service.signal(SNI_IFACE, signature="s")
    def NewStatus(self, status):
        pass

    @dbus.service.signal(SNI_IFACE, signature="")
    def NewToolTip(self):
        pass

def main():
    DBusGMainLoop(set_as_default=True)
    bus = dbus.SessionBus()
    item = FragmentsTray(bus)
    loop = GLib.MainLoop()

    def register():
        try:
            watcher = bus.get_object(WATCHER, "/StatusNotifierWatcher")
            dbus.Interface(watcher, WATCHER).RegisterStatusNotifierItem(BUS_NAME)
        except Exception:
            pass
        return False

    def watcher_changed(name, old_owner, new_owner):
        if name == WATCHER and new_owner:
            GLib.timeout_add(250, register)

    bus.add_signal_receiver(
        watcher_changed,
        dbus_interface="org.freedesktop.DBus",
        signal_name="NameOwnerChanged",
        arg0=WATCHER,
    )

    register()

    signal.signal(signal.SIGTERM, lambda *_: loop.quit())
    signal.signal(signal.SIGINT, lambda *_: loop.quit())
    loop.run()

if __name__ == "__main__":
    main()
