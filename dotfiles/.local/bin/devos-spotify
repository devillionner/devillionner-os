#!/usr/bin/env bash
set -u

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
SPOTIFY_ROOT="$DATA_HOME/spotify-launcher/install/usr/share/spotify"
PREFS="$CONFIG_HOME/spotify/prefs"
LOG_DIR="$STATE_HOME/devillionner-os"
LOG="$LOG_DIR/spotify.log"
LOCK="$LOG_DIR/spotify-wrapper.lock"
SPOTIFY_URI="${1:-}"
mkdir -p "$LOG_DIR"

notify() {
    command -v notify-send >/dev/null 2>&1 && notify-send "Spotify" "$1" >/dev/null 2>&1 || true
}

if [[ -n "$SPOTIFY_URI" && "$SPOTIFY_URI" != spotify:* ]]; then
    notify "Ignoring unsupported launch target; only spotify: links are accepted"
    SPOTIFY_URI=""
fi
if (($# > 1)); then
    notify "Spotify accepts one link at a time; opening the first link only"
fi

if ! command -v spotify-launcher >/dev/null 2>&1; then
    notify "spotify-launcher is not installed"
    exit 127
fi

launch_vanilla() {
    if [[ -n "$SPOTIFY_URI" ]]; then
        exec spotify-launcher --skip-update "$SPOTIFY_URI"
    fi
    exec spotify-launcher --skip-update
}

open_spotify_uri() {
    [[ -n "$SPOTIFY_URI" ]] || return 0
    command -v busctl >/dev/null 2>&1 || return 1

    local _
    for _ in $(seq 1 80); do
        if busctl --user call \
            org.mpris.MediaPlayer2.spotify \
            /org/mpris/MediaPlayer2 \
            org.mpris.MediaPlayer2.Player \
            OpenUri s "$SPOTIFY_URI" >>"$LOG" 2>&1; then
            return 0
        fi
        sleep 0.1
    done
    return 1
}

if [[ -n "$SPOTIFY_URI" ]] && pgrep -x spotify >/dev/null 2>&1; then
    if open_spotify_uri; then
        exit 0
    fi
    launch_vanilla
fi

if command -v flock >/dev/null 2>&1; then
    exec 9>"$LOCK"
    if ! flock -n 9; then
        if [[ -n "$SPOTIFY_URI" ]] && open_spotify_uri; then
            exit 0
        fi
        exit 0
    fi
else
    notify "flock is unavailable; Spotify single-instance guard is disabled"
fi

if pgrep -x spotify >/dev/null 2>&1; then
    if [[ -n "$SPOTIFY_URI" ]]; then
        open_spotify_uri || launch_vanilla
    fi
    exit 0
fi

spotify-launcher --no-exec >>"$LOG" 2>&1 || true

if ! "$HOME/.local/bin/devos-spotify-theme-bootstrap" >>"$LOG" 2>&1; then
    notify "Bloom theme bootstrap failed; opening Spotify without it"
    launch_vanilla
fi
"$HOME/.local/bin/devos-spotify-theme-sync" >>"$LOG" 2>&1 || true

if [[ ! -f "$PREFS" ]]; then
    notify "First launch: sign in and leave Spotify open about a minute, then reopen it for the adaptive theme"
    launch_vanilla
fi

if ! command -v spicetify >/dev/null 2>&1 || [[ ! -d "$SPOTIFY_ROOT" ]]; then
    notify "Spicetify is not ready; opening Spotify normally"
    launch_vanilla
fi

spicetify config \
    spotify_path "$SPOTIFY_ROOT" \
    prefs_path "$PREFS" \
    current_theme devillionner-bloom \
    color_scheme Devillionner \
    inject_css 1 \
    replace_colors 1 \
    overwrite_assets 1 \
    inject_theme_js 1 \
    spotify_launch_flags '--remote-debugging-port=9222|--remote-allow-origins=*' \
    >>"$LOG" 2>&1 || {
        notify "Spicetify configuration failed; opening Spotify normally"
        launch_vanilla
    }

if ! spicetify -q auto >>"$LOG" 2>&1; then
    notify "Spicetify apply failed; opening Spotify normally"
    launch_vanilla
fi

for _ in $(seq 1 100); do
    pgrep -x spotify >/dev/null 2>&1 && break
    sleep 0.1
done

if ! pgrep -x spotify >/dev/null 2>&1; then
    exit 0
fi

if [[ -n "$SPOTIFY_URI" ]] && ! open_spotify_uri; then
    spotify-launcher --skip-update "$SPOTIFY_URI" >>"$LOG" 2>&1 &
fi

for _ in $(seq 1 80); do
    curl -fsS http://127.0.0.1:9222/json/version >/dev/null 2>&1 && break
    sleep 0.1
done

spicetify watch -s >>"$LOG" 2>&1 &
watch_pid=$!
cleanup() {
    kill "$watch_pid" >/dev/null 2>&1 || true
    wait "$watch_pid" >/dev/null 2>&1 || true
}
trap cleanup EXIT INT TERM

while pgrep -x spotify >/dev/null 2>&1; do
    sleep 2
done
