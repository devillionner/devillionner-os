{
    "appearance": {
        "transparency": {
            "enabled": true
        }
    },
    "dashboard": {
        "enabled": true,
        "showDashboard": true,
        "showOnHover": true
    },
    "general": {
        "idle": {
            "lockBeforeSleep": true,
            "inhibitWhenAudio": true,
            "inhibitWhenCharging": false,
            "timeouts": [
                {
                    "timeout": 1800,
                    "idleAction": "lock"
                },
                {
                    "timeout": 2100,
                    "idleAction": "dpms off",
                    "returnAction": "dpms on"
                },
                {
                    "timeout": 3600,
                    "idleAction": [
                        "suspendThenHibernate"
                    ]
                }
            ]
        },
        "apps": {
            "explorer": [
                "dolphin"
            ],
            "playback": [
                "clapper"
            ],
            "terminal": [
                "kitty"
            ]
        },
        "showOverFullscreen": true
    },
    "services": {
        "brightnessIncrement": 0.05,
        "defaultPlayer": "Spotify"
    },
    "utilities": {
        "toasts": {
            "nowPlaying": false,
            "fullscreen": "all"
        }
    }
}
