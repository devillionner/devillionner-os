/* ==========================================================
   EVEN BETTER LYRICS PLUS
   Original desktop/full-size theme kept intact
   ========================================================== */

@import url("https://fonts.boidu.dev/css/switzer-variable");

/* blyrics-hide-instrumental-only = true; */

:root {
    --yt-album-size: 600px;
    --blyrics-font-size: 3rem;
    --blyrics-hover-scale: 1.01;
    --blyrics-background-color: rgba(0, 0, 0, 0.25);
    --blyrics-font-family:
        "Switzer",
        "SF Pro",
        var(--noto-sans-universal),
        system-ui,
        "Segoe UI",
        Roboto,
        Helvetica,
        Arial,
        sans-serif,
        "Apple Color Emoji",
        "Segoe UI Emoji",
        "Segoe UI Symbol";
    --blyrics-font-weight: 600;
    --blyrics-wobble-duration: 1s;
    --blyrics-panel-size: 50%;
    --blyrics-video-panel-size: 50%;
    --blyrics-fullscreen-panel-size: 55%;
    --blyrics-fullscreen-video-panel-size: 55%;
}

ytmusic-player:not([video-mode]) {
    border-radius: 2rem;
    outline: 1px solid rgb(175 175 175 / 15%);
    overflow: hidden;
}

@media (min-width: 1400px) {
    :root {
        --blyrics-font-size: 4rem;
    }
}

@media (min-width: 1600px) {
    :root {
        --blyrics-font-size: 5rem;
    }
}

@media (min-width: 1800px) {
    :root {
        --blyrics-font-size: 6rem;
    }
}

.blyrics-background-lyric {
    font-size: 0.9em;
}

.blyrics-container {
    overflow-y: auto;
    scroll-behavior: smooth;
    padding-top: 10px;
    padding-inline: 20px 10px;
}

.blyrics-container:has(.blyrics--active):not(.blyrics-user-scrolling)
> div:not(.blyrics--active):not(.blyrics--active ~ div) {
    opacity: 0.33;
    filter: blur(2.5px);
}

.blyrics-container > div.blyrics--active {
    opacity: 1;
    filter: blur(0);
}

.blyrics-container > div.blyrics--active ~ div {
    opacity: 0.66;
    filter: blur(0);
}

.blyrics-container > .blyrics--animating {
    opacity: 1 !important;
    filter: blur(0);
}

.blyrics-container > div {
    transition:
        filter calc(var(--blyrics-duration) / 3) 0.4s,
        opacity calc(var(--blyrics-duration) / 2) 0.166s,
        transform 0.166s var(--blyrics-anim-delay, 0s) !important;
    padding: 5px 0;
    transform-origin: left center;
}

.blyrics-container > div:hover {
    opacity: 1 !important;
    filter: blur(0) !important;
    transform: scale(var(--blyrics-hover-scale));
    transition: all 0.3s ease;
}

@keyframes scalePulse {
    0% {
        transform: scale(1.2);
    }
    50% {
        transform: scale(1.3);
    }
    100% {
        transform: scale(1.2);
    }
}

@keyframes slowRotate {
    0% {
        transform: rotate(0deg);
    }
    100% {
        transform: rotate(360deg);
    }
}

ytmusic-player-page::before {
    background: var(--blyrics-background-img);
    background-position: 50% !important;
    background-repeat: no-repeat;
    background-size: cover;
    bottom: 0;
    content: "";
    filter:
        blur(var(--blyrics-background-blur))
        saturate(var(--blyrics-background-saturate));
    left: 0;
    position: absolute;
    right: 0;
    top: 0;
    transform: scale(1.2);
    transform-origin: center center;
    z-index: -100;
    opacity: 0.5;

    animation:
        scalePulse 8s ease-in-out infinite,
        slowRotate 30s linear infinite;
    animation-composition: add;
    will-change: transform;
}

/* Original Even Better Lyrics Plus player bar */
ytmusic-player-bar {
    display: grid;
    grid-template-columns: 1.5fr 2fr 1fr;
    grid-template-areas: "start middle end";
}

.left-controls.ytmusic-player-bar {
    grid-area: middle;
    justify-self: center;
    margin-left: calc(56px - 140px);
}

.middle-controls.ytmusic-player-bar {
    grid-area: start;
    justify-content: start;
    margin-left: 16px;
}

.middle-controls.ytmusic-player-bar yt-formatted-string.byline::after {
    content: attr(title);
    padding-left: 24px;
}

.middle-controls.ytmusic-player-bar span.yt-formatted-string {
    overflow: visible !important;
}

.middle-controls.ytmusic-player-bar:hover yt-formatted-string.byline {
    will-change: transform;
    animation: marquee-scroll 8s linear infinite;
    overflow: visible;
}

.middle-controls.ytmusic-player-bar .byline-wrapper {
    mask-image: linear-gradient(
        90deg,
        transparent,
        #000 7.5%,
        #000 92.5%,
        transparent 100%
    );
    mask-size: 115%;
    mask-position: right;
    transition: mask-size 0.15s linear;
}

.middle-controls.ytmusic-player-bar:hover .byline-wrapper {
    mask-size: 100%;
}

.volume-slider.ytmusic-player-bar {
    opacity: 1;
}

.blyrics--word::after {
    --blyrics-glow-color: color(display-p3 1 1 1 / 0.0001);
}

.blyrics--word[data-long-word]::after {
    --blyrics-glow-color: color(display-p3 1 1 1 / 1);
}

@keyframes blyrics-wobble {
    0% {
        transform: translateY(0);
    }
    100% {
        transform: translateY(-0.0375em);
    }
}

@keyframes marquee-scroll {
    0% {
        transform: translateX(0);
    }
    100% {
        transform: translateX(calc(-50% - 12px));
    }
}

.av-toggle.ytmusic-av-toggle {
    background: rgba(255, 255, 255, 0.1);
}

.ytmusic-av-toggle[aria-pressed="false"] {
    background: transparent;
}

.ytmusic-av-toggle[aria-pressed="true"] {
    background: rgba(255, 255, 255, 0.1);
}

@media (min-width: 936px) {
    .side-panel.ytmusic-player-page {
        margin: 0 0 0
            calc(var(--ytmusic-player-page-content-gap) - 10px);
    }
}


/* ==========================================================
   HYPRLAND COMPACT TILE
   ONLY applies to short windows 616–936 px wide.
   Nothing below this point affects the normal/full-size layout.
   ========================================================== */

@media (min-width: 616px) and (max-width: 936px) and (max-height: 650px) {

    :root {
        --blyrics-panel-size: 54%;
        --blyrics-video-panel-size: 54%;

        --yt-album-size: clamp(
            225px,
            min(40.5vw, 58.5vh),
            285px
        ) !important;

        --blyrics-font-size: clamp(
            2.13rem,
            min(5.4vw, 8.025vh),
            3.45rem
        );

        --blyrics-margin: 0.95rem !important;
        --blyrics-line-height: 1.28 !important;
        --blyrics-padding-top: 8px !important;
        --blyrics-padding-bottom: 48px !important;
    }

    /* Keep the original blurred background visible behind all chrome. */
    ytmusic-player-page:not([player-ui-state="MINIPLAYER"]) {
        overflow: visible !important;
    }

    /* ---------- Main split layout ---------- */

    ytmusic-player-page:not([player-ui-state="MINIPLAYER"])
    .content.ytmusic-player-page {
        display: grid !important;
        grid-template-columns:
            minmax(205px, 0.92fr)
            minmax(270px, 1.08fr);
        grid-template-areas: "main side";

        column-gap: clamp(12px, 2vw, 22px) !important;
        align-items: stretch !important;

        width: 100% !important;
        height: calc(
            100vh
            - var(--ytmusic-nav-bar-height, 64px)
            - var(--ytmusic-player-bar-height, 72px)
            - 8px
        ) !important;
        max-height: calc(
            100vh
            - var(--ytmusic-nav-bar-height, 64px)
            - var(--ytmusic-player-bar-height, 72px)
            - 8px
        ) !important;
        min-height: 0 !important;

        padding-top: 0 !important;
        padding-right: 0 !important;
        padding-bottom: 0 !important;
        margin-right: 0 !important;

        overflow: hidden !important;
        box-sizing: border-box !important;
    }

    /* ---------- Compact player bar ---------- */

    ytmusic-player-bar {
        display: grid !important;
        grid-template-columns:
            minmax(190px, 1fr)
            minmax(210px, 1fr)
            minmax(110px, 1fr) !important;
        grid-template-areas: "start middle end" !important;
        align-items: center !important;
        width: 100% !important;
    }

    .left-controls.ytmusic-player-bar {
        grid-area: middle !important;
        justify-self: center !important;
        align-self: center !important;
        width: max-content !important;
        margin: 0 !important;
    }

    .middle-controls.ytmusic-player-bar {
        grid-area: start !important;
        justify-self: start !important;
        justify-content: flex-start !important;

        min-width: 0 !important;
        max-width: 100% !important;

        margin-left: 14px !important;
        margin-right: 8px !important;

        overflow: hidden !important;
    }

    .right-controls.ytmusic-player-bar,
    .right-controls-buttons.ytmusic-player-bar {
        grid-area: end !important;
        justify-self: end !important;
        margin-left: 8px !important;
        margin-right: 12px !important;
    }

    .middle-controls.ytmusic-player-bar .content-info-wrapper,
    .middle-controls.ytmusic-player-bar .byline-wrapper {
        min-width: 0 !important;
        max-width: 100% !important;
    }

    .middle-controls.ytmusic-player-bar yt-formatted-string,
    .middle-controls.ytmusic-player-bar span.yt-formatted-string {
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        white-space: nowrap !important;
    }

    /* ---------- Top navigation ---------- */

    ytmusic-nav-bar {
        padding-right: 18px !important;
        box-sizing: border-box !important;
    }

    ytmusic-nav-bar .right-content,
    ytmusic-nav-bar #right-content,
    .right-content.ytmusic-nav-bar {
        margin-right: 0 !important;
        padding-right: 0 !important;
    }

    /* ---------- Left media column ---------- */

    ytmusic-player-page:not([player-ui-state="MINIPLAYER"])
    #main-panel.ytmusic-player-page {
        grid-area: main !important;

        position: relative !important;
        display: grid !important;
        place-items: center !important;

        width: 100% !important;
        height: 100% !important;
        min-width: 0 !important;
        min-height: 0 !important;

        align-self: stretch !important;
        justify-self: stretch !important;

        margin: 0 !important;
        padding: 0 !important;

        overflow: hidden !important;
        box-sizing: border-box !important;

        transform: none !important;
        translate: none !important;
    }

    /* After a fullscreen/large-window roundtrip, suppress duplicate
       in-page transport/song-info UI. Only media + Song/Video stay. */
    ytmusic-player-page:not([player-ui-state="MINIPLAYER"])
    #main-panel.ytmusic-player-page
    > :not(#player):not(.av):not(#av-id) {
        display: none !important;
        visibility: hidden !important;
        pointer-events: none !important;
    }

    ytmusic-player-page:not([player-ui-state="MINIPLAYER"])
    #main-panel.ytmusic-player-page
    :is(
        #player-controls,
        .player-controls,
        #blyrics-song-info,
        #song-info,
        .song-info,
        #player-info,
        .player-info
    ) {
        display: none !important;
        visibility: hidden !important;
        pointer-events: none !important;
    }

    /* ---------- Native mobile player UI suppression ----------

       YouTube Music's modern/mobile player injects a second control stack
       inside #main-panel. Better Lyrics' own mobile styling references these
       exact nodes: #info-panel, #player-controls, .collapse-button,
       .context-menu-button and the ytmusic-player-controls component.

       Our compact split already has the real bottom ytmusic-player-bar, so
       these in-page controls are always duplicates here.

       IMPORTANT: scoped ONLY to the compact Hyprland breakpoint.
       --------------------------------------------------------- */

    ytmusic-player-page:not([player-ui-state="MINIPLAYER"])
    #main-panel.ytmusic-player-page
    #info-panel,

    ytmusic-player-page:not([player-ui-state="MINIPLAYER"])
    #main-panel.ytmusic-player-page
    #player-controls,

    ytmusic-player-page:not([player-ui-state="MINIPLAYER"])
    #main-panel.ytmusic-player-page
    ytmusic-player-controls,

    ytmusic-player-page:not([player-ui-state="MINIPLAYER"])
    #main-panel.ytmusic-player-page
    .ytmusic-player-controls,

    ytmusic-player-page:not([player-ui-state="MINIPLAYER"])
    #main-panel.ytmusic-player-page
    .collapse-button,

    ytmusic-player-page:not([player-ui-state="MINIPLAYER"])
    #main-panel.ytmusic-player-page
    .context-menu-button {
        display: none !important;
        visibility: hidden !important;
        pointer-events: none !important;

        opacity: 0 !important;

        margin: 0 !important;
        padding: 0 !important;

        width: 0 !important;
        height: 0 !important;
        min-width: 0 !important;
        min-height: 0 !important;
        max-width: 0 !important;
        max-height: 0 !important;

        overflow: hidden !important;
    }

    /*
     * YTM may keep the mobile wrapper translated after a fullscreen/resize
     * transition. Do not remove the wrapper — just neutralize that stale
     * translation so media returns to our grid-centered geometry.
     */
    ytmusic-player-page:not([player-ui-state="MINIPLAYER"])
    #main-panel.ytmusic-player-page
    #music-player-wrapper {
        transform: none !important;
        translate: none !important;
    }


    /* Song / Video switch */
    ytmusic-player-page:not([player-ui-state="MINIPLAYER"])
    .av.ytmusic-player-page {
        position: absolute !important;
        left: 50% !important;
        top: calc(50% - 212px) !important;

        width: fit-content !important;

        margin: 0 !important;
        padding: 0 !important;

        transform: none !important;
        translate: -50% 0 !important;

        z-index: 4 !important;
    }

    /* Album artwork */
    ytmusic-player-page:not([blyrics-video-mode])
    #player.ytmusic-player-page {
        position: relative !important;

        inset: auto !important;

        width: var(--yt-album-size) !important;
        max-width: var(--yt-album-size) !important;
        min-width: 0 !important;
        height: auto !important;

        align-self: center !important;
        justify-self: center !important;

        margin: 0 !important;

        transform: none !important;
        translate: none !important;
    }

    ytmusic-player-page:not([blyrics-video-mode])
    ytmusic-player:not([video-mode]) {
        width: 100% !important;
        max-width: 100% !important;
    }

    /* Video */
    ytmusic-player-page[blyrics-video-mode]
    #player.ytmusic-player-page {
        position: relative !important;

        inset: auto !important;

        width: 94% !important;
        max-width: min(
            100%,
            calc(
                (
                    100vh
                    - var(--ytmusic-nav-bar-height, 64px)
                    - var(--ytmusic-player-bar-height, 72px)
                    - 90px
                )
                * var(--blyrics-video-aspect-ratio, 1.7778)
            )
        ) !important;

        height: auto !important;
        min-height: 0 !important;
        max-height: 100% !important;

        aspect-ratio:
            var(--blyrics-video-aspect-ratio, 16 / 9) !important;

        align-self: center !important;
        justify-self: center !important;

        margin: 0 !important;

        transform: none !important;
        translate: none !important;

        background: transparent !important;
    }

    ytmusic-player-page[blyrics-video-mode] #song-media-window,
    ytmusic-player-page[blyrics-video-mode] #movie_player {
        aspect-ratio:
            var(--blyrics-video-aspect-ratio, 16 / 9) !important;
    }

    /* ---------- Right panel ---------- */

    ytmusic-player-page:not([player-ui-state="MINIPLAYER"])
    #side-panel.ytmusic-player-page {
        grid-area: side !important;

        display: flex !important;
        flex-direction: column !important;

        width: 100% !important;
        height: 100% !important;
        min-width: 0 !important;
        min-height: 0 !important;
        max-width: none !important;
        max-height: 100% !important;

        margin: 0 !important;
        padding: 0 !important;

        overflow: hidden !important;
        box-sizing: border-box !important;

        border-left: 0 !important;

        transform: none !important;
        translate: none !important;
    }

    /* Keep only NEXT + LYRICS. */
    #tabsContent > tp-yt-paper-tab:nth-of-type(n + 3) {
        display: none !important;
    }

    /* NEXT / LYRICS header */
    #tabsContent {
        position: static !important;

        display: flex !important;
        flex-direction: row !important;

        width: 100% !important;
        height: 48px !important;
        min-height: 48px !important;

        /* Same side gutter as the NEXT list. */
        padding: 0 16px !important;
        margin: 0 !important;

        overflow: visible !important;
        box-sizing: border-box !important;

        background: transparent !important;
        border: 0 !important;
        box-shadow: none !important;

        transform: none !important;
        translate: none !important;

        backdrop-filter: none !important;
        -webkit-backdrop-filter: none !important;
    }

    #tabsContent > tp-yt-paper-tab:nth-of-type(1),
    #tabsContent > tp-yt-paper-tab:nth-of-type(2) {
        position: relative !important;
        inset: auto !important;

        display: flex !important;
        align-items: center !important;
        justify-content: center !important;

        flex: 1 1 50% !important;

        width: auto !important;
        min-width: 0 !important;
        max-width: none !important;

        height: 48px !important;
        min-height: 48px !important;
        max-height: 48px !important;

        margin: 0 !important;
        padding: 0 8px !important;

        border: 0 !important;
        border-radius: 0 !important;
        background: transparent !important;

        opacity: 0.62 !important;

        box-sizing: border-box !important;

        transform: none !important;
        translate: none !important;
        scale: none !important;

        transition:
            opacity 0.16s ease,
            background 0.16s ease !important;
    }

    #tabsContent > tp-yt-paper-tab:nth-of-type(1):hover,
    #tabsContent > tp-yt-paper-tab:nth-of-type(2):hover {
        opacity: 0.9 !important;
        background: rgba(255, 255, 255, 0.025) !important;
    }

    #tabsContent > tp-yt-paper-tab:nth-of-type(1).iron-selected,
    #tabsContent > tp-yt-paper-tab:nth-of-type(2).iron-selected,
    #tabsContent > tp-yt-paper-tab:nth-of-type(1)[selected],
    #tabsContent > tp-yt-paper-tab:nth-of-type(2)[selected],
    #tabsContent > tp-yt-paper-tab:nth-of-type(1)[aria-selected="true"],
    #tabsContent > tp-yt-paper-tab:nth-of-type(2)[aria-selected="true"] {
        opacity: 1 !important;
    }

    /* No underline / separator in compact mode. */
    #tabsContent > tp-yt-paper-tab::after {
        content: none !important;
        display: none !important;
    }

    #tabsContent #selectionBar,
    #tabsContent .paper-tabs-selection-bar,
    #side-panel #selectionBar,
    #side-panel .paper-tabs-selection-bar {
        display: none !important;
    }

    #side-panel .tab-header-container,
    #side-panel tp-yt-paper-tabs,
    #tabsContent {
        border-top: 0 !important;
        border-bottom: 0 !important;
        box-shadow: none !important;
    }

    /* ---------- Right-panel content ---------- */

    #side-panel #tab-renderer {
        flex: 1 1 auto !important;

        width: 100% !important;
        min-height: 0 !important;
        max-height: none !important;

        margin: 0 !important;

        overflow-y: auto !important;
        overflow-x: hidden !important;

        overscroll-behavior: contain;
        box-sizing: border-box !important;
    }

    /* NEXT list: only the requested right gutter. */
    #side-panel
    #tab-renderer:not([page-type="MUSIC_PAGE_TYPE_TRACK_LYRICS"]) {
        padding-top: 4px !important;
        padding-right: 16px !important;
    }

    /* Lyrics */
    #side-panel
    #tab-renderer[page-type="MUSIC_PAGE_TYPE_TRACK_LYRICS"] {
        overflow: hidden !important;
    }

    #side-panel
    #tab-renderer[page-type="MUSIC_PAGE_TYPE_TRACK_LYRICS"]
    > ytmusic-message-renderer {
        display: none !important;
    }

    #side-panel .blyrics-container {
        width: 100% !important;
        height: 100% !important;
        min-height: 0 !important;
        max-height: 100% !important;

        overflow-y: auto !important;
        overflow-x: hidden !important;

        padding-top: var(--blyrics-padding-top, 8px) !important;
        padding-bottom: var(--blyrics-padding-bottom, 48px) !important;
        padding-left: clamp(18px, 2.3vw, 26px) !important;
        padding-right: clamp(16px, 2vw, 22px) !important;

        box-sizing: border-box !important;
    }

    #side-panel .blyrics-container:has(.blyrics--active):not(.blyrics-user-scrolling)
    > div:not(.blyrics--active):not(.blyrics--active ~ div) {
        opacity: 0.50 !important;
        filter: blur(0.45px) !important;
    }

    #side-panel .blyrics-container > div.blyrics--active {
        opacity: 1 !important;
        filter: blur(0) !important;
    }

    #side-panel .blyrics-container > div.blyrics--active ~ div {
        opacity: 0.86 !important;
        filter: blur(0) !important;
    }

    #side-panel .blyrics-container > div {
        margin-block: 0.95rem !important;
        padding-top: 3px !important;
        padding-bottom: 3px !important;
        line-height: var(--blyrics-line-height, 1.28) !important;
    }

    #side-panel .blyrics-dock {
        max-width: 100% !important;
    }
}


/* ==========================================================
   HYPRLAND EXTRA-SHORT TILE
   Small adjustments only; still isolated from full-size mode.
   ========================================================== */

@media (min-width: 616px) and (max-width: 936px) and (max-height: 520px) {

    :root {
        --yt-album-size: clamp(
            210px,
            min(36vw, 52vh),
            255px
        ) !important;

        --blyrics-font-size: clamp(
            1.95rem,
            min(4.95vw, 7.5vh),
            3.03rem
        );

        --blyrics-margin: 0.8rem !important;
        --blyrics-line-height: 1.24 !important;
        --blyrics-padding-top: 4px !important;
        --blyrics-padding-bottom: 40px !important;
    }

    ytmusic-player-bar {
        grid-template-columns:
            minmax(165px, 1fr)
            minmax(190px, 1fr)
            minmax(92px, 1fr) !important;
    }

    ytmusic-player-page:not([player-ui-state="MINIPLAYER"])
    .content.ytmusic-player-page {
        grid-template-columns:
            minmax(180px, 0.88fr)
            minmax(250px, 1.12fr);
        column-gap: 10px !important;
    }

    ytmusic-player-page:not([player-ui-state="MINIPLAYER"])
    .av.ytmusic-player-page {
        top: calc(50% - 182px) !important;
    }

    #tabsContent,
    #tabsContent > tp-yt-paper-tab:nth-of-type(1),
    #tabsContent > tp-yt-paper-tab:nth-of-type(2) {
        height: 42px !important;
        min-height: 42px !important;
        max-height: 42px !important;
    }
}


/* ==========================================================
   V43 — RESIZE STATE RECOVERY / DUPLICATE IN-PAGE PLAYER UI
   ----------------------------------------------------------
   When YTM is shrunk into its mobile layout and then enlarged
   again, it can keep the mobile info + transport UI alive.
   In our 2-column compact layout these controls are ALWAYS
   duplicates because the real transport lives in the bottom
   ytmusic-player-bar.

   Keep this intentionally broad, but ONLY inside our compact
   616–936px / <=650px layout. Full-size mode is untouched.
   ========================================================== */

@media (min-width: 616px) and (max-width: 936px) and (max-height: 650px) {

    /* Metadata row under the artwork/video */
    html body ytmusic-app ytmusic-player-page #info-panel,
    html body ytmusic-app ytmusic-player-page .info-panel.ytmusic-player-page,

    /* Native mobile page controls */
    html body ytmusic-app ytmusic-player-page #player-controls,
    html body ytmusic-app ytmusic-player-page .player-controls.ytmusic-player-page,

    /* Native controls rendered INSIDE <ytmusic-player> */
    html body ytmusic-app ytmusic-player-page .song-media-controls.ytmusic-player,
    html body ytmusic-app ytmusic-player-page .song-media-controls,
    html body ytmusic-app ytmusic-player-page ytmusic-player-controls,
    html body ytmusic-app ytmusic-player-page .ytmusic-player-controls,

    /* Mobile-only extra buttons */
    html body ytmusic-app ytmusic-player-page .collapse-button,
    html body ytmusic-app ytmusic-player-page .context-menu-button {
        display: none !important;
        visibility: hidden !important;
        pointer-events: none !important;
        opacity: 0 !important;

        position: absolute !important;
        inset: auto !important;

        width: 0 !important;
        height: 0 !important;
        min-width: 0 !important;
        min-height: 0 !important;
        max-width: 0 !important;
        max-height: 0 !important;

        margin: 0 !important;
        padding: 0 !important;

        overflow: hidden !important;
    }

    /*
     * Some YTM builds keep the wrapper in its mobile flex layout after
     * resize. Force that wrapper to contribute only the media itself.
     */
    html body ytmusic-app
    ytmusic-player-page:not([player-ui-state="MINIPLAYER"])
    #main-panel.ytmusic-player-page
    #music-player-wrapper {
        transform: none !important;
        translate: none !important;

        margin: 0 !important;
        padding: 0 !important;

        min-height: 0 !important;
    }

    /*
     * Direct structural fallback: if the mobile controls are rebuilt with
     * slightly different class names, hide any descendants of #main-panel
     * whose id/class explicitly identifies them as player controls.
     * This does NOT touch ytmusic-player-bar because that lives outside
     * #main-panel.
     */
    html body ytmusic-app
    ytmusic-player-page:not([player-ui-state="MINIPLAYER"])
    #main-panel.ytmusic-player-page
    [id*="player-control"],

    html body ytmusic-app
    ytmusic-player-page:not([player-ui-state="MINIPLAYER"])
    #main-panel.ytmusic-player-page
    [class*="player-control"] {
        display: none !important;
        visibility: hidden !important;
        pointer-events: none !important;
        opacity: 0 !important;
    }
}
